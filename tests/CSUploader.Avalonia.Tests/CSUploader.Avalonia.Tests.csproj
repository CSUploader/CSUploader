<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>preview</LangVersion>
    <!-- Deliberately NO UseWPF: this head is Avalonia. The headless session (Task 3) drives the
         real App.ConfigureServices graph and the AvaloniaUiDispatcher contract. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.18" />
    <!-- AvaloniaRuntimeXamlLoader: LocExtensionTests load tiny XAML fragments at runtime to exercise
         {loc:Loc ...} against real target properties (TextBlock.Text styled; DataGridColumn.Header direct). -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.3.18" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Transitively pulls in CSUploader.Core; gives the DI smoke access to App.ConfigureServices
         (internal, exposed via the head's InternalsVisibleTo) and the AvaloniaUiDispatcher type. -->
    <ProjectReference Include="..\..\src\CSUploader.Avalonia\CSUploader.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- WebView2's WPF + WinForms wrapper references flow transitively from the head (via its
       Microsoft.Web.WebView2 reference); the WPF wrapper pulls in WPF's WindowsBase 5.0 →
       MSB3277 here too. Drop both desktop wrappers before RAR, same as the head. This test
       project uses none of WebView2 directly (headless DI/dispatcher tests). -->
  <Target Name="_DropWebView2DesktopWrappers" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference->WithMetadataValue('Filename','Microsoft.Web.WebView2.Wpf'))" />
      <Reference Remove="@(Reference->WithMetadataValue('Filename','Microsoft.Web.WebView2.WinForms'))" />
    </ItemGroup>
  </Target>

</Project>
