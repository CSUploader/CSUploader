<Window x:Class="CSUploader.Views.SpeedLimitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Speed Limit"
        Width="380" Height="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico">

  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Set Speed Limit" FontSize="14" FontWeight="SemiBold"
               Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4" />
    <TextBlock Grid.Row="1" Text="Per-package override. Leave empty to use the global setting."
               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Grid.Column="0" x:Name="LimitBox" FontSize="12" Padding="6,5" VerticalContentAlignment="Center" />
      <TextBlock Grid.Column="1" Text="KB/s" VerticalAlignment="Center" Margin="8,0,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Clear" Width="70" Height="28" Margin="0,0,8,0" Click="ClearButton_Click" />
      <Button Content="Cancel" Width="70" Height="28" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="OK" Width="70" Height="28" IsDefault="True" Click="OkButton_Click"
              Style="{StaticResource PrimaryButtonStyle}" />
    </StackPanel>
  </Grid>
</Window>
