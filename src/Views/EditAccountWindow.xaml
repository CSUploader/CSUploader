<Window x:Class="CSUploader.Views.EditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        xmlns:conv="clr-namespace:CSUploader.Converters"
        Title="{loc:Loc EditAccount_WindowTitle}"
        Width="420" Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceMutedBrush}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico">

    <Window.Resources>
        <conv:HosterIconConverter x:Key="HosterIconConverter" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- TextBox and ComboBox don't share a default measured height — the ComboBox's
             templated toggle button stretches taller than the TextBox's content area at
             the same Padding, so we pin both (and the HosterLocked alternative below) to
             an explicit 28px to keep the input column visually aligned. -->
        <Style x:Key="FieldInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" Padding="12,0"
                                BorderThickness="1" BorderBrush="{DynamicResource DialogButtonBorderBrush}"
                                Background="{DynamicResource DialogButtonBgBrush}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DialogButtonHoverBorderBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogButtonHoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" Padding="12,0"
                                BorderThickness="1" BorderBrush="{DynamicResource SaveButtonBorderBrush}"
                                Background="{DynamicResource SaveButtonBgBrush}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SaveButtonHoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SaveButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="{DynamicResource SurfaceBrush}" CornerRadius="4"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 0: hoster -->
                <RowDefinition Height="Auto" />   <!-- 1: username (non-XFS) -->
                <RowDefinition Height="Auto" />   <!-- 2: password (non-XFS) -->
                <RowDefinition Height="Auto" />   <!-- 3: sign-in button + status (XFS) -->
                <RowDefinition Height="Auto" />   <!-- 4: "or" separator (XFS) -->
                <RowDefinition Height="Auto" />   <!-- 5: api key (XFS) -->
                <RowDefinition Height="Auto" />   <!-- 6: enabled check -->
                <RowDefinition Height="*" />      <!-- 7: spacer -->
                <RowDefinition Height="Auto" />   <!-- 8: buttons -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc EditAccount_FileHosterLabel}" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="HosterCombo" Style="{StaticResource FieldCombo}" Margin="0,0,0,10">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Converter={StaticResource HosterIconConverter}}"
                                   Width="16" Height="16" Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Grid.Row="0" Grid.Column="1" x:Name="HosterLocked"
                    Margin="0,0,0,10" Padding="8,0" Height="28"
                    Background="{DynamicResource SurfaceMutedBrush}"
                    BorderBrush="{DynamicResource InputFieldBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="HosterLockedIcon" Width="16" Height="16" Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="HosterLockedText"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Username / Password: classic U/P hosters only. API-key hosters surface
                 the captured identity in the SignInStatus text below ("✓ Signed in as X")
                 rather than a dedicated row. -->
            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="UsernameLabel" Text="{loc:Loc EditAccount_UsernameLabel}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="UsernameBox" Style="{StaticResource FieldInput}" Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="PasswordLabel" Text="{loc:Loc EditAccount_PasswordLabel}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" Style="{StaticResource FieldInput}" Margin="0,0,0,10" />

            <!-- Sign-in button + status: shown only for XFileSharing-API hosters. Clicking it
                 opens the captcha WebView; on success we derive (and silently store) the
                 account's API key from its my_account page. -->
            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="SignInLabel" Text="{loc:Loc EditAccount_SignInLabel}"
                       Style="{StaticResource FieldLabel}" Visibility="Collapsed" />
            <!-- Two-column inner Grid (was a Horizontal StackPanel, but that left the
                 status TextBlock unbounded and the CharacterEllipsis trim hid messages
                 like "Use Proxies is enabled but no usable proxy is available"). The
                 Auto column hugs the button; the * column gives the status text a real
                 width to wrap into. -->
            <Grid Grid.Row="3" Grid.Column="1" x:Name="SignInRow" Margin="0,0,0,10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="SignInButton" Content="{loc:Loc EditAccount_SignInButton}"
                        Style="{StaticResource DialogButton}" Click="SignInButton_Click"
                        VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" x:Name="SignInStatus" VerticalAlignment="Center"
                           Margin="10,0,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <!-- Failure state, shown in place of SignInStatus (only one is ever visible).
                     A height-capped "Error: …" line keeps a verbose message — the XFileSharing
                     my_account failure appends a raw-HTML snippet — from growing this row and
                     shoving the Save/Cancel buttons out of the fixed-size, non-resizable window.
                     The complete text is available via the Details link (ErrorDetailsWindow). -->
                <StackPanel Grid.Column="1" x:Name="SignInErrorPanel" Margin="10,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- MaxHeight caps the wrapped text at ~3 lines so a verbose message can't
                         grow the row; TextTrimming ellipsizes the last visible line, and the
                         Details link below always exposes the full text regardless. (WPF's
                         TextBlock has no MaxLines — that's a UWP/WinUI property — so the cap is
                         expressed as a height.) -->
                    <TextBlock x:Name="SignInErrorText"
                               FontSize="12" TextWrapping="Wrap" MaxHeight="48"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ErrorBrush}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12">
                        <Hyperlink Click="ErrorDetails_Click" Foreground="{DynamicResource AccentBrush}">
                            <Run Text="{loc:Loc Common_Details}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- "or" separator between Sign-in and the manual API-key entry. -->
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="OrSeparator"
                       Text="{loc:Loc EditAccount_OrLabel}"
                       FontSize="11"
                       FontStyle="Italic"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,6"
                       Visibility="Collapsed" />

            <TextBlock Grid.Row="5" Grid.Column="0" x:Name="ApiKeyLabel"
                       Text="{loc:Loc EditAccount_ApiKeyLabel}"
                       Style="{StaticResource FieldLabel}"
                       Visibility="Collapsed" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="ApiKeyBox"
                     Style="{StaticResource FieldInput}"
                     Margin="0,0,0,10"
                     Visibility="Collapsed" />

            <CheckBox Grid.Row="6" Grid.Column="1" x:Name="EnabledCheck" Content="{loc:Loc EditAccount_AccountEnabled}"
                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />

            <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{loc:Loc EditAccount_BtnSave}" Style="{StaticResource SaveButton}" Click="SaveButton_Click" Margin="0,0,8,0" />
                <Button Content="{loc:Loc EditAccount_BtnCancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
