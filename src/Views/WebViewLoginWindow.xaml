<Window x:Class="CSUploader.Views.WebViewLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        Title="{loc:Loc WebViewLogin_WindowTitle}"
        Width="900" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceMutedBrush}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: tells the user which hoster they're signing in to and what we're waiting for.
             The captcha-bearing hosters (ex-load) are the only reason this window exists, so we
             call that out explicitly to set expectations. -->
        <Border Grid.Row="0" Padding="14,10" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderText"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Loc WebViewLogin_Instructions}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <wv2:WebView2 Grid.Row="1" x:Name="WebView" />

        <!-- Status strip: shows the cookie-discovery state so the user can tell whether the
             session is being captured. Updated by code-behind on every NavigationCompleted. -->
        <Border Grid.Row="2" Padding="14,6" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="{loc:Loc Common_Cancel}"
                        Width="90" Height="26"
                        IsCancel="True"
                        Click="CancelButton_Click" />
                <TextBlock x:Name="StatusText"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
