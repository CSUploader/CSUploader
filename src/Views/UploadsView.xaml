<UserControl x:Class="CSUploader.Views.UploadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UploadsViewModel}"
             d:DesignWidth="1600" d:DesignHeight="900">

    <UserControl.Resources>
        <conv:ByteUnitConverter x:Key="ByteUnitConverter" />
        <conv:TimeSpanFormatConverter x:Key="TimeSpanConverter" />
        <conv:DateTimeFormatConverter x:Key="DateTimeConverter" />
        <conv:SpeedLimitConverter x:Key="SpeedLimitConverter" />
        <conv:FileStateDisplayConverter x:Key="FileStateConverter" />
        <conv:FileStateIconConverter x:Key="FileStateIconConverter" />
        <conv:HosterIconConverter x:Key="HosterIconConverter" />
        <conv:FileTypeIconConverter x:Key="FileTypeIconConverter" />

        <!-- Invisible thumb on each side of the column header for click-and-drag resizing.
             We have to include this explicitly because our custom DataGridColumnHeader
             template (with the lock toggle) replaces the default visual tree, which
             ordinarily ships these grippers. -->
        <Style x:Key="ColumnHeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <conv:ProgressWidthConverter x:Key="ProgressWidthConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ItemStateToVisibilityConverter x:Key="ItemStateToVisibility" />

        <!-- Toolbar button style - large icons like JD2 -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ToolbarButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolbarButtonPressedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ToolbarButtonPressedBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status bar styles -->
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,20,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar (JD2-style: large icons, hover borders) -->
        <Border Grid.Row="0" Background="{DynamicResource DataGridHeaderBrush}"
                BorderBrush="{DynamicResource DataGridGridLineBrush}" BorderThickness="0,0,0,1"
                Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Click="AddUploadButton_Click" ToolTip="Add new upload">
                    <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,-4,0,0" />
                </Button>

                <!-- Separator -->
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4" />

                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartCommand}" ToolTip="Start all uploads">
                    <Image Source="{StaticResource ButtonStartImage}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PauseCommand}" ToolTip="Pause / Resume">
                    <Image Source="{StaticResource ButtonPauseImage}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StopCommand}" ToolTip="Stop all uploads">
                    <Image Source="{StaticResource ButtonStopImage}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>

                <!-- Separator -->
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4" />

                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding MoveUpCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=uploadsGrid}"
                        ToolTip="Move package up">
                    <TextBlock Text="&#x25B2;" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding MoveDownCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=uploadsGrid}"
                        ToolTip="Move package down">
                    <TextBlock Text="&#x25BC;" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- Separator -->
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4" />

                <Button Style="{StaticResource ToolbarButton}"
                        Command="{Binding RemoveSelectedCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=uploadsGrid}"
                        ToolTip="Remove selected">
                    <TextBlock Text="&#x2715;" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource ErrorBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Main DataGrid -->
        <DataGrid x:Name="uploadsGrid" Grid.Row="1"
                  Loaded="UploadsGrid_Loaded"
                  ItemsSource="{Binding FilteredRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                  VerticalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                  Background="{DynamicResource SurfaceBrush}"
                  RowBackground="{DynamicResource SurfaceBrush}"
                  AlternatingRowBackground="{DynamicResource DataGridAltRowBrush}"
                  RowHeaderWidth="0"
                  BorderThickness="0"
                  Tag="{Binding}">

            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=uploadsGrid}" />
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Start" Command="{Binding RetryCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Visibility="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource ItemStateToVisibility}, ConverterParameter=Startable}">
                        <MenuItem.Icon><Image Source="{StaticResource ButtonStartImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Stop" Command="{Binding StopSelectedCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Visibility="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource ItemStateToVisibility}, ConverterParameter=Stoppable}">
                        <MenuItem.Icon><Image Source="{StaticResource ActionCancelImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Skip Upload" Command="{Binding SkipUploadCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Image Source="{StaticResource ActionSkipImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Reset" Command="{Binding ResetFileCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Image Source="{StaticResource ActionResetImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Open Source Directory" Command="{Binding OpenSourceDirectoryCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Image Source="{StaticResource ActionFolderImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Set Speed Limit..." Command="{Binding SetSpeedLimitCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Image Source="{StaticResource ActionSpeedImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Remove" Command="{Binding RemoveCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="FontFamily" Value="{DynamicResource GridFontFamily}" />
                    <Setter Property="FontSize" Value="{DynamicResource GridFontSize}" />
                    <Setter Property="Padding" Value="6,5" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLineBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <DockPanel>
                                        <!-- JD2-style lock indicator on the right of every header -->
                                        <ToggleButton DockPanel.Dock="Right" Cursor="Hand"
                                                      Width="14" Height="14" Margin="4,0,0,0"
                                                      Click="ColumnLock_Click"
                                                      Background="Transparent" BorderThickness="0"
                                                      ToolTip="Lock column width">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent">
                                                        <TextBlock x:Name="Glyph" Text="&#xE785;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Opacity="0.45" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Glyph" Property="Text" Value="&#xE72E;" />
                                                            <Setter TargetName="Glyph" Property="Opacity" Value="1.0" />
                                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Glyph" Property="Opacity" Value="1.0" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                    <Thumb x:Name="PART_LeftHeaderGripper"
                                           HorizontalAlignment="Left"
                                           Style="{StaticResource ColumnHeaderGripperStyle}" />
                                    <Thumb x:Name="PART_RightHeaderGripper"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource ColumnHeaderGripperStyle}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="FontFamily" Value="{DynamicResource GridFontFamily}" />
                    <Setter Property="FontSize" Value="{DynamicResource GridFontSize}" />
                    <Setter Property="MinHeight" Value="20" />
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="248" CanUserReorder="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Horizontal stack: collapsed elements take zero width, so the package
                                 row's name slides flush against its chevron, while file rows keep
                                 their indent via the always-rendered chevron-spacer + file icon. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Chevron toggle: shown for packages, hidden (space reserved) for files -->
                                <ToggleButton FontSize="14" FontWeight="Bold"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              Cursor="Hand"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"
                                              Click="ExpandToggle_Click">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Style.Triggers>
                                                <!-- Hidden (not Collapsed) on file rows: keeps the 28px
                                                     indent the chevron occupies on the package row. -->
                                                <DataTrigger Binding="{Binding IsPackageRow}" Value="False">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Width="20" Height="20">
                                                <TextBlock x:Name="Glyph" Text="+" FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Glyph" Property="Text" Value="−" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <!-- File-type icon: shown for files, fully collapsed for packages
                                     so the package name flows tight against the chevron. -->
                                <svgc:SvgViewbox Source="{Binding Name, Converter={StaticResource FileTypeIconConverter}}"
                                                 Width="16" Height="16"
                                                 Margin="2,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsPackageRow, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, FallbackValue=Visible}" />
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Padding="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPackageRow}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Size" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Package rows show [N] file count first, like JD2 -->
                                <TextBlock Text="{Binding FileCount, StringFormat='[{0}]'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,6,0"
                                           Visibility="{Binding IsPackageRow, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                <TextBlock Text="{Binding Size, Converter={StaticResource ByteUnitConverter}, FallbackValue=''}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Hoster" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding HosterDisplay, Converter={StaticResource HosterIconConverter}}"
                                       Width="18" Height="18" Margin="0,0,6,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding HosterDisplay, FallbackValue=''}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding State, Converter={StaticResource FileStateIconConverter}}"
                                       Width="14" Height="14" Margin="0,0,4,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding State, Converter={StaticResource FileStateConverter}, FallbackValue=''}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Speed" Binding="{Binding Speed, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Width="90" />
                <DataGridTextColumn Header="ETA" Binding="{Binding TimeRemaining, Converter={StaticResource TimeSpanConverter}, TargetNullValue=''}" Width="80" />
                <DataGridTextColumn Header="Bytes Loaded" Binding="{Binding BytesLoaded, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Width="100" />

                <DataGridTemplateColumn Header="Progress" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid x:Name="PGrid" Margin="2,3">
                                <Border Background="{DynamicResource ProgressBarTrackBrush}" CornerRadius="1" Height="14" />
                                <Border Background="{DynamicResource ProgressBarFillBrush}" CornerRadius="1" HorizontalAlignment="Left" Height="14">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                            <Binding Path="Progress" />
                                            <Binding Path="ActualWidth" ElementName="PGrid" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding Progress, StringFormat='{}{0:0.0}%', TargetNullValue=''}"
                                           FontSize="10" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Save to" Binding="{Binding SaveFrom}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Added"
                                    Binding="{Binding AddedDate, Converter={StaticResource DateTimeConverter}}"
                                    Width="130" Visibility="Collapsed" />
                <DataGridTextColumn Header="Finished"
                                    Binding="{Binding FinishedDate, Converter={StaticResource DateTimeConverter}}"
                                    Width="130" Visibility="Collapsed" />
                <DataGridTextColumn Header="Duration"
                                    Binding="{Binding Duration, Converter={StaticResource TimeSpanConverter}, TargetNullValue=''}"
                                    Width="80" Visibility="Collapsed" />
                <DataGridTextColumn Header="Priority"
                                    Binding="{Binding Priority, TargetNullValue=''}"
                                    Width="70" Visibility="Collapsed" />
                <DataGridTextColumn Header="Speed Limit"
                                    Binding="{Binding EffectiveSpeedLimitKBps, Converter={StaticResource SpeedLimitConverter}}"
                                    Width="90" Visibility="Collapsed" />
                <DataGridTextColumn Header="URL"
                                    Binding="{Binding FileUrl}"
                                    Width="200" Visibility="Collapsed">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <!-- Suppress the aggregated package URL — the per-file rows already show them -->
                                <DataTrigger Binding="{Binding IsPackageRow}" Value="True">
                                    <Setter Property="Text" Value="" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="220" MinWidth="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Panel (JD2 "Download Overview" exact match) -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding ShowUploadOverview, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar: green icon + title + close button -->
                <Border Grid.Row="0" Padding="4,2"
                        Background="{DynamicResource OverviewTitleGradientBrush}">
                    <DockPanel>
                        <!-- Close button on right -->
                        <Button DockPanel.Dock="Right" Width="16" Height="16" Margin="4,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontSize="10" Content="&#x2715;" Foreground="{DynamicResource OverviewCloseBrush}"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                ToolTip="Close overview" Padding="0"
                                Click="OverviewCloseButton_Click" />

                        <!-- Green arrow + title -->
                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="&#x25BC;" Foreground="{DynamicResource OverviewArrowBrush}" FontSize="10" /> <!-- Green down arrow -->
                            <Run Text=" Upload Overview" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Stats area with right-click context menu for toggling fields -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" Padding="6,3,6,4"
                        BorderBrush="{DynamicResource DataGridGridLineBrush}" BorderThickness="0,1,0,0">

                    <!-- JD2-style right-click menu to toggle stat fields -->
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Package(s)" IsCheckable="True" IsChecked="{Binding ShowPackages}" />
                            <MenuItem Header="Link(s)" IsCheckable="True" IsChecked="{Binding ShowLinks}" />
                            <Separator />
                            <MenuItem Header="Total Bytes" IsCheckable="True" IsChecked="{Binding ShowTotalBytes}" />
                            <MenuItem Header="Uploadspeed" IsCheckable="True" IsChecked="{Binding ShowUploadspeed}" />
                            <MenuItem Header="Bytes loaded" IsCheckable="True" IsChecked="{Binding ShowBytesLoaded}" />
                            <MenuItem Header="Remaining Bytes" IsCheckable="True" IsChecked="{Binding ShowRemainingBytes}" />
                            <MenuItem Header="ETA" IsCheckable="True" IsChecked="{Binding ShowEta}" />
                            <MenuItem Header="Running Uploads" IsCheckable="True" IsChecked="{Binding ShowRunningUploads}" />
                            <MenuItem Header="Open Connections" IsCheckable="True" IsChecked="{Binding ShowOpenConnections}" />
                            <Separator />
                            <MenuItem Header="Finished Link(s)" IsCheckable="True" IsChecked="{Binding ShowFinishedLinks}" />
                            <MenuItem Header="Skipped Link(s)" IsCheckable="True" IsChecked="{Binding ShowSkippedLinks}" />
                            <MenuItem Header="Failed Link(s)" IsCheckable="True" IsChecked="{Binding ShowFailedLinks}" />
                        </ContextMenu>
                    </Border.ContextMenu>

                    <WrapPanel Orientation="Horizontal">
                        <!-- Each stat is a label+value pair that collapses when toggled off -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowPackages, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Package(s):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding PackageCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowTotalBytes, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Total Bytes:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding TotalBytes}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowBytesLoaded, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Bytes loaded:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding BytesLoaded}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowEta, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="ETA:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Eta}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowOpenConnections, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Open Connections:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding RunningUploads}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowLinks, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Link(s):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding FileCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowUploadspeed, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Uploadspeed:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding UploadSpeed}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowRemainingBytes, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Remaining Bytes:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding RemainingBytes}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowRunningUploads, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Running Uploads:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding RunningUploads}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowFinishedLinks, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Finished Link(s):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding FinishedLinks}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowSkippedLinks, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Skipped Link(s):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding SkippedLinks}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,1"
                                    Visibility="{Binding ShowFailedLinks, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Failed Link(s):" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding FailedLinks}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>

        <!-- JD2-style filter bar -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="6,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="File Name"
                           Width="110"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="6,0,4,0" />
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="11"
                         VerticalContentAlignment="Center"
                         ToolTip="Filter by file or package name" />
            </DockPanel>
        </Border>

        <!-- Premium account footer link -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="8,3">
            <TextBlock x:Name="PremiumAccountLink"
                       Cursor="Hand"
                       MouseLeftButtonUp="PremiumAccountLink_Click"
                       FontSize="11"
                       Foreground="{DynamicResource AccentBrush}">
                <Run Text="&#x2795;" FontFamily="Segoe UI Symbol" /> Add a Premium Account…
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
