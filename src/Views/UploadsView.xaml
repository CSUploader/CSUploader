<UserControl x:Class="CSUploader.Views.UploadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UploadsViewModel}"
             d:DesignWidth="1600" d:DesignHeight="900">

    <UserControl.Resources>
        <conv:ByteUnitConverter x:Key="ByteUnitConverter" />
        <conv:TimeSpanFormatConverter x:Key="TimeSpanConverter" />
        <conv:ProgressWidthConverter x:Key="ProgressWidthConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Toolbar button style - large icons like JD2 -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="1,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0EEF9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90B8D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C4DCF0" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6A9CC6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status bar styles -->
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,20,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar (JD2-style: large icons, hover borders) ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource DataGridHeaderBrush}"
                BorderBrush="{DynamicResource DataGridGridLineBrush}" BorderThickness="0,0,0,1"
                Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StartCommand}" ToolTip="Start all uploads">
                    <Image Source="{StaticResource ButtonStartImage}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding PauseCommand}" ToolTip="Pause / Resume">
                    <Image Source="{StaticResource ButtonPauseImage}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding StopCommand}" ToolTip="Stop all uploads">
                    <Image Source="{StaticResource ButtonStopImage}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>

                <!-- Separator -->
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4" />
            </StackPanel>
        </Border>

        <!-- ═══ Main DataGrid ═══ -->
        <DataGrid x:Name="uploadsGrid" Grid.Row="1"
                  ItemsSource="{Binding Packages}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  VerticalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  Background="#EAF3FB"
                  AlternatingRowBackground="#E2EDF7"
                  RowHeaderWidth="0"
                  BorderThickness="0"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  Tag="{Binding}">

            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding RemoveCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=uploadsGrid}" />
            </DataGrid.InputBindings>

            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Retry" Command="{Binding RetryCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Image Source="{StaticResource ActionRetryImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Stop" Command="{Binding StopSelectedCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Image Source="{StaticResource ActionCancelImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Remove" Command="{Binding RemoveCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="6,5" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLineBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="MinHeight" Value="22" />
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#B8D4EE" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource ByteUnitConverter}}" Width="90" />
                <DataGridTextColumn Header="Hoster" Binding="{Binding FileHosters[0].Name, FallbackValue=''}" Width="110" />
                <DataGridTextColumn Header="Connection" Binding="{Binding Connection[0], FallbackValue=''}" Width="100" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status.Status, FallbackValue=''}" Width="130" />
                <DataGridTextColumn Header="Speed" Binding="{Binding Speed, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Width="90" />
                <DataGridTextColumn Header="ETA" Binding="{Binding TimeRemaining, Converter={StaticResource TimeSpanConverter}, TargetNullValue=''}" Width="80" />
                <DataGridTextColumn Header="Bytes Loaded" Binding="{Binding BytesLoaded, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Width="100" />

                <DataGridTemplateColumn Header="Progress" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid x:Name="PGrid" Margin="2,3">
                                <Border Background="#D0D8E0" CornerRadius="1" Height="14" />
                                <Border Background="#6BA5D7" CornerRadius="1" HorizontalAlignment="Left" Height="14">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                            <Binding Path="Progress" />
                                            <Binding Path="ActualWidth" ElementName="PGrid" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding Progress, StringFormat='{}{0:0.0}%', TargetNullValue=''}"
                                           FontSize="10" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Save to" Binding="{Binding SaveFrom}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

            <!-- Child files (RowDetails) -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <DataGrid ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="None"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                              Background="#DDE9F4" BorderThickness="0" RowHeaderWidth="0"
                              Margin="20,0,0,0">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="MinHeight" Value="20" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Size, Converter={StaticResource ByteUnitConverter}}" Width="90" />
                            <DataGridTextColumn Binding="{Binding FileHosters[0].Name, FallbackValue=''}" Width="110" />
                            <DataGridTextColumn Binding="{Binding Path=., FallbackValue=''}" Width="100" /> <!-- Connection placeholder -->
                            <DataGridTextColumn Binding="{Binding Status.Status, FallbackValue=''}" Width="130" />
                            <DataGridTextColumn Binding="{Binding Speed, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Width="90" />
                            <DataGridTextColumn Binding="{Binding TimeRemaining, Converter={StaticResource TimeSpanConverter}, TargetNullValue=''}" Width="80" />
                            <DataGridTextColumn Binding="{Binding BytesLoaded, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Width="100" />
                            <DataGridTemplateColumn Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="FPGrid" Margin="2,2">
                                            <Border Background="#C8D4DE" CornerRadius="1" Height="12" />
                                            <Border Background="#82B8DE" CornerRadius="1" HorizontalAlignment="Left" Height="12">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                        <Binding Path="Progress" />
                                                        <Binding Path="ActualWidth" ElementName="FPGrid" />
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="{Binding Progress, StringFormat='{}{0:0.0}%', TargetNullValue=''}" FontSize="9" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Binding="{Binding SaveFrom}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Error}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="Red" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- ═══ Bottom Panel (JD2 "Download Overview" exact match) ═══ -->
        <Border Grid.Row="2" BorderBrush="#B0B0B0" BorderThickness="0,1,0,0"
                Visibility="{Binding ShowUploadOverview, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar: green icon + title + close button -->
                <Border Grid.Row="0" Padding="4,2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#F0F0F0" Offset="0" />
                            <GradientStop Color="#D8D8D8" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <!-- Close button on right -->
                        <Button DockPanel.Dock="Right" Width="16" Height="16" Margin="4,0,2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                FontSize="10" Content="&#x2715;" Foreground="#808080"
                                VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                ToolTip="Close overview" Padding="0"
                                Click="OverviewCloseButton_Click" />

                        <!-- Green arrow + title -->
                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#333333">
                            <Run Text="&#x25BC;" Foreground="#4CAF50" FontSize="10" /> <!-- Green down arrow -->
                            <Run Text=" Upload Overview" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- Stats grid with fixed column alignment like JD2 -->
                <Border Grid.Row="1" Background="#F8F8F8" Padding="6,3,6,4"
                        BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 1: Package(s):  0    Total Bytes:  0 B    Bytes loaded:  0 B    ETA:  ~    Open Connections:  0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Package(s):" FontSize="11" Foreground="#555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PackageCount}" FontSize="11" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" Margin="4,0,0,0" />

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Total Bytes:" FontSize="11" Foreground="#555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding TotalBytes}" FontSize="11" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" Margin="4,0,0,0" />

                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Bytes loaded:" FontSize="11" Foreground="#555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="7" Text="{Binding BytesLoaded}" FontSize="11" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" Margin="4,0,0,0" />

                        <TextBlock Grid.Row="0" Grid.Column="9" Text="ETA:" FontSize="11" Foreground="#555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="10" Text="{Binding Eta}" FontSize="11" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" Margin="4,0,0,0" />

                        <TextBlock Grid.Row="0" Grid.Column="12" Text="Open Connections:" FontSize="11" Foreground="#555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="13" Text="{Binding RunningUploads}" FontSize="11" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" Margin="4,0,0,0" />

                        <!-- Row 2: Link(s):  0    Uploadspeed:  0 Byte/s    Remaining Bytes:  0 B    Running Uploads:  0 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Link(s):" FontSize="11" Foreground="#555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FileCount}" FontSize="11" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" Margin="4,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Uploadspeed:" FontSize="11" Foreground="#555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding UploadSpeed}" FontSize="11" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" Margin="4,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="6" Text="Remaining Bytes:" FontSize="11" Foreground="#555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="7" Text="{Binding RemainingBytes}" FontSize="11" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" Margin="4,0,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="9" Text="" FontSize="11" />
                        <TextBlock Grid.Row="2" Grid.Column="10" Text="" FontSize="11" />

                        <TextBlock Grid.Row="2" Grid.Column="12" Text="Running Uploads:" FontSize="11" Foreground="#555" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="13" Text="{Binding RunningUploads}" FontSize="11" FontWeight="Bold" Foreground="#222" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
