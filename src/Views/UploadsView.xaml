<UserControl x:Class="CSUploader.Views.UploadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UploadsViewModel}"
             d:DesignWidth="1600" d:DesignHeight="900">

    <UserControl.Resources>
        <conv:ByteUnitConverter x:Key="ByteUnitConverter" />
        <conv:TimeSpanFormatConverter x:Key="TimeSpanConverter" />
        <conv:DateTimeFormatConverter x:Key="DateTimeConverter" />
        <conv:ProgressWidthConverter x:Key="ProgressWidthConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Shared column widths so header + rows align -->
        <GridLength x:Key="ColName">220</GridLength>
        <GridLength x:Key="ColSize">80</GridLength>
        <GridLength x:Key="ColHoster">100</GridLength>
        <GridLength x:Key="ColStatus">130</GridLength>
        <GridLength x:Key="ColSpeed">90</GridLength>
        <GridLength x:Key="ColETA">80</GridLength>
        <GridLength x:Key="ColBytesLoaded">90</GridLength>
        <GridLength x:Key="ColProgress">160</GridLength>
        <GridLength x:Key="ColSaveFrom">180</GridLength>
        <GridLength x:Key="ColError">*</GridLength>

        <!-- Row cell style -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Column header style -->
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="6,0" />
        </Style>

        <!-- Status bar label style -->
        <Style x:Key="StatusLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Toolbar ═══ -->
        <ToolBar Grid.Row="0" Band="0" BandIndex="0" ToolBarTray.IsLocked="True">
            <Button Command="{Binding StartCommand}" ToolTip="Start all uploads">
                <Image Source="{StaticResource ButtonStartImage}" Width="20" Height="20" />
            </Button>
            <Button Command="{Binding PauseCommand}" ToolTip="Pause / Resume (limits to 10 KiB/s)">
                <Image Source="{StaticResource ButtonPauseImage}" Width="20" Height="20" />
            </Button>
            <Button Command="{Binding StopCommand}" ToolTip="Stop all uploads">
                <Image Source="{StaticResource ButtonStopImage}" Width="20" Height="20" />
            </Button>
        </ToolBar>

        <!-- ═══ Column Headers (fixed row above TreeView) ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource DataGridHeaderBrush}"
                BorderBrush="{DynamicResource DataGridGridLineBrush}" BorderThickness="0,0,0,1">
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" /> <!-- TreeView expand gutter -->
                    <ColumnDefinition Width="{StaticResource ColName}" />
                    <ColumnDefinition Width="{StaticResource ColSize}" />
                    <ColumnDefinition Width="{StaticResource ColHoster}" />
                    <ColumnDefinition Width="{StaticResource ColStatus}" />
                    <ColumnDefinition Width="{StaticResource ColSpeed}" />
                    <ColumnDefinition Width="{StaticResource ColETA}" />
                    <ColumnDefinition Width="{StaticResource ColBytesLoaded}" />
                    <ColumnDefinition Width="{StaticResource ColProgress}" />
                    <ColumnDefinition Width="{StaticResource ColSaveFrom}" />
                    <ColumnDefinition Width="{StaticResource ColError}" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="3" Text="Hoster" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="5" Text="Speed" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="6" Text="ETA" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="7" Text="Loaded" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="8" Text="Progress" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="9" Text="Save to" Style="{StaticResource HeaderCell}" />
                <TextBlock Grid.Column="10" Text="Error" Style="{StaticResource HeaderCell}" />
            </Grid>
        </Border>

        <!-- ═══ TreeView (packages + files) ═══ -->
        <TreeView x:Name="uploadsTree" Grid.Row="2"
                  ItemsSource="{Binding Packages}"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderThickness="0"
                  Padding="0"
                  Tag="{Binding}">

            <TreeView.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding RemoveCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=uploadsTree}" />
            </TreeView.InputBindings>

            <TreeView.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Retry" Command="{Binding RetryCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Image Source="{StaticResource ActionRetryImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Stop" Command="{Binding StopSelectedCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon><Image Source="{StaticResource ActionCancelImage}" Width="16" Height="16" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Remove" Command="{Binding RemoveCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </TreeView.ContextMenu>

            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </TreeView.ItemContainerStyle>

            <!-- ═══ Package row ═══ -->
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding}">
                    <Grid Height="26" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource ColName}" />
                            <ColumnDefinition Width="{StaticResource ColSize}" />
                            <ColumnDefinition Width="{StaticResource ColHoster}" />
                            <ColumnDefinition Width="{StaticResource ColStatus}" />
                            <ColumnDefinition Width="{StaticResource ColSpeed}" />
                            <ColumnDefinition Width="{StaticResource ColETA}" />
                            <ColumnDefinition Width="{StaticResource ColBytesLoaded}" />
                            <ColumnDefinition Width="{StaticResource ColProgress}" />
                            <ColumnDefinition Width="{StaticResource ColSaveFrom}" />
                            <ColumnDefinition Width="{StaticResource ColError}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource ByteUnitConverter}}" Style="{StaticResource CellText}" />
                        <TextBlock Grid.Column="2" Text="" Style="{StaticResource CellText}" /> <!-- Package shows hosters in child rows -->
                        <TextBlock Grid.Column="3" Style="{StaticResource CellText}">
                            <TextBlock.Text>
                                <Binding Path="Status.Status" FallbackValue="" />
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Grid.Column="4" Text="{Binding Speed, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Style="{StaticResource CellText}" />
                        <TextBlock Grid.Column="5" Text="{Binding TimeRemaining, Converter={StaticResource TimeSpanConverter}, TargetNullValue=''}" Style="{StaticResource CellText}" />
                        <TextBlock Grid.Column="6" Text="{Binding BytesLoaded, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Style="{StaticResource CellText}" />

                        <!-- Progress bar -->
                        <Grid Grid.Column="7" Margin="6,4" x:Name="PkgProgressGrid">
                            <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="2" />
                            <Border Background="#6BA5D7" CornerRadius="2" HorizontalAlignment="Left">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                        <Binding Path="Progress" />
                                        <Binding Path="ActualWidth" ElementName="PkgProgressGrid" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding Progress, StringFormat='{}{0:0.0}%', TargetNullValue=''}"
                                       FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </Grid>

                        <TextBlock Grid.Column="8" Text="{Binding SaveFrom}" Style="{StaticResource CellText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Grid.Column="9" Text="{Binding Error}" Style="{StaticResource CellText}" Foreground="Red" />
                    </Grid>

                    <!-- ═══ PackageFile (child) row ═══ -->
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="24" Background="{DynamicResource DataGridAltRowBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource ColName}" />
                                    <ColumnDefinition Width="{StaticResource ColSize}" />
                                    <ColumnDefinition Width="{StaticResource ColHoster}" />
                                    <ColumnDefinition Width="{StaticResource ColStatus}" />
                                    <ColumnDefinition Width="{StaticResource ColSpeed}" />
                                    <ColumnDefinition Width="{StaticResource ColETA}" />
                                    <ColumnDefinition Width="{StaticResource ColBytesLoaded}" />
                                    <ColumnDefinition Width="{StaticResource ColProgress}" />
                                    <ColumnDefinition Width="{StaticResource ColSaveFrom}" />
                                    <ColumnDefinition Width="{StaticResource ColError}" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CellText}" />
                                <TextBlock Grid.Column="1" Text="{Binding Size, Converter={StaticResource ByteUnitConverter}}" Style="{StaticResource CellText}" />
                                <TextBlock Grid.Column="2" Text="{Binding FileHosters[0].Name, FallbackValue=''}" Style="{StaticResource CellText}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource CellText}">
                                    <TextBlock.Text>
                                        <Binding Path="Status.Status" FallbackValue="" />
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="{Binding Speed, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Style="{StaticResource CellText}" />
                                <TextBlock Grid.Column="5" Text="{Binding TimeRemaining, Converter={StaticResource TimeSpanConverter}, TargetNullValue=''}" Style="{StaticResource CellText}" />
                                <TextBlock Grid.Column="6" Text="{Binding BytesLoaded, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" Style="{StaticResource CellText}" />

                                <!-- Child progress bar -->
                                <Grid Grid.Column="7" Margin="6,3" x:Name="FileProgressGrid">
                                    <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="2" />
                                    <Border Background="#82B8DE" CornerRadius="2" HorizontalAlignment="Left">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                <Binding Path="Progress" />
                                                <Binding Path="ActualWidth" ElementName="FileProgressGrid" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding Progress, StringFormat='{}{0:0.0}%', TargetNullValue=''}"
                                               FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>

                                <TextBlock Grid.Column="8" Text="{Binding SaveFrom}" Style="{StaticResource CellText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="9" Text="{Binding Error}" Style="{StaticResource CellText}" Foreground="Red" />
                            </Grid>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- ═══ Status Bar (JDownloader-style summary) ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource DataGridHeaderBrush}"
                BorderBrush="{DynamicResource DataGridGridLineBrush}" BorderThickness="0,1,0,0"
                Padding="8,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 1 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Package(s):" Style="{StaticResource StatusLabel}" />
                    <TextBlock Text="{Binding PackageCount}" Style="{StaticResource StatusValue}" />

                    <TextBlock Text="Total Bytes:" Style="{StaticResource StatusLabel}" />
                    <TextBlock Text="{Binding TotalBytes}" Style="{StaticResource StatusValue}" />

                    <TextBlock Text="Bytes loaded:" Style="{StaticResource StatusLabel}" />
                    <TextBlock Text="{Binding BytesLoaded}" Style="{StaticResource StatusValue}" />

                    <TextBlock Text="ETA:" Style="{StaticResource StatusLabel}" />
                    <TextBlock Text="{Binding Eta}" Style="{StaticResource StatusValue}" />
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="File(s):" Style="{StaticResource StatusLabel}" />
                    <TextBlock Text="{Binding FileCount}" Style="{StaticResource StatusValue}" />

                    <TextBlock Text="Upload speed:" Style="{StaticResource StatusLabel}" />
                    <TextBlock Text="{Binding UploadSpeed}" Style="{StaticResource StatusValue}" />

                    <TextBlock Text="Remaining Bytes:" Style="{StaticResource StatusLabel}" />
                    <TextBlock Text="{Binding RemainingBytes}" Style="{StaticResource StatusValue}" />

                    <TextBlock Text="Running Uploads:" Style="{StaticResource StatusLabel}" />
                    <TextBlock Text="{Binding RunningUploads}" Style="{StaticResource StatusValue}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
