<Window x:Class="CSUploader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CSUploader.Views"
        xmlns:vm="clr-namespace:CSUploader.ViewModels"
        mc:Ignorable="d"
        Title="CSUploader"
        Width="1650" Height="1220"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Menu Bar + Theme Toggle ═══ -->
        <DockPanel Grid.Row="0">
            <!-- Theme toggle on the right -->
            <ToggleButton DockPanel.Dock="Right"
                          IsChecked="{Binding IsDarkMode}"
                          Command="{Binding ToggleThemeCommand}"
                          Width="60" Height="24"
                          ToolTip="Toggle dark mode"
                          Cursor="Hand"
                          Margin="0,4,8,0"
                          VerticalAlignment="Top">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder"
                                            Background="{DynamicResource SurfaceMutedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="2">
                                        <Grid>
                                            <Ellipse x:Name="Thumb"
                                                     Width="18" Height="18"
                                                     Fill="{DynamicResource AccentBrush}"
                                                     HorizontalAlignment="Left" />
                                            <TextBlock x:Name="ThemeIcon"
                                                       Text="&#x2600;"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="ThemeIcon" Property="Text" Value="&#x263D;" />
                                            <Setter TargetName="ThemeIcon" Property="HorizontalAlignment" Value="Left" />
                                            <Setter TargetName="ThemeIcon" Property="Margin" Value="6,0,0,0" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <!-- Menu bar -->
            <Menu DockPanel.Dock="Left" Background="{DynamicResource SurfaceBrush}" FontSize="12">
                <MenuItem Header="_File">
                    <MenuItem Header="_Exit" InputGestureText="Alt+F4" Click="MenuExit_Click" />
                </MenuItem>
                <MenuItem Header="_Settings">
                    <MenuItem Header="_Preferences" Click="MenuPreferences_Click" />
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="_Clear Upload History" Click="MenuClearHistory_Click" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_About CSUploader" Click="MenuAbout_Click" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Upload">
                <views:UploadView DataContext="{Binding UploadViewModel}" />
            </TabItem>
            <TabItem Header="Uploads">
                <views:UploadsView DataContext="{Binding UploadsViewModel}" />
            </TabItem>
            <TabItem Header="Uploaded">
                <views:UploadedView DataContext="{Binding UploadedViewModel}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding SettingsViewModel}" />
            </TabItem>
            <TabItem Header="Logs">
                <views:LogsView DataContext="{Binding LogsViewModel}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
