<Window x:Class="CSUploader.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CSUploader.Views"
        xmlns:vm="clr-namespace:CSUploader.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1024" Height="800"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Menu Bar ═══ -->
        <Menu Grid.Row="0" Background="{DynamicResource SurfaceBrush}" FontSize="12">
                <MenuItem Header="_File">
                    <MenuItem Header="_Exit" InputGestureText="Alt+F4" Click="MenuExit_Click" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Upload _Overview" IsCheckable="True"
                              IsChecked="{Binding UploadsViewModel.ShowUploadOverview}" />
                    <Separator />
                    <MenuItem Header="{Binding ThemeMenuLabel}" Command="{Binding ToggleThemeCommand}" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_Check for Updates…" Click="MenuCheckForUpdates_Click" />
                    <MenuItem Header="_Install Update"
                              Command="{Binding InstallUpdateCommand}"
                              IsEnabled="{Binding IsUpdateAvailable}" />
                    <Separator />
                    <MenuItem Header="_About CSUploader" Click="MenuAbout_Click" />
                </MenuItem>
        </Menu>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    PreviewMouseLeftButtonDown="TabControl_PreviewMouseLeftButtonDown">
            <TabItem Header="Uploads">
                <views:UploadsView DataContext="{Binding UploadsViewModel}" />
            </TabItem>
            <TabItem Header="Uploaded">
                <views:UploadedView DataContext="{Binding UploadedViewModel}" />
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding SettingsViewModel}" />
            </TabItem>
            <TabItem Header="Logs">
                <views:LogsView DataContext="{Binding LogsViewModel}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
