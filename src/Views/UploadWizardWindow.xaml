<Window x:Class="CSUploader.Views.UploadWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CSUploader.Converters"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:vm="clr-namespace:CSUploader.ViewModels"
        Title="Upload Wizard"
        Width="850" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfaceBrush}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico"
        d:DataContext="{d:DesignInstance Type=vm:UploadWizardViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:ByteUnitConverter x:Key="ByteUnitConverter" />
    <conv:StepVisibilityConverter x:Key="StepVisibilityConverter" />
    <conv:StepFontConverter x:Key="StepFontConverter" />
    <conv:EnumBoolConverter x:Key="EnumBoolConverter" />
    <conv:FileTypeIconConverter x:Key="FileTypeIconConverter" />
    <conv:HosterIconConverter x:Key="HosterIconConverter" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Step indicator -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Text="1. Directory" FontSize="13" FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=0}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0" />
        <TextBlock Text="2. Files" FontSize="13" FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=1}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0" />
        <TextBlock Text="3. File Hosters" FontSize="13" FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=2}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0" />
        <TextBlock Text="4. Start" FontSize="13" FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=3}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </StackPanel>
    </Border>

    <!-- Step content -->
    <Grid Grid.Row="1" Margin="20,16,20,8">

      <!-- Step 0: Directory -->
      <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=0}">
        <TextBlock Text="Select Upload Directory" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
        <TextBlock Text="Choose the directory containing the files you want to upload."
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="12" Padding="6,5" VerticalContentAlignment="Center" />
          <Button Grid.Column="1" Content="Browse" Width="80" Margin="8,0,0,0"
                  Command="{Binding BrowseDirectoryCommand}" />
        </Grid>
      </StackPanel>

      <!-- Step 1: Files -->
      <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select Files" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Package title:" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" Text="{Binding PackageTitle, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="12" Padding="4,3" VerticalContentAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Filter:" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="12" Padding="4,3" VerticalContentAlignment="Center" />
          <Button Grid.Column="2" Content="All" Width="50" Margin="8,0,0,0"
                  Command="{Binding SelectAllCommand}" />
          <Button Grid.Column="3" Content="None" Width="50" Margin="4,0,0,0"
                  Command="{Binding SelectNoneCommand}" />
        </Grid>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Files}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" SelectionMode="Single" RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  Background="{DynamicResource ContentBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <DataGrid.RowStyle>
            <!-- BasedOn the global implicit style so we keep its Foreground/selection setters
                 (otherwise inline triggers replace them and rows render in the system colour).
                 Foreground/Background/Opacity are repeated here as belt-and-suspenders in case
                 the BasedOn lookup fails (implicit-style key resolution can be flaky in some
                 Window scopes). -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Opacity" Value="1" />
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="35">
              <DataGridCheckBoxColumn.ElementStyle>
                <Style TargetType="CheckBox">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridCheckBoxColumn.ElementStyle>
            </DataGridCheckBoxColumn>
            <DataGridTemplateColumn Header="File" Width="*" IsReadOnly="True"
                                    SortMemberPath="RelativePath"
                                    ClipboardContentBinding="{Binding RelativePath}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Source="{Binding RelativePath, Converter={StaticResource FileTypeIconConverter}}"
                                     Width="16" Height="16" Margin="2,0,6,0" />
                    <TextBlock Text="{Binding RelativePath}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource ByteUnitConverter}}" Width="100" IsReadOnly="True">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Margin="0,4,0,0" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}">
          <Run Text="Selected:" />
          <Run Text="{Binding Files.Count, Mode=OneWay}" />
          <Run Text="file(s)" />
        </TextBlock>
      </Grid>

      <!-- Step 2: File Hosters -->
      <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select File Hosters" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="Choose which file hosters to upload to and select accounts."
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding FileHosters}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" SelectionMode="Single" RowHeaderWidth="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  VerticalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  Background="{DynamicResource ContentBackgroundBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <DataGrid.RowStyle>
            <!-- Same fix as the Files grid above: explicit Foreground/Opacity so rows render
                 in the theme colour instead of the system fallback. -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Opacity" Value="1" />
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
          </DataGrid.CellStyle>
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="Use" Binding="{Binding Use, UpdateSourceTrigger=PropertyChanged}" Width="42">
              <DataGridCheckBoxColumn.ElementStyle>
                <Style TargetType="CheckBox">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridCheckBoxColumn.ElementStyle>
            </DataGridCheckBoxColumn>
            <DataGridTemplateColumn Header="File Hoster" Width="180" IsReadOnly="True"
                                    SortMemberPath="FileHosterName"
                                    ClipboardContentBinding="{Binding FileHosterName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{Binding FileHosterName, Converter={StaticResource HosterIconConverter}}"
                           Width="18" Height="18" Margin="0,0,6,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding FileHosterName}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Account" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <ComboBox ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Username"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Width="200"
                              Padding="4,2" FontSize="12"
                              Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="(anonymous)" VerticalAlignment="Center"
                               FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource TextDisabledBrush}" Padding="6,2">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAccounts}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- Step 3: When to start -->
      <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">
        <TextBlock Text="When to Start" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
        <TextBlock Text="Choose when the upload should begin."
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

        <StackPanel Margin="0,0,0,12">
          <RadioButton Content="Start immediately after closing the wizard"
                       IsChecked="{Binding StartMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Immediately}"
                       Margin="0,0,0,10" FontSize="12" />
          <RadioButton Content="Add to queue but start later (manual start)"
                       IsChecked="{Binding StartMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Later}"
                       Margin="0,0,0,10" FontSize="12" />
          <RadioButton Content="Schedule for a specific date and time"
                       IsChecked="{Binding StartMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Scheduled}"
                       Margin="0,0,0,10" FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="24,0,0,0"
                    Visibility="{Binding IsScheduledMode, Converter={StaticResource BoolToVisibility}}">
          <DatePicker SelectedDate="{Binding ScheduledDate}" Width="160" FontSize="12" VerticalContentAlignment="Center" />
          <TextBox Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="8,0,0,0"
                   FontSize="12" Padding="4,3" VerticalContentAlignment="Center" />
          <TextBlock Text="(HH:mm)" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Bottom buttons -->
    <Border Grid.Row="2" Padding="20,8,20,12"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceAltBrush}">
      <Grid>
        <Button Content="Back" Width="80" Height="30" HorizontalAlignment="Left"
                Command="{Binding GoBackCommand}"
                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Width="80" Height="30" IsCancel="True" Margin="0,0,8,0" />
          <Button Content="{Binding NextButtonText}" Width="100" Height="30"
                  Command="{Binding GoNextCommand}"
                  Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
