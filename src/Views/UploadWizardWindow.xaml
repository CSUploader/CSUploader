<Window x:Class="CSUploader.Views.UploadWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CSUploader.Converters"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        xmlns:vm="clr-namespace:CSUploader.ViewModels"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        Title="{loc:Loc Wizard_Title}"
        Width="850" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfaceBrush}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico"
        d:DataContext="{d:DesignInstance Type=vm:UploadWizardViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:ByteUnitConverter x:Key="ByteUnitConverter" />
    <conv:StepVisibilityConverter x:Key="StepVisibilityConverter" />
    <conv:StepFontConverter x:Key="StepFontConverter" />
    <conv:EnumBoolConverter x:Key="EnumBoolConverter" />
    <conv:FileTypeIconConverter x:Key="FileTypeIconConverter" />
    <conv:HosterIconConverter x:Key="HosterIconConverter" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Step indicator -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <TextBlock Text="{loc:Loc Wizard_Step_DirectorySource}" FontSize="13"
                   FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=0}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0"
                   Visibility="{Binding IsDirectoryMode, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{loc:Loc Wizard_Step_FilesSource}" FontSize="13"
                   FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=0}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0"
                   Visibility="{Binding IsFilesMode, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Text="{loc:Loc Wizard_Step_FileHosters}" FontSize="13"
                   FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=1}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0" />
        <TextBlock Text="{loc:Loc Wizard_Step_Start}" FontSize="13"
                   FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=2}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </StackPanel>
    </Border>

    <!-- Step content -->
    <Grid Grid.Row="1" Margin="20,16,20,8">

      <!-- Step 0: source picker + file list (merged) -->
      <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=0}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /> <!-- mode picker -->
          <RowDefinition Height="Auto" /> <!-- source picker (mode-aware) -->
          <RowDefinition Height="Auto" /> <!-- package title -->
          <RowDefinition Height="Auto" /> <!-- filter -->
          <RowDefinition Height="Auto" /> <!-- bulk-select buttons -->
          <RowDefinition Height="*" />    <!-- DataGrid -->
          <RowDefinition Height="Auto" /> <!-- selected-count footer -->
        </Grid.RowDefinitions>

        <!-- Row 0: mode picker -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
          <RadioButton Content="{loc:Loc Wizard_Step0_Mode_Directory}"
                       IsChecked="{Binding Mode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Directory}"
                       GroupName="WizardMode" Margin="0,0,16,0" FontSize="12" />
          <RadioButton Content="{loc:Loc Wizard_Step0_Mode_Files}"
                       IsChecked="{Binding Mode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Files}"
                       GroupName="WizardMode" FontSize="12" />
        </StackPanel>

        <!-- Row 1: source picker (mode-aware) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
          <!-- Directory mode source picker -->
          <Grid Visibility="{Binding IsDirectoryMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="12" Padding="6,5" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="{loc:Loc Wizard_Step0_Browse}" Width="80" Margin="8,0,0,0"
                    Command="{Binding BrowseDirectoryCommand}" />
          </Grid>

          <!-- Files mode source picker -->
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding IsFilesMode, Converter={StaticResource BoolToVisibility}}">
            <Button Content="{loc:Loc Wizard_Step0_Files_Pick}" MinWidth="120" Padding="10,6"
                    Command="{Binding BrowseFilesCommand}" />
          </StackPanel>
        </Grid>

        <!-- Row 2: package title -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{loc:Loc Wizard_Step1_PackageTitleLabel}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" Text="{Binding PackageTitle, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="12" Padding="4,3" VerticalContentAlignment="Center" />
        </Grid>

        <!-- Row 3: filter -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{loc:Loc Wizard_Step1_FilterLabel}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="12" Padding="4,3" VerticalContentAlignment="Center" />
        </Grid>

        <!-- Row 4: bulk-select buttons sit above the file list so it's clear they
             act on the file list below, not on the filter textbox. -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
          <Button Content="{loc:Loc Wizard_Step1_BtnSelectAll}" MinWidth="100" Padding="10,4"
                  Command="{Binding SelectAllCommand}" />
          <Button Content="{loc:Loc Wizard_Step1_BtnDeselectAll}" MinWidth="100" Padding="10,4" Margin="6,0,0,0"
                  Command="{Binding SelectNoneCommand}" />
          <Button Content="{loc:Loc Wizard_Step1_BtnAddMore}" MinWidth="120" Padding="10,4" Margin="6,0,0,0"
                  Command="{Binding AddMoreFilesCommand}"
                  Visibility="{Binding IsFilesMode, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Row 5: DataGrid of files -->
        <DataGrid Grid.Row="5" ItemsSource="{Binding Files}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" SelectionMode="Single" RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  Background="{DynamicResource ContentBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <DataGrid.RowStyle>
            <!-- BasedOn the global implicit style so we keep its Foreground/selection setters
                 (otherwise inline triggers replace them and rows render in the system colour).
                 Foreground/Background/Opacity are repeated here as belt-and-suspenders in case
                 the BasedOn lookup fails (implicit-style key resolution can be flaky in some
                 Window scopes). -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Opacity" Value="1" />
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="35">
              <DataGridCheckBoxColumn.ElementStyle>
                <Style TargetType="CheckBox">
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridCheckBoxColumn.ElementStyle>
            </DataGridCheckBoxColumn>
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step1_Col_File}" Width="*" IsReadOnly="True"
                                    SortMemberPath="RelativePath"
                                    ClipboardContentBinding="{Binding RelativePath}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <svgc:SvgViewbox Source="{Binding RelativePath, Converter={StaticResource FileTypeIconConverter}}"
                                     Width="16" Height="16" Margin="2,0,6,0" />
                    <TextBlock Text="{Binding RelativePath}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="{loc:Loc Wizard_Step1_Col_Size}" Binding="{Binding Size, Converter={StaticResource ByteUnitConverter}}" Width="100" IsReadOnly="True">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Row 6: selected-count footer -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,4,0,0">
          <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="{loc:Loc Wizard_Step1_SelectedLabel}" />
          <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="4,0,0,0" Text="{Binding Files.Count, Mode=OneWay}" />
          <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                     Margin="4,0,0,0" Text="{loc:Loc Wizard_Step1_FilesUnit}" />
        </StackPanel>
      </Grid>

      <!-- Step 1: File Hosters -->
      <Grid Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Wizard_Step2_Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="{loc:Loc Wizard_Step2_Desc}"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding FileHosters}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="False" SelectionMode="Single" RowHeaderWidth="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  VerticalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  Background="{DynamicResource ContentBackgroundBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <DataGrid.RowStyle>
            <!-- Same fix as the Files grid above: explicit Foreground/Opacity so rows render
                 in the theme colour instead of the system fallback. -->
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Opacity" Value="1" />
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                  <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
          </DataGrid.CellStyle>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step2_Col_Use}" Width="42"
                                    SortMemberPath="Use">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding Use, UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               ToolTip="{loc:Loc Wizard_Step2_AccountRequiredTooltip}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAccounts}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step2_Col_FileHoster}" Width="180" IsReadOnly="True"
                                    SortMemberPath="FileHosterName"
                                    ClipboardContentBinding="{Binding FileHosterName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasAccounts}" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="ToolTip" Value="{loc:Loc Wizard_Step2_AccountRequiredTooltip}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <Image Source="{Binding FileHosterName, Converter={StaticResource HosterIconConverter}}"
                           Width="18" Height="18" Margin="0,0,6,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="FontStyle" Value="Normal" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAccounts}" Value="False">
                              <Setter Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                      <Run Text="{Binding FileHosterName, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step2_Col_Account}" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <ComboBox ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Username"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Width="200"
                              Padding="4,2" FontSize="12"
                              Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Padding="6,2">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAccounts}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                      <Hyperlink Foreground="{DynamicResource AccentBrush}"
                                 Command="{Binding DataContext.AddAccountForHosterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                 CommandParameter="{Binding}"
                                 ToolTip="{loc:Loc Wizard_Step2_AccountRequiredTooltip}">
                        <Run Text="{loc:Loc Wizard_Step2_AddAccountLink}" />
                      </Hyperlink>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>

      <!-- Step 2: When to start -->
      <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">
        <TextBlock Text="{loc:Loc Wizard_Step3_Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
        <TextBlock Text="{loc:Loc Wizard_Step3_Desc}"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

        <StackPanel Margin="0,0,0,12">
          <RadioButton Content="{loc:Loc Wizard_Step3_Mode_Immediately}"
                       IsChecked="{Binding StartMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Immediately}"
                       Margin="0,0,0,10" FontSize="12" />
          <RadioButton Content="{loc:Loc Wizard_Step3_Mode_Later}"
                       IsChecked="{Binding StartMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Later}"
                       Margin="0,0,0,10" FontSize="12" />
          <RadioButton Content="{loc:Loc Wizard_Step3_Mode_Scheduled}"
                       IsChecked="{Binding StartMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Scheduled}"
                       Margin="0,0,0,10" FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="24,0,0,0"
                    Visibility="{Binding IsScheduledMode, Converter={StaticResource BoolToVisibility}}">
          <DatePicker SelectedDate="{Binding ScheduledDate}" Width="160" FontSize="12" VerticalContentAlignment="Center" />
          <TextBox Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="8,0,0,0"
                   FontSize="12" Padding="4,3" VerticalContentAlignment="Center" />
          <TextBlock Text="{loc:Loc Wizard_Step3_TimeFormatHint}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Bottom buttons -->
    <Border Grid.Row="2" Padding="20,8,20,12"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceAltBrush}">
      <Grid>
        <Button Content="{loc:Loc Wizard_Btn_Back}" Width="80" Height="30" HorizontalAlignment="Left"
                Command="{Binding GoBackCommand}"
                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="{loc:Loc Wizard_Btn_Cancel}" Width="80" Height="30" IsCancel="True" Margin="0,0,8,0" />
          <Button Content="{Binding NextButtonText}" Width="100" Height="30"
                  Command="{Binding GoNextCommand}"
                  Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
