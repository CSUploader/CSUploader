<UserControl x:Class="CSUploader.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UploadViewModel}"
             d:DesignWidth="1600" d:DesignHeight="1100">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Compact DataGrid row style -->
        <Style x:Key="CompactDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="{StaticResource DataGridRowHeight}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource DataGridAltRowBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Compact DataGrid cell style -->
        <Style x:Key="CompactDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact column header style -->
        <Style x:Key="CompactColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10,8,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════ Input Section ═══════════════════ -->
        <GroupBox Grid.Row="0" Header="Input" Margin="{StaticResource SectionSpacing}">
            <Grid Margin="{StaticResource GroupBoxPadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource LabelWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Directory:" Style="{StaticResource FormLabelStyle}" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CompactTextBoxStyle}" Margin="0,0,6,4" />
                <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Command="{Binding BrowseInputDirectoryCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Regex Pattern:" Style="{StaticResource FormLabelStyle}" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding DirectoryPattern, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CompactTextBoxStyle}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Naming Expression:" Style="{StaticResource FormLabelStyle}" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PackageNamingExpression, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource CompactTextBoxStyle}" Margin="0,0,0,4" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Result Preview:" Style="{StaticResource FormLabelStyle}" />
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding PackageNamingResult, Mode=OneWay}"
                         Style="{StaticResource CompactTextBoxStyle}" IsReadOnly="True" Background="{DynamicResource SurfaceMutedBrush}" />
            </Grid>
        </GroupBox>

        <!-- ═══════════════════ Compression Section ═══════════════════ -->
        <GroupBox Grid.Row="1" Header="Compression" Margin="{StaticResource SectionSpacing}">
            <StackPanel Margin="{StaticResource GroupBoxPadding}">
                <CheckBox Content="Enable compression" IsChecked="{Binding EnableCompression}" FontSize="{StaticResource FontSizeMd}" />

                <!-- Collapsible compression details -->
                <Grid Visibility="{Binding EnableCompression, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Archive type -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="8" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="7z" IsChecked="{Binding Is7zSelected}" Margin="0,0,16,0" GroupName="ArchiveType" />
                        <RadioButton Content="RAR" IsChecked="{Binding IsRarSelected}" GroupName="ArchiveType" />
                    </StackPanel>

                    <!-- Row 1: Level, Method, Dictionary, Word Size -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Level:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,6" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CompressionLevels}" SelectedItem="{Binding SelectedCompressionLevel}"
                              DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,12,6" />

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Method:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,6" />
                    <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding CompressionMethods}" SelectedItem="{Binding SelectedCompressionMethod}"
                              DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,12,6" />

                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Dictionary:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,6" />
                    <ComboBox Grid.Row="1" Grid.Column="5" ItemsSource="{Binding DictionarySizes}" SelectedItem="{Binding SelectedDictionarySize}"
                              DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,12,6" />

                    <TextBlock Grid.Row="1" Grid.Column="6" Text="Word Size:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,6" />
                    <ComboBox Grid.Row="1" Grid.Column="7" ItemsSource="{Binding WordSizes}" SelectedItem="{Binding SelectedWordSize}"
                              DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,0,6" />

                    <!-- Row 2: Solid Block, Split Volume, CPU Threads, Password -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Solid Block:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,6" />
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SolidBlockSizes}" SelectedItem="{Binding SelectedSolidBlockSize}"
                              DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,12,6" />

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Split Vol:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,6" />
                    <ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding SplitVolumes}" SelectedItem="{Binding SelectedSplitVolume}"
                              DisplayMemberPath="Value" SelectedValuePath="Key" Style="{StaticResource CompactComboBoxStyle}" Margin="0,0,12,6" />

                    <TextBlock Grid.Row="2" Grid.Column="4" Text="Threads:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,6" />
                    <StackPanel Grid.Row="2" Grid.Column="5" Orientation="Horizontal" Margin="0,0,12,6">
                        <TextBox Text="{Binding CpuThreads, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CompactTextBoxStyle}" Width="45" />
                        <TextBlock VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="/ " /><Run Text="{Binding MaxCpuThreads, Mode=OneTime}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="6" Text="Password:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,6" />
                    <PasswordBox Grid.Row="2" Grid.Column="7" Style="{StaticResource CompactPasswordBoxStyle}" Margin="0,0,0,6"
                                 x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />

                    <!-- Row 3: Confirm password, Output directory -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Confirm:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0" />
                    <PasswordBox Grid.Row="3" Grid.Column="1" Style="{StaticResource CompactPasswordBoxStyle}" Margin="0,0,12,0"
                                 x:Name="ConfirmPasswordBox" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Output Dir:" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0" />
                    <TextBox Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="4" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource CompactTextBoxStyle}" Margin="0,0,6,0" />
                    <Button Grid.Row="3" Grid.Column="7" Content="Browse..." Command="{Binding BrowseOutputDirectoryCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ═══════════════════ File Hosters Section ═══════════════════ -->
        <GroupBox Grid.Row="2" Header="File Hosters" Margin="{StaticResource SectionSpacing}">
            <DataGrid Margin="6"
                      ItemsSource="{Binding FileHosters}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource SurfaceBrush}"
                      AlternationCount="2"
                      RowStyle="{StaticResource CompactDataGridRowStyle}"
                      CellStyle="{StaticResource CompactDataGridCellStyle}"
                      ColumnHeaderStyle="{StaticResource CompactColumnHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Use" Binding="{Binding Use, UpdateSourceTrigger=PropertyChanged}" Width="42">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="File Hoster" Binding="{Binding FileHosterName, Mode=OneWay}" Width="160" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Account" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Accounts}"
                                          SelectedItem="{Binding SelectedAccount, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Username"
                                          VerticalAlignment="Center"
                                          Padding="4,2"
                                          FontSize="{StaticResource FontSizeSm}"
                                          BorderThickness="0"
                                          Background="Transparent" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- ═══════════════════ Upload Button ═══════════════════ -->
        <Button Grid.Row="3" Content="Upload" Command="{Binding UploadCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" Width="120" Height="34" Margin="0,8,0,0" />
    </Grid>
</UserControl>
