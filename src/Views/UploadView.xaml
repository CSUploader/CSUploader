<UserControl x:Class="CSUploader.Views.UploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UploadViewModel}"
             d:DesignWidth="1600" d:DesignHeight="1100"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="40,2,0,10" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingComboBox" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel Margin="20,16,20,20" MaxWidth="900">

                <!-- Section 1: Upload Directory -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource PackageOpenImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Upload Directory" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}" Text="Select the directory containing files to upload." />

                <Grid Margin="40,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding InputDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingInput}" />
                    <Button Grid.Column="1" Content="Browse" Width="75" Margin="8,0,0,0" Command="{Binding BrowseInputDirectoryCommand}" />
                </Grid>

                <!-- Section 2: File Hosters -->
                <StackPanel Orientation="Horizontal" Margin="0,24,0,2">
                    <Image Source="{StaticResource FileHosterRapidgatorImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="File Hosters" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}" Text="Select which file hosters to upload to and choose accounts." />

                <DataGrid Margin="40,0,0,0" MinHeight="120"
                          ItemsSource="{Binding FileHosters}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          PreviewMouseWheel="FileHostersGrid_PreviewMouseWheel"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                          VerticalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeaderWidth="0"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource BorderBrush}"
                          Background="{DynamicResource ContentBackgroundBrush}"
                          AlternatingRowBackground="{DynamicResource ContentAltBackgroundBrush}"
                          RowBackground="{DynamicResource ContentBackgroundBrush}"
                          AlternationCount="2">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="FontSize" Value="12" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Use" Binding="{Binding Use, UpdateSourceTrigger=PropertyChanged}" Width="42">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Header="File Hoster" Binding="{Binding FileHosterName, Mode=OneWay}" Width="160" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="4,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Account" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Dropdown when accounts exist -->
                                        <ComboBox ItemsSource="{Binding Accounts}"
                                                  SelectedItem="{Binding SelectedAccount, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Username"
                                                  VerticalAlignment="Center"
                                                  Padding="4,2" FontSize="12"
                                                  BorderThickness="0" Background="Transparent"
                                                  Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- "(anonymous)" when no accounts -->
                                        <TextBlock Text="(anonymous)" VerticalAlignment="Center"
                                                   FontSize="12" FontStyle="Italic" Foreground="{DynamicResource TextDisabledBrush}" Padding="6,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAccounts}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </ScrollViewer>

        <!-- Upload Button -->
        <Border Grid.Row="1" Padding="20,8,20,12">
            <Button Content="Upload" Command="{Binding UploadCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" Width="120" Height="34" />
        </Border>
    </Grid>
</UserControl>
