<UserControl x:Class="CSUploader.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1600" d:DesignHeight="900">

    <UserControl.Resources>
        <!-- Sidebar item style -->
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E0EEF9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBE1F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header style (icon + bold title + separator) -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="SettingInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Width" Value="200" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Left Sidebar ═══ -->
        <ListBox Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                 BorderThickness="0"
                 SelectedItem="{Binding SelectedCategory}"
                 ItemContainerStyle="{StaticResource SidebarItem}"
                 SelectionMode="Single">
            <ListBoxItem IsSelected="True">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#x2699;" FontSize="28" HorizontalAlignment="Center" Foreground="#E74C3C" />
                    <TextBlock Text="General" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#x2191;" FontSize="28" HorizontalAlignment="Center" Foreground="#3498DB" />
                    <TextBlock Text="Upload" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#x1F464;" FontSize="28" HorizontalAlignment="Center" Foreground="#2ECC71" />
                    <TextBlock Text="Accounts" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </ListBoxItem>
            <ListBoxItem>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#x2139;" FontSize="28" HorizontalAlignment="Center" Foreground="#9B59B6" />
                    <TextBlock Text="About" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </ListBoxItem>
        </ListBox>

        <!-- Divider -->
        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <!-- ═══ Right Content Area ═══ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel MaxWidth="900">

                <!-- ────── Temp Archive Directory ────── -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Temp Archive Directory" Style="{StaticResource SectionTitle}" />
                    <Separator Margin="0,2,0,6" />
                    <TextBlock Style="{StaticResource SectionDescription}"
                               Text="Set the temporary archive directory. Compressed archives are created here before uploading." />

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding TempArchiveDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Padding="6,4" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Browse" Width="75" Margin="8,0,0,0"
                                Command="{Binding BrowseTempDirectoryCommand}" />
                    </Grid>
                </StackPanel>

                <!-- ────── Upload Management ────── -->
                <StackPanel Margin="0,0,0,24">
                    <TextBlock Text="Upload Management" Style="{StaticResource SectionTitle}" />
                    <Separator Margin="0,2,0,6" />
                    <TextBlock Style="{StaticResource SectionDescription}"
                               Text="Connection limits, upload order, priorities... set up the upload controller details." />

                    <!-- Max simultaneous uploads -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max. simultaneous Uploads" Style="{StaticResource SettingLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding MaxConcurrentUploadJobs, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SettingInput}" />
                    </Grid>

                    <!-- Max simultaneous CPU jobs -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max. simultaneous CPU Jobs (compression/hashing)" Style="{StaticResource SettingLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding MaxConcurrentCPUJobs, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SettingInput}" />
                    </Grid>

                    <!-- Speed limit -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Speed Limit (KB/s)" Style="{StaticResource SettingLabel}" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding SpeedLimitEnabled}"
                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="2" Text="{Binding SpeedLimitValue, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SettingInput}" IsEnabled="{Binding SpeedLimitEnabled}" />
                    </Grid>
                </StackPanel>

                <!-- ────── Save ────── -->
                <Button Content="Save" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="120" Height="34" HorizontalAlignment="Left" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
