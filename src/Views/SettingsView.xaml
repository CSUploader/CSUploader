<UserControl x:Class="CSUploader.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:beh="clr-namespace:CSUploader.Behaviors"
             xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1024" d:DesignHeight="800"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
        <conv:AccountCheckStatusToColorConverter x:Key="AccountCheckStatusToColor" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ProxyTestOutcomeIconConverter x:Key="ProxyTestOutcomeIcon" />
        <conv:HosterIconConverter x:Key="HosterIconConverter" />
        <conv:ByteUnitConverter x:Key="ByteUnit" />
        <conv:DateTimeFormatConverter x:Key="DateTimeFormat" />
        <conv:StorageAvailableDisplayMultiConverter x:Key="StorageAvailableDisplayMulti" />

        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="40,2,0,10" />
        </Style>

        <!-- Hovering a row highlights it (JD2-style) so the user can tell which setting
             pairs with which description. Background=Transparent so the grid is
             hit-testable across its full width; the IsMouseOver trigger swaps the fill. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="40,0,0,2" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox Background="Transparent" BorderThickness="0"
                     SelectedIndex="{Binding SelectedCategoryIndex}"
                     ItemContainerStyle="{StaticResource SidebarItem}"
                     SelectionMode="Single" Padding="0" Margin="0">
                <ListBoxItem IsSelected="True">
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource StatusOkImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{loc:Loc Settings_Sidebar_General}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource StatusUploadingImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{loc:Loc Settings_Sidebar_Upload}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource ActionSpeedImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{loc:Loc Settings_Sidebar_Connection}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource AccountImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{loc:Loc Settings_Sidebar_Accounts}" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource SidebarSeparatorBrush}" />

        <!-- Content panels (switched by SelectedCategoryIndex) -->

        <!-- 0: General -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}" Padding="0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="20,16,20,20" MaxWidth="900">
                <!-- Language. The picker takes effect immediately; already-open dialogs
                     keep whatever language they captured at construction. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Path Data="{StaticResource SettingsLanguageGeometry}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="20" Height="20" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock Text="{loc:Loc Settings_General_Language_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}"
                           Text="{loc:Loc Settings_General_Language_Desc}" />

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_General_Language_Label}" Style="{StaticResource SettingLabel}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding LanguageOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding Language}"
                              FontSize="12" Padding="4,3" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
                    <Path Data="{StaticResource SettingsDeveloperGeometry}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="20" Height="20" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock Text="{loc:Loc Settings_General_Developer_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}" Text="{loc:Loc Settings_General_Developer_Desc}" />

                <Grid Style="{StaticResource SettingRow}">
                    <CheckBox Content="{loc:Loc Settings_General_UseMockServer}"
                              IsChecked="{Binding UseMockServer}" VerticalAlignment="Center" />
                </Grid>

                <!-- Grid appearance (font for Uploads / Uploaded tabs) -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
                    <Path Data="{StaticResource SettingsGridAppearanceGeometry}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="20" Height="20" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock Text="{loc:Loc Settings_General_GridAppearance_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}"
                           Text="{loc:Loc Settings_General_GridAppearance_Desc}" />

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_General_GridFont}" Style="{StaticResource SettingLabel}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding GridFontFamilyOptions}"
                              SelectedItem="{Binding GridFontFamily}"
                              FontSize="12" Padding="4,3">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Two-column row: the font's name in the default UI font (so
                                     CJK/Arabic-only fonts don't render their English name as
                                     boxes) plus a small "AaBb 123" sample in the actual font as
                                     a preview. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding}" />
                                    <TextBlock Grid.Column="1" Text="AaBb 123"
                                               FontFamily="{Binding}"
                                               Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_General_GridFontSize}" Style="{StaticResource SettingLabel}" />
                    <TextBox Grid.Column="1"
                             Text="{Binding GridFontSize, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                             Style="{StaticResource SettingInput}"
                             HorizontalContentAlignment="Right" />
                </Grid>

                <!-- Window behaviour (minimize / close → tray) -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
                    <Path Data="{StaticResource SettingsWindowBehaviourGeometry}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="20" Height="20" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock Text="{loc:Loc Settings_General_WindowBehaviour_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}"
                           Text="{loc:Loc Settings_General_WindowBehaviour_Desc}" />

                <Grid Style="{StaticResource SettingRow}">
                    <CheckBox Content="{loc:Loc Settings_General_MinimizeToTray}"
                              IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_General_CloseAction}" Style="{StaticResource SettingLabel}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding CloseActionOptions}"
                              SelectedValue="{Binding CloseAction}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              FontSize="12" Padding="4,3" />
                </Grid>

                <!-- Notifications -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
                    <Path Data="{StaticResource SettingsNotificationsGeometry}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="20" Height="20" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock Text="{loc:Loc Settings_General_Notifications_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}"
                           Text="{loc:Loc Settings_General_Notifications_Desc}" />

                <Grid Style="{StaticResource SettingRow}">
                  <CheckBox Content="{loc:Loc Settings_General_ShowCompletionToasts}"
                            IsChecked="{Binding ShowCompletionToasts}" VerticalAlignment="Center" />
                </Grid>

                <!-- Confirmation prompts -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
                    <Path Data="{StaticResource SettingsConfirmationGeometry}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="20" Height="20" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock Text="{loc:Loc Settings_General_ConfirmationPrompts_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}"
                           Text="{loc:Loc Settings_General_ConfirmationPrompts_Desc}" />

                <ItemsControl ItemsSource="{Binding ConfirmationPrompts}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- SettingRow gives each prompt the same full-width hover highlight
                                 as the other settings (and the 40px indent). -->
                            <Grid Style="{StaticResource SettingRow}">
                                <CheckBox IsChecked="{Binding AskAgain}"
                                          Content="{Binding Label}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Database — destructive cleanup, kept last on the page so the user has to
                     scroll past the everyday settings to reach it. -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
                    <Path Data="{StaticResource SettingsDatabaseGeometry}"
                          Fill="{DynamicResource AccentBrush}"
                          Width="20" Height="20" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="2,0,10,0" />
                    <TextBlock Text="{loc:Loc Settings_General_Database_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}"
                           Text="{loc:Loc Settings_General_Database_Desc}" />

                <Grid Margin="40,4,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="120" Height="28"
                                Command="{Binding ClearDatabaseCommand}"
                                Content="{loc:Loc Settings_General_Database_BtnClear}"
                                Style="{StaticResource JD2Button}" />
                        <Button Width="120" Height="28" Margin="8,0,0,0"
                                Command="{Binding ClearLogsCommand}"
                                Content="{loc:Loc Settings_General_Database_BtnClearLogs}"
                                Style="{StaticResource JD2Button}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 1: Upload -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}" Padding="0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="20,16,20,20" MaxWidth="900">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource StatusRunningImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc Settings_Upload_Mgmt_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}" Text="{loc:Loc Settings_Upload_Mgmt_Desc}" />

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_MaxConcurrent}" Style="{StaticResource SettingLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding MaxConcurrentUploadJobs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingInput}" HorizontalContentAlignment="Right" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="252" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_MaxPerHoster}" Style="{StaticResource SettingLabel}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding MaxUploadsPerHostEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="2" Text="{Binding MaxUploadsPerHost, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingInput}" IsEnabled="{Binding MaxUploadsPerHostEnabled}" HorizontalContentAlignment="Right" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_RemoveFinished}" Style="{StaticResource SettingLabel}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding RemoveFinishedUploadsOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding RemoveFinishedUploads}"
                              FontSize="12" Padding="4,3" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_IfFileExists}" Style="{StaticResource SettingLabel}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding IfFileExistsOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding IfFileExists}"
                              FontSize="12" Padding="4,3" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_MaxCpuJobs}" Style="{StaticResource SettingLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding MaxConcurrentCPUJobs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingInput}" HorizontalContentAlignment="Right" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="252" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_SpeedLimit}" Style="{StaticResource SettingLabel}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding SpeedLimitEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="2" Text="{Binding SpeedLimitValue, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingInput}" IsEnabled="{Binding SpeedLimitEnabled}" HorizontalContentAlignment="Right" />
                </Grid>

                <!-- Autostart Uploads -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
                    <Image Source="{StaticResource StatusUploadingImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc Settings_Upload_Autostart_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}"
                           Text="{loc:Loc Settings_Upload_Autostart_Desc}" />

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_Autostart}" Style="{StaticResource SettingLabel}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AutostartUploadsOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding AutostartUploads}"
                              FontSize="12" Padding="4,3" />
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- 2: Connection Manager. Looks up its VM via the parent Window's MainViewModel
             since the SettingsView's DataContext is SettingsViewModel. -->
        <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
              DataContext="{Binding DataContext.ConnectionManagerViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.SelectedCategoryIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="2">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="20,16,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource ActionSpeedImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc Settings_Conn_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}"
                           Text="{loc:Loc Settings_Conn_Desc}" />
                <CheckBox Content="{loc:Loc Settings_Conn_UseProxies}"
                          IsChecked="{Binding ProxiesEnabled}"
                          ToolTip="{loc:Loc Settings_Conn_UseProxiesTip}"
                          Margin="0,8,0,0" />
                <CheckBox Content="{loc:Loc Settings_Conn_AutoDisable}"
                          IsChecked="{Binding AutoDisableFailingProxies}"
                          ToolTip="{loc:Loc Settings_Conn_AutoDisableTip}"
                          Margin="0,4,0,0" />
                <CheckBox Content="{loc:Loc Settings_Conn_AllowInvalidCert}"
                          IsChecked="{Binding AllowInvalidServerCertificates}"
                          ToolTip="{loc:Loc Settings_Conn_AllowInvalidCertTip}"
                          Margin="0,4,0,0" />
            </StackPanel>

            <!-- Opacity drop (NOT IsEnabled=false) when Use Proxies is off: makes the
                 inactive-feature state obvious at a glance while keeping the grid fully
                 interactive (edit/test/reorder still work) so the user can curate proxies
                 before flipping the master switch back on. -->
            <DataGrid x:Name="proxyGrid" Grid.Row="1" Margin="20,8,20,8"
                      ItemsSource="{Binding Proxies}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      RowHeaderWidth="0"
                      Tag="{Binding}"
                      beh:DataGridSelectionBehaviors.ClearSelectionOnEmptyClick="True"
                      beh:DataGridSelectionBehaviors.SelectRowOnRightClick="True"
                      ContextMenuOpening="ProxyGrid_ContextMenuOpening"
                      Background="{DynamicResource SurfaceBrush}"
                      RowBackground="{DynamicResource SurfaceBrush}"
                      AlternatingRowBackground="{DynamicResource DataGridAltRowBrush}"
                      HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                      VerticalGridLinesBrush="{DynamicResource BorderSubtleBrush}">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Opacity" Value="1.0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProxiesEnabled}" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=proxyGrid}" />
                </DataGrid.InputBindings>
                <!-- The Test/Remove items only make sense when the right-click landed on a
                     row; on empty space we collapse them and just show Add/Import/Export.
                     Visibility is flipped from code-behind in ProxyGrid_ContextMenuOpening. -->
                <DataGrid.ContextMenu>
                    <ContextMenu x:Name="ProxyGridContextMenu"
                                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem x:Name="ProxyContextTestItem"
                                  Header="{loc:Loc Settings_Conn_Context_Test}"
                                  Command="{Binding TestCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem x:Name="ProxyContextRemoveItem"
                                  Header="{loc:Loc Settings_Conn_Context_Remove}"
                                  InputGestureText="{loc:Loc Settings_Conn_Context_Remove_Gesture}"
                                  Command="{Binding RemoveSelectedCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator x:Name="ProxyContextRowSeparator" />
                        <MenuItem Header="{loc:Loc Settings_Conn_Btn_Add}"
                                  Command="{Binding AddCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import}">
                            <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import_FromText}"
                                      Command="{Binding ImportFromTextCommand}" />
                            <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import_FromFile}"
                                      Command="{Binding ImportFromFileCommand}" />
                        </MenuItem>
                        <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export}">
                            <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_AllToText}"
                                      Command="{Binding ExportAllToTextCommand}" />
                            <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_AllToFile}"
                                      Command="{Binding ExportAllToFileCommand}" />
                            <Separator />
                            <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_OkToText}"
                                      Command="{Binding ExportOkToTextCommand}" />
                            <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_OkToFile}"
                                      Command="{Binding ExportOkToFileCommand}" />
                            <Separator x:Name="ProxyContextExportSelectedSeparator" />
                            <MenuItem x:Name="ProxyContextExportSelectedToTextItem"
                                      Header="{loc:Loc Settings_Conn_Btn_Export_SelectedToText}"
                                      Command="{Binding ExportSelectedToTextCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem x:Name="ProxyContextExportSelectedToFileItem"
                                      Header="{loc:Loc Settings_Conn_Btn_Export_SelectedToFile}"
                                      Command="{Binding ExportSelectedToFileCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{loc:Loc Settings_Conn_Col_On}" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Settings_Conn_Col_Priority}" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Inline style strips the global Button padding (10,4) — at this
                                     size the up/down glyphs would otherwise be clipped, leaving the
                                     buttons looking like empty pills. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Resources>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Width" Value="28" />
                                            <Setter Property="Height" Value="22" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button Content="&#x25B2;" Margin="0,0,2,0"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{loc:Loc Settings_Conn_PriorityUpTip}" />
                                    <Button Content="&#x25BC;"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{loc:Loc Settings_Conn_PriorityDownTip}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Settings_Conn_Col_Type}" Width="100" SortMemberPath="Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{x:Static vm:ConnectionManagerViewModel.ProxyTypeOptions}"
                                          SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="0"
                                          Background="Transparent" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc Settings_Conn_Col_Host}"
                                        Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                        EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"
                                        Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="{loc:Loc Settings_Conn_Col_Port}"
                                        Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                        EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"
                                        Width="80" />
                    <DataGridTextColumn Header="{loc:Loc Settings_Conn_Col_User}"
                                        Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                        EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"
                                        Width="120" />
                    <DataGridTextColumn Header="{loc:Loc Settings_Conn_Col_Password}"
                                        Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                        EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"
                                        Width="120" />
                    <DataGridTemplateColumn Header="{loc:Loc Settings_Conn_Col_Test}" Width="60" SortMemberPath="TestOutcome" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding TestOutcome, Converter={StaticResource ProxyTestOutcomeIcon}}"
                                       Width="16" Height="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       ToolTip="{Binding TestStatus}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Settings_Conn_Col_Status}" Width="280" SortMemberPath="TestStatus" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TestStatus}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding TestStatus}" />
                                    <Button Grid.Column="1"
                                            Content="{loc:Loc Settings_Conn_Btn_Details}"
                                            FontSize="11"
                                            Padding="6,1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasTestDetails, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.ShowTestDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <DockPanel Grid.Row="2" Margin="20,0,20,16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ImportProxiesButton"
                            Style="{StaticResource JD2Button}"
                            Click="ImportProxiesButton_Click"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Settings_Conn_Btn_Import}" />
                            <TextBlock Text="&#x25BE;" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import_FromText}" Command="{Binding ImportFromTextCommand}" />
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import_FromFile}" Command="{Binding ImportFromFileCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- Tag carries the live grid SelectedItems through to the ContextMenu (the
                         menu lives in a separate visual tree and can't resolve ElementName
                         bindings) so "Export selected" can target the current selection. -->
                    <Button x:Name="ExportProxiesButton"
                            Style="{StaticResource JD2Button}"
                            Click="ExportProxiesButton_Click"
                            Tag="{Binding SelectedItems, ElementName=proxyGrid}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Settings_Conn_Btn_Export}" />
                            <TextBlock Text="&#x25BE;" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_AllToText}" Command="{Binding ExportAllToTextCommand}" />
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_AllToFile}" Command="{Binding ExportAllToFileCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_OkToText}" Command="{Binding ExportOkToTextCommand}" />
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_OkToFile}" Command="{Binding ExportOkToFileCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_SelectedToText}"
                                          Command="{Binding ExportSelectedToTextCommand}"
                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_SelectedToFile}"
                                          Command="{Binding ExportSelectedToFileCommand}"
                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource JD2Button}" Command="{Binding AddCommand}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="{loc:Loc Settings_Conn_Btn_Add}" />
                        </StackPanel>
                    </Button>
                    <!-- Click opens the ContextMenu (handled in code-behind) so the user
                         picks Selected or Failed; matches the JD2 UX of one button slot
                         with two related actions. -->
                    <!-- Tag holds the live SelectedItems so the ContextMenu (which lives
                         in its own visual tree and can't resolve ElementName=proxyGrid)
                         can route the selection through PlacementTarget.Tag. -->
                    <Button x:Name="RemoveProxiesButton"
                            Style="{StaticResource JD2Button}"
                            Click="RemoveProxiesButton_Click"
                            Tag="{Binding SelectedItems, ElementName=proxyGrid}"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="−" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="{loc:Loc Settings_Conn_Btn_Remove}" />
                            <TextBlock Text="&#x25BE;" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_RemoveSelected}"
                                          Command="{Binding RemoveSelectedCommand}"
                                          CommandParameter="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="{loc:Loc Settings_Conn_Btn_RemoveFailed}"
                                          Command="{Binding RemoveFailedCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Style="{StaticResource JD2Button}"
                            Command="{Binding TestAllCommand}"
                            ToolTip="{loc:Loc Settings_Conn_Btn_TestAllTip}"
                            Margin="0,0,6,0">
                        <TextBlock Text="{loc:Loc Settings_Conn_Btn_TestAll}" />
                    </Button>
                    <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- 3: Accounts (Grid layout so DataGrid fills height) -->
        <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="3">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,16,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource AccountImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{loc:Loc Settings_Accounts_Title}" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                           Text="{loc:Loc Settings_Accounts_Desc}" />
            </StackPanel>

            <!-- DataGrid fills all remaining space -->
            <DataGrid x:Name="accountsGrid" Grid.Row="1" Margin="20,0,20,0"
                      ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SelectedAccount}"
                      MouseDoubleClick="AccountsGrid_MouseDoubleClick"
                      beh:DataGridSelectionBehaviors.ClearSelectionOnEmptyClick="True"
                      beh:DataGridSelectionBehaviors.SelectRowOnRightClick="True"
                      ContextMenuOpening="AccountsGrid_ContextMenuOpening"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                      VerticalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      Background="{DynamicResource ContentBackgroundBrush}"
                      AlternatingRowBackground="{DynamicResource ContentAltBackgroundBrush}"
                      RowBackground="{DynamicResource ContentBackgroundBrush}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="FontSize" Value="12" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Disabled}" Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="&#x2713;" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding Disabled, Converter={StaticResource InvertBoolConverter}, UpdateSourceTrigger=PropertyChanged}"
                                          Click="AccountEnabledCheckBox_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Settings_Accounts_Col_Hoster}" Width="180"
                                            SortMemberPath="FileHosterName"
                                            ClipboardContentBinding="{Binding FileHosterName}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="{Binding FileHosterName, Converter={StaticResource HosterIconConverter}}"
                                           Width="18" Height="18" Margin="0,0,6,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding FileHosterName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{loc:Loc Settings_Accounts_Col_Status}" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StatusMessage}"
                                           Foreground="{Binding CheckStatus, Converter={StaticResource AccountCheckStatusToColor}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc Settings_Accounts_Col_Username}" Binding="{Binding Username}" Width="180" />
                    <DataGridTextColumn Header="{loc:Loc Settings_Accounts_Col_Password}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="Text" Value="******" /></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{loc:Loc Settings_Accounts_Col_Type}" Binding="{Binding AccountType}" Width="80" />
                    <!-- Storage usage columns. Used: formatted bytes (via ByteUnitConverter) when known,
                         "-" when we couldn't retrieve a usage figure. The dash comes from ConverterParameter
                         (NOT TargetNullValue): with a converter in the binding the null StorageUsedBytes
                         reaches ByteUnitConverter.Convert first, which honours the parameter as its "unknown"
                         display. Available: see the MultiConverter comment below. -->
                    <DataGridTextColumn Header="{loc:Loc Settings_Accounts_Col_Used}"
                                        Binding="{Binding StorageUsedBytes, Converter={StaticResource ByteUnit}, ConverterParameter='-'}"
                                        Width="90" IsReadOnly="True" />
                    <!-- Fixed width on Available (not Width="*") so the grid's total
                         column width can exceed the viewport and the horizontal
                         scrollbar actually has something to scroll over. The * setting
                         used to shrink Available to whatever space was left, which made
                         the cell unreadable on narrow windows without surfacing a scrollbar.
                         MultiBinding over the NOTIFYING source properties (StorageUsedBytes /
                         StorageQuotaBytes) + FileHosterName — NOT an empty-path {Binding} over the
                         whole row, which only re-evaluates when the item instance is replaced and so
                         showed stale data once refresh started updating the row in place. The converter
                         renders remaining bytes when the cap is known, "Unlimited" when the hoster
                         reports usage but no cap (Ex-Load) or is a known-unlimited hoster with no usage
                         figure (catbox), or "-" when we couldn't retrieve any storage info. -->
                    <DataGridTextColumn Header="{loc:Loc Settings_Accounts_Col_Available}"
                                        Width="110" IsReadOnly="True">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource StorageAvailableDisplayMulti}">
                                <Binding Path="StorageUsedBytes" />
                                <Binding Path="StorageQuotaBytes" />
                                <Binding Path="FileHosterName" />
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <!-- Wall-clock the account was added (set once at insert). Bound to
                         FileHosterLoginDto.CreatedDateTime; blank when null (rows predating the
                         column) via the shared DateTimeFormatConverter. -->
                    <DataGridTextColumn Header="{loc:Loc Settings_Accounts_Col_AddedAt}"
                                        Binding="{Binding CreatedDateTime, Converter={StaticResource DateTimeFormat}}"
                                        Width="140" IsReadOnly="True"
                                        FontFamily="Consolas, Segoe UI" />
                    <!-- Wall-clock of the last verifier round-trip (success OR failure).
                         Bound to FileHosterLoginDto.LastRefreshedDateTime; renders blank
                         when null via the shared DateTimeFormatConverter. Monospace font
                         keeps timestamps visually aligned column-wise. -->
                    <DataGridTextColumn Header="{loc:Loc Settings_Accounts_Col_RefreshedAt}"
                                        Binding="{Binding LastRefreshedDateTime, Converter={StaticResource DateTimeFormat}}"
                                        Width="140" IsReadOnly="True"
                                        FontFamily="Consolas, Segoe UI" />
                </DataGrid.Columns>

                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveSelectedAccountsCommand}"
                                CommandParameter="{Binding SelectedItems, ElementName=accountsGrid}" />
                </DataGrid.InputBindings>
                <!-- The row-targeted items only make sense when the right-click landed
                     on a row; on empty space we collapse them and just show Add.
                     Visibility is flipped from code-behind in AccountsGrid_ContextMenuOpening.
                     CommandParameter on the multi-aware items walks the visual tree from
                     the ContextMenu up to the DataGrid (PlacementTarget) and reads
                     SelectedItems live — same pattern as the proxy grid's bulk actions. -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="AccountsContextEditItem"
                                  Header="{loc:Loc Settings_Accounts_Context_Edit}" Command="{Binding EditAccountCommand}" />
                        <MenuItem x:Name="AccountsContextRefreshItem"
                                  Header="{loc:Loc Settings_Accounts_Context_Refresh}"
                                  Command="{Binding RefreshSelectedAccountsCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator x:Name="AccountsContextRowSeparator1" />
                        <MenuItem x:Name="AccountsContextEnableItem"
                                  Header="{loc:Loc Settings_Accounts_Context_Enable}"
                                  Command="{Binding EnableSelectedAccountsCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem x:Name="AccountsContextDisableItem"
                                  Header="{loc:Loc Settings_Accounts_Context_Disable}"
                                  Command="{Binding DisableSelectedAccountsCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator x:Name="AccountsContextRowSeparator2" />
                        <MenuItem x:Name="AccountsContextDeleteItem"
                                  Header="{loc:Loc Settings_Accounts_Context_Delete}"
                                  Command="{Binding RemoveSelectedAccountsCommand}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator x:Name="AccountsContextRowSeparator3" />
                        <MenuItem Header="{loc:Loc Settings_Accounts_Btn_Add}" Command="{Binding AddAccountDialogCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- JD2-style bottom button bar -->
            <Border Grid.Row="2" Margin="20,0,20,0" Padding="6,6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                    Background="{DynamicResource ButtonBarGradientBrush}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource JD2Button}" Command="{Binding AddAccountDialogCommand}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{loc:Loc Settings_Accounts_Btn_Add}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource JD2Button}"
                            Command="{Binding RemoveSelectedAccountsCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=accountsGrid}"
                            Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="-" FontWeight="Bold" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{loc:Loc Settings_Accounts_Btn_Remove}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource JD2Button}" Command="{Binding RefreshAllAccountsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource ActionRetryImage}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{loc:Loc Settings_Accounts_Btn_Refresh}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Status message -->
            <TextBlock Grid.Row="3" Text="{Binding CheckAccountStatus}" FontSize="11" Margin="20,6,20,8"
                       TextWrapping="Wrap" HorizontalAlignment="Left">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCheckingAccount}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource InfoAccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

    </Grid>
</UserControl>
