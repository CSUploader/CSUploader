<UserControl x:Class="CSUploader.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1024" d:DesignHeight="800"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6E6F5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B8D4EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#1B5E91" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#777" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="40,2,0,10" />
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="40,0,0,8" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingInput" TargetType="TextBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- JD2-style raised button with icon + text -->
        <Style x:Key="JD2Button" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="1" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="#A0A0A0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FCFCFC" Offset="0" />
                                    <GradientStop Color="#E8E8E8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6A9CC6" />
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#EAF4FC" Offset="0" />
                                            <GradientStop Color="#D0E4F4" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4A7CA6" />
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#D0E0F0" Offset="0" />
                                            <GradientStop Color="#B8D0E8" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Sidebar ═══ -->
        <Border Grid.Column="0" Background="#EAF3FB" BorderBrush="#B0B0B0" BorderThickness="0,0,1,0">
            <ListBox Background="Transparent" BorderThickness="0"
                     SelectedIndex="{Binding SelectedCategoryIndex}"
                     ItemContainerStyle="{StaticResource SidebarItem}"
                     SelectionMode="Single" Padding="0" Margin="0">
                <ListBoxItem IsSelected="True">
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource StatusOkImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="General" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#333" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource StatusUploadingImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Upload" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#333" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource FileHosterRapidgatorImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Accounts" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#333" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource LogoCsLogo54TransImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="About" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#333" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <Border Grid.Column="1" Background="#D8D8D8" />

        <!-- ═══ Content panels (switched by SelectedCategoryIndex) ═══ -->

        <!-- 0: General -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="White" Padding="0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="20,16,20,20" MaxWidth="900">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource PackageOpenImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Temp Archive Directory" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}" Text="Set the temporary archive directory. Compressed archives are stored here before uploading." />
                <Grid Margin="40,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TempArchiveDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingInput}" />
                    <Button Grid.Column="1" Content="Browse" Width="75" Margin="8,0,0,0" Command="{Binding BrowseTempDirectoryCommand}" />
                </Grid>

                <Separator Margin="0,20,0,12" />
                <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        Width="130" Height="32" HorizontalAlignment="Left" Margin="40,0,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- 1: Upload -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="White" Padding="0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="20,16,20,20" MaxWidth="900">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource StatusRunningImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Upload Management" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}" Text="Connection limits, priorities, ...set up the Upload controller details." />

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Max. simultaneous Uploads" Style="{StaticResource SettingLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding MaxConcurrentUploadJobs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingInput}" HorizontalContentAlignment="Right" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Max. simultaneous CPU Jobs" Style="{StaticResource SettingLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding MaxConcurrentCPUJobs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingInput}" HorizontalContentAlignment="Right" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="252" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Speed Limit (KB/s)" Style="{StaticResource SettingLabel}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding SpeedLimitEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="2" Text="{Binding SpeedLimitValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingInput}" IsEnabled="{Binding SpeedLimitEnabled}" HorizontalContentAlignment="Right" />
                </Grid>

                <Separator Margin="0,16,0,12" />
                <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        Width="130" Height="32" HorizontalAlignment="Left" Margin="40,0,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- 2: Accounts (Grid layout so DataGrid fills height) -->
        <Grid Grid.Column="2" Background="White">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="2">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,16,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource FileHosterRapidgatorImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Account Manager" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock FontSize="11.5" Foreground="#777" Margin="0,0,0,8"
                           Text="Enter and manage all your Premium/Gold/Platinum accounts." />
            </StackPanel>

            <!-- DataGrid fills all remaining space -->
            <DataGrid Grid.Row="1" Margin="20,0,20,0"
                      ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SelectedAccount}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#D4D4D4"
                      VerticalGridLinesBrush="#D4D4D4"
                      BorderBrush="#B0B0B0"
                      BorderThickness="1"
                      Background="#EAF3FB"
                      AlternatingRowBackground="#E2EDF7"
                      RowBackground="#EAF3FB">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E8E8E8" />
                        <Setter Property="Foreground" Value="#333" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderBrush" Value="#B0B0B0" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="FontSize" Value="12" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#B8D4EE" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Disabled}" Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#B8D4EE" />
                                <Setter Property="Foreground" Value="#222" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="✓" Width="30" Binding="{Binding Disabled, Converter={x:Null}}" IsReadOnly="True">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox">
                                <Setter Property="IsChecked" Value="True" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Disabled}" Value="True">
                                        <Setter Property="IsChecked" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="Hoster" Binding="{Binding FileHosterName}" Width="180" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusMessage}" Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Foreground" Value="#666" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="180" />
                    <DataGridTextColumn Header="Password" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="Text" Value="******" /></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="*" />
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit Account..." Command="{Binding EditAccountCommand}" />
                        <MenuItem Header="Check / Refresh" Command="{Binding RefreshAccountCommand}" />
                        <Separator />
                        <MenuItem Header="Enable" Command="{Binding ToggleAccountCommand}" CommandParameter="Enable" />
                        <MenuItem Header="Disable" Command="{Binding ToggleAccountCommand}" CommandParameter="Disable" />
                        <Separator />
                        <MenuItem Header="Delete" Command="{Binding RemoveAccountCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- JD2-style bottom button bar -->
            <Border Grid.Row="2" Margin="20,0,20,0" Padding="6,6"
                    BorderBrush="#B0B0B0" BorderThickness="1,0,1,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F4F4F4" Offset="0" />
                        <GradientStop Color="#E0E0E0" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource JD2Button}" Command="{Binding AddAccountDialogCommand}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontWeight="Bold" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Add" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource JD2Button}" Command="{Binding RemoveAccountCommand}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="－" FontWeight="Bold" Foreground="#999" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Remove" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource JD2Button}" Command="{Binding RefreshAllAccountsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource ActionRetryImage}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Status message -->
            <TextBlock Grid.Row="3" Text="{Binding CheckAccountStatus}" FontSize="11" Margin="20,6,20,8"
                       TextWrapping="Wrap" HorizontalAlignment="Left">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#555" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCheckingAccount}" Value="True">
                                <Setter Property="Foreground" Value="#3498DB" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 3: About -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="White" Padding="0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="3">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="20,16,20,20" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource LogoCsLogo54TransImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="About CSUploader" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,12" />

                <StackPanel Margin="40,0,0,0">
                    <Image Source="{StaticResource Logo128Image}" Width="96" Height="96" HorizontalAlignment="Left" Margin="0,0,0,16"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1B5E91" Text="CSUploader" Margin="0,0,0,4" />
                    <TextBlock FontSize="12" Foreground="#555" Margin="0,0,0,12">
                        <Run Text="Version 1.0.0" />
                    </TextBlock>

                    <TextBlock FontSize="12" Foreground="#444" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20">
                        A powerful file upload manager for multiple hosting services.
                        Features include file compression, hashing, queue management,
                        and real-time progress tracking.
                    </TextBlock>

                    <TextBlock FontSize="12" Foreground="#777" Margin="0,0,0,4">
                        <Run FontWeight="SemiBold" Foreground="#555" Text="Framework: " />
                        <Run Text=".NET 10.0 (WPF)" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#777" Margin="0,0,0,4">
                        <Run FontWeight="SemiBold" Foreground="#555" Text="Database: " />
                        <Run Text="SQLite via EF Core 10" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#777" Margin="0,0,0,4">
                        <Run FontWeight="SemiBold" Foreground="#555" Text="License: " />
                        <Run Text="MIT" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#777" Margin="0,0,0,16">
                        <Run FontWeight="SemiBold" Foreground="#555" Text="Source: " />
                        <Run Text="github.com/NeWbY100/CSUploader" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
