<UserControl x:Class="CSUploader.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             d:DesignWidth="1024" d:DesignHeight="800"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
        <conv:StatusToColorConverter x:Key="StatusToColorConverter" />

        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="40,2,0,10" />
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="40,0,0,8" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SettingInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- JD2-style raised button with icon + text -->
        <Style x:Key="JD2Button" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="1" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{DynamicResource JD2ButtonBorderBrush}"
                                Background="{DynamicResource JD2ButtonBgBrush}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource JD2ButtonHoverBorderBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JD2ButtonHoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource JD2ButtonPressedBorderBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource JD2ButtonPressedBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox Background="Transparent" BorderThickness="0"
                     SelectedIndex="{Binding SelectedCategoryIndex}"
                     ItemContainerStyle="{StaticResource SidebarItem}"
                     SelectionMode="Single" Padding="0" Margin="0">
                <ListBoxItem IsSelected="True">
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource StatusOkImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="General" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource StatusUploadingImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Upload" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource FileHosterRapidgatorImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Accounts" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel HorizontalAlignment="Center" Width="120">
                        <Image Source="{StaticResource LogoCsLogo54TransImage}" Width="32" Height="32" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="About" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource SidebarSeparatorBrush}" />

        <!-- Content panels (switched by SelectedCategoryIndex) -->

        <!-- 0: General -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}" Padding="0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="20,16,20,20" MaxWidth="900">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource StatusOkImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Developer" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}" Text="Options for local development and testing." />

                <Grid Style="{StaticResource SettingRow}">
                    <CheckBox Content="Use mock server (redirect all file hoster requests to localhost:8080/&lt;hoster&gt;)"
                              IsChecked="{Binding UseMockServer}" VerticalAlignment="Center" />
                </Grid>

                <!-- Confirmation prompts -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
                    <Image Source="{StaticResource StatusRunningImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Confirmation Prompts" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}"
                           Text="Tick a prompt to have it ask again before the action. Untick to suppress the confirmation for that action." />

                <ItemsControl ItemsSource="{Binding ConfirmationPrompts}" Margin="40,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding AskAgain}"
                                      Content="{Binding Label}"
                                      Margin="0,2,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,20,0,12" />
                <StackPanel Orientation="Horizontal" Margin="40,0,0,0">
                    <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            Width="130" Height="32" />
                    <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 1: Upload -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}" Padding="0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="20,16,20,20" MaxWidth="900">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource StatusRunningImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Upload Management" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource SectionDesc}" Text="Connection limits, priorities, ...set up the Upload controller details." />

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Max. simultaneous Uploads" Style="{StaticResource SettingLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding MaxConcurrentUploadJobs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingInput}" HorizontalContentAlignment="Right" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="252" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Max. simultaneous uploads per file hoster" Style="{StaticResource SettingLabel}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding MaxUploadsPerHostEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="2" Text="{Binding MaxUploadsPerHost, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingInput}" IsEnabled="{Binding MaxUploadsPerHostEnabled}" HorizontalContentAlignment="Right" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Remove finished uploads" Style="{StaticResource SettingLabel}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding RemoveFinishedUploadsOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding RemoveFinishedUploads}"
                              FontSize="12" Padding="4,3" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Auto-remove completed files" Style="{StaticResource SettingLabel}"
                               ToolTip="Remove individual files from the Uploads tab as soon as they finish uploading successfully. History on the Uploaded tab is preserved." />
                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoRemoveCompletedFiles}" VerticalAlignment="Center" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Auto-remove completed packages" Style="{StaticResource SettingLabel}"
                               ToolTip="Remove the whole package from the Uploads tab once every file in it has finished successfully. History on the Uploaded tab is preserved." />
                    <CheckBox Grid.Column="1" IsChecked="{Binding AutoRemoveCompletedPackages}" VerticalAlignment="Center" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="If the file already exists" Style="{StaticResource SettingLabel}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding IfFileExistsOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding IfFileExists}"
                              FontSize="12" Padding="4,3" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Max. simultaneous CPU Jobs" Style="{StaticResource SettingLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding MaxConcurrentCPUJobs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingInput}" HorizontalContentAlignment="Right" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="252" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Speed Limit (KB/s)" Style="{StaticResource SettingLabel}" />
                    <CheckBox Grid.Column="1" IsChecked="{Binding SpeedLimitEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="2" Text="{Binding SpeedLimitValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingInput}" IsEnabled="{Binding SpeedLimitEnabled}" HorizontalContentAlignment="Right" />
                </Grid>

                <Separator Margin="0,16,0,12" />
                <StackPanel Orientation="Horizontal" Margin="40,0,0,0">
                    <Button Content="Save Settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            Width="130" Height="32" />
                    <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 2: Accounts (Grid layout so DataGrid fills height) -->
        <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="2">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,16,20,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource FileHosterRapidgatorImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Account Manager" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,4" />
                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                           Text="Enter and manage all your Premium/Gold/Platinum accounts." />
            </StackPanel>

            <!-- DataGrid fills all remaining space -->
            <DataGrid Grid.Row="1" Margin="20,0,20,0"
                      ItemsSource="{Binding Accounts}"
                      SelectedItem="{Binding SelectedAccount}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                      VerticalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      Background="{DynamicResource ContentBackgroundBrush}"
                      AlternatingRowBackground="{DynamicResource ContentAltBackgroundBrush}"
                      RowBackground="{DynamicResource ContentBackgroundBrush}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="FontSize" Value="12" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Disabled}" Value="True">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="&#x2713;" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding Disabled, Converter={StaticResource InvertBoolConverter}, UpdateSourceTrigger=PropertyChanged}"
                                          Click="AccountEnabledCheckBox_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Hoster" Binding="{Binding FileHosterName}" Width="180" />
                    <DataGridTemplateColumn Header="Status" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StatusMessage}"
                                           Foreground="{Binding StatusMessage, Converter={StaticResource StatusToColorConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="180" />
                    <DataGridTextColumn Header="Password" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="Text" Value="******" /></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="*" />
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit Account..." Command="{Binding EditAccountCommand}" />
                        <MenuItem Header="Check / Refresh" Command="{Binding RefreshAccountCommand}" />
                        <Separator />
                        <MenuItem Header="Enable" Command="{Binding ToggleAccountCommand}" CommandParameter="Enable" />
                        <MenuItem Header="Disable" Command="{Binding ToggleAccountCommand}" CommandParameter="Disable" />
                        <Separator />
                        <MenuItem Header="Delete" Command="{Binding RemoveAccountCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <!-- JD2-style bottom button bar -->
            <Border Grid.Row="2" Margin="20,0,20,0" Padding="6,6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                    Background="{DynamicResource ButtonBarGradientBrush}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource JD2Button}" Command="{Binding AddAccountDialogCommand}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Add" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource JD2Button}" Command="{Binding RemoveAccountCommand}" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="-" FontWeight="Bold" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Remove" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource JD2Button}" Command="{Binding RefreshAllAccountsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource ActionRetryImage}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Status message -->
            <TextBlock Grid.Row="3" Text="{Binding CheckAccountStatus}" FontSize="11" Margin="20,6,20,8"
                       TextWrapping="Wrap" HorizontalAlignment="Left">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCheckingAccount}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource InfoAccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 3: About -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}" Padding="0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="3">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="20,16,20,20" MaxWidth="900" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Image Source="{StaticResource LogoCsLogo54TransImage}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="About CSUploader" Style="{StaticResource SectionTitle}" />
                </StackPanel>
                <Separator Margin="0,0,0,12" />

                <StackPanel Margin="40,0,0,0">
                    <Image Source="{StaticResource Logo128Image}" Width="96" Height="96" HorizontalAlignment="Left" Margin="0,0,0,16"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="CSUploader" Margin="0,0,0,4" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12">
                        <Run Text="Version 1.0.0" />
                    </TextBlock>

                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="20">
                        A powerful file upload manager for multiple hosting services.
                        Features include hashing, queue management,
                        and real-time progress tracking.
                    </TextBlock>

                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Framework: " />
                        <Run Text=".NET 10.0 (WPF)" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Database: " />
                        <Run Text="SQLite via EF Core 10" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="License: " />
                        <Run Text="MIT" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="Source: " />
                        <Run Text="github.com/NeWbY100/CSUploader" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
