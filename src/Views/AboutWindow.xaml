<Window x:Class="CSUploader.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        Title="{loc:Loc About_WindowTitle}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico">

  <Grid Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Logo + Title + Version -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
      <Image Source="{StaticResource Logo128Image}" Width="80" Height="80"
             RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   Text="{loc:Loc About_AppName}" />
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   x:Name="VersionText" Margin="0,2,0,0" />
      </StackPanel>
    </StackPanel>

    <!-- Description -->
    <TextBlock Grid.Row="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
               TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"
               Text="{loc:Loc About_Description}" />

    <!-- Framework / Database / License / Source. Plain side-by-side TextBlocks (not
         inline Runs) — Hyperlink/Run paths can fail with "Run is not a Visual or
         Visual3D" on Win11. -->
    <StackPanel Grid.Row="2" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   FontWeight="SemiBold" Text="{loc:Loc About_Field_Framework}" />
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="4,0,0,0" Text="{loc:Loc About_Field_Framework_Value}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   FontWeight="SemiBold" Text="{loc:Loc About_Field_Database}" />
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="4,0,0,0" Text="{loc:Loc About_Field_Database_Value}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   FontWeight="SemiBold" Text="{loc:Loc About_Field_License}" />
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="4,0,0,0" Text="{loc:Loc About_Field_License_Value}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   FontWeight="SemiBold" Text="{loc:Loc About_Field_Source}" />
        <TextBlock FontSize="12"
                   Margin="4,0,0,0"
                   Text="github.com/CSUploader/CSUploader"
                   Foreground="{DynamicResource AccentBrush}"
                   Cursor="Hand"
                   TextDecorations="Underline"
                   Tag="https://github.com/CSUploader/CSUploader"
                   MouseLeftButtonUp="GithubLink_MouseLeftButtonUp" />
      </StackPanel>
    </StackPanel>

    <!-- OK Button -->
    <Button Grid.Row="3" Content="{loc:Loc About_OK}" Width="80" Height="28"
            HorizontalAlignment="Right" IsCancel="True" IsDefault="True" />
  </Grid>
</Window>
