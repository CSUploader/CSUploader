<Window x:Class="CSUploader.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About CSUploader"
        Width="400" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico">

  <Grid Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Logo + Title -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
      <Image Source="{StaticResource Logo128Image}" Width="64" Height="64"
             RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   Text="{Binding Title}" />
        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding Version}" Margin="0,2,0,0" />
      </StackPanel>
    </StackPanel>

    <!-- Description -->
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                 TextWrapping="Wrap" LineHeight="20"
                 Text="A file upload manager for multiple hosting services." Margin="0,0,0,10" />
      <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
        <Run Text="Built with .NET 10 and WPF." />
      </TextBlock>
      <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
        <Run Text="License: MIT" />
      </TextBlock>
    </StackPanel>

    <!-- OK Button -->
    <Button Grid.Row="2" Content="OK" Width="80" Height="28"
            HorizontalAlignment="Right" IsCancel="True" IsDefault="True" />
  </Grid>
</Window>
