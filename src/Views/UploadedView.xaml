<UserControl x:Class="CSUploader.Views.UploadedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UploadedViewModel}"
             d:DesignWidth="1600" d:DesignHeight="1100"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <conv:ByteUnitConverter x:Key="ByteUnitConverter" />
        <conv:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
        <conv:HosterIconConverter x:Key="HosterIconConverter" />
        <conv:FileTypeIconConverter x:Key="FileTypeIconConverter" />

        <!-- Group rows by PackageName — enables collapsible package headers -->
        <CollectionViewSource x:Key="FilesView" Source="{Binding Files}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="PackageName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="FirstCellStyle" TargetType="TextBlock">
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="UrlLinkStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
                <DataTrigger Binding="{Binding FileUrl}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding FileUrl}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Loc Uploaded_Toolbar_ExportJson}"
                        Command="{Binding ExportJsonCommand}"
                        Padding="10,4"
                        ToolTip="{loc:Loc Uploaded_Toolbar_ExportJsonTip}" />
            </StackPanel>
        </Border>

    <DataGrid Grid.Row="1"
              x:Name="FilesGrid"
              Loaded="FilesGrid_Loaded"
              PreviewMouseRightButtonDown="FilesGrid_PreviewMouseRightButtonDown"
              ContextMenuOpening="FilesGrid_ContextMenuOpening"
              ItemsSource="{Binding Source={StaticResource FilesView}}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              CanUserSortColumns="True"
              IsReadOnly="True"
              SelectionUnit="FullRow"
              SelectedItem="{Binding SelectedRow, Mode=OneWayToSource}"
              ClipboardCopyMode="IncludeHeader"
              HeadersVisibility="Column"
              GridLinesVisibility="All"
              RowHeaderWidth="0"
              BorderThickness="0"
              Background="{DynamicResource SurfaceBrush}"
              RowBackground="{DynamicResource SurfaceBrush}"
              AlternatingRowBackground="{DynamicResource DataGridAltRowBrush}"
              HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
              VerticalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
        <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource GridFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource GridFontSize}" />
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="FontFamily" Value="{DynamicResource GridFontFamily}" />
                <Setter Property="FontSize" Value="{DynamicResource GridFontSize}" />
                <Setter Property="MinHeight" Value="20" />
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.CellStyle>
            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </DataGrid.CellStyle>
        <DataGrid.ContextMenu>
            <ContextMenu>
                <!-- Copy submenu: existing row-copy (Ctrl+C built-in) sits at the top,
                     followed by one entry per column. Column-key strings match the resx
                     Uploaded_Col_* suffix so the VM can map them via reflection. -->
                <MenuItem Header="{loc:Loc Common_Context_Copy}">
                    <MenuItem Header="{loc:Loc Uploaded_Context_Copy}"
                              InputGestureText="{loc:Loc Uploaded_Context_Copy_Gesture}"
                              Command="ApplicationCommands.Copy"
                              CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="{loc:Loc Uploaded_Col_Name}"
                              Command="{Binding PlacementTarget.DataContext.CopyColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="Name" />
                    <MenuItem Header="{loc:Loc Uploaded_Col_Path}"
                              Command="{Binding PlacementTarget.DataContext.CopyColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="Path" />
                    <MenuItem Header="{loc:Loc Uploaded_Col_Size}"
                              Command="{Binding PlacementTarget.DataContext.CopyColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="Size" />
                    <MenuItem Header="{loc:Loc Uploaded_Col_Hoster}"
                              Command="{Binding PlacementTarget.DataContext.CopyColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="Hoster" />
                    <MenuItem Header="{loc:Loc Uploaded_Col_Finished}"
                              Command="{Binding PlacementTarget.DataContext.CopyColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="Finished" />
                    <MenuItem Header="{loc:Loc Uploaded_Col_Hash}"
                              Command="{Binding PlacementTarget.DataContext.CopyColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="Hash" />
                    <MenuItem Header="{loc:Loc Uploaded_Col_URL}"
                              Command="{Binding PlacementTarget.DataContext.CopyColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="URL" />
                </MenuItem>
                <MenuItem Header="{loc:Loc Common_Context_OpenUrl}"
                          Command="{Binding PlacementTarget.DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="{loc:Loc Uploaded_Context_Remove}"
                          InputGestureText="{loc:Loc Uploaded_Context_Remove_Gesture}"
                          Command="{Binding PlacementTarget.DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                <Separator />
                <MenuItem Header="{loc:Loc Uploaded_Context_ExportJson}"
                          Command="{Binding PlacementTarget.DataContext.ExportJsonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.InputBindings>
            <KeyBinding Key="Delete"
                        Command="{Binding RemoveSelectedCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=FilesGrid}" />
        </DataGrid.InputBindings>

        <!-- Collapsible package group header. A flat ToggleButton + ItemsPresenter keeps the
             file rows flush with the column headers (an Expander's default chrome indents them). -->
        <DataGrid.GroupStyle>
            <GroupStyle>
                <GroupStyle.ContainerStyle>
                    <Style TargetType="GroupItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GroupItem">
                                    <StackPanel>
                                        <ToggleButton x:Name="GroupToggle" IsChecked="True" Focusable="False">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <!-- Compact package row to match the Uploads tab: same row height,
                                                         no separate background or bottom border. -->
                                                    <Border Background="Transparent"
                                                            MinHeight="20"
                                                            Padding="12,0"
                                                            Cursor="Hand">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock x:Name="Chevron"
                                                                       Text="−"
                                                                       FontFamily="{DynamicResource GridFontFamily}"
                                                                       FontSize="14"
                                                                       FontWeight="Bold"
                                                                       Width="14"
                                                                       Margin="0,0,6,0"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontFamily="{DynamicResource GridFontFamily}"
                                                                       FontSize="{DynamicResource GridFontSize}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Margin="8,0,0,0"
                                                                       FontFamily="{DynamicResource GridFontFamily}"
                                                                       FontSize="{DynamicResource GridFontSize}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Text="{Binding ItemCount, StringFormat='[{0}]', Mode=OneWay}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Chevron" Property="Text" Value="+" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ItemsPresenter x:Name="GroupItems" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                            <Setter TargetName="GroupItems" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </GroupStyle.ContainerStyle>
            </GroupStyle>
        </DataGrid.GroupStyle>

        <DataGrid.Columns>
            <DataGridTemplateColumn Header="{loc:Loc Uploaded_Col_Name}"
                                    Width="400"
                                    MinWidth="120"
                                    SortMemberPath="FileName"
                                    ClipboardContentBinding="{Binding FileName}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Indent matches the chevron-column width on the Uploads tab so the
                                 file icons sit just under (and slightly right of) the package name. -->
                            <svgc:SvgViewbox Source="{Binding FileName, Converter={StaticResource FileTypeIconConverter}}"
                                             Width="16" Height="16"
                                             Margin="28,0,6,0" />
                            <TextBlock Text="{Binding FileName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{loc:Loc Uploaded_Col_Path}"
                                Binding="{Binding FileDirectory}"
                                ClipboardContentBinding="{Binding FileDirectory}"
                                Width="300"
                                MinWidth="100">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding FileDirectory}" />
                    </Style>
                </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="{loc:Loc Uploaded_Col_Size}"
                                Binding="{Binding FileSize, Converter={StaticResource ByteUnitConverter}}"
                                ClipboardContentBinding="{Binding FileSize, Converter={StaticResource ByteUnitConverter}}"
                                Width="100"
                                MinWidth="60">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                    </Style>
                </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTemplateColumn Header="{loc:Loc Uploaded_Col_Hoster}"
                                    Width="120"
                                    MinWidth="70"
                                    SortMemberPath="FileHosterName"
                                    ClipboardContentBinding="{Binding FileHosterName}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{Binding FileHosterName, Converter={StaticResource HosterIconConverter}}"
                                   Width="18" Height="18" Margin="0,0,6,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding FileHosterName}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{loc:Loc Uploaded_Col_Finished}"
                                Binding="{Binding FinishedDateTime, Converter={StaticResource DateTimeFormatConverter}}"
                                ClipboardContentBinding="{Binding FinishedDateTime, Converter={StaticResource DateTimeFormatConverter}}"
                                Width="160"
                                MinWidth="100">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
                    </Style>
                </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="{loc:Loc Uploaded_Col_Hash}"
                                Binding="{Binding FileHash}"
                                ClipboardContentBinding="{Binding FileHash}"
                                Width="280"
                                MinWidth="100">
                <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding FileHash}" />
                    </Style>
                </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTemplateColumn Header="{loc:Loc Uploaded_Col_URL}" Width="500" MinWidth="200"
                                    ClipboardContentBinding="{Binding FileUrl}">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding FileUrl}"
                                   ToolTip="{Binding FileUrl}"
                                   Style="{StaticResource UrlLinkStyle}"
                                   MouseLeftButtonUp="UrlText_MouseLeftButtonUp" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
    </Grid>
</UserControl>
