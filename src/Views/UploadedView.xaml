<UserControl x:Class="CSUploader.Views.UploadedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UploadedViewModel}"
             d:DesignWidth="1600" d:DesignHeight="1100"
             Background="{DynamicResource LogBackgroundBrush}">

    <UserControl.Resources>
        <conv:ByteUnitConverter x:Key="ByteUnitConverter" />
        <conv:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
    </UserControl.Resources>

    <Grid>
        <TreeView ItemsSource="{Binding Packages}" Margin="4"
                  BorderBrush="{DynamicResource DataGridGridLineBrush}" BorderThickness="1">

            <!-- UploadPackageDto (Parent) Template -->
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Files}">
                    <Grid Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Package Name -->
                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="4,0" FontWeight="SemiBold" />

                        <!-- File Count -->
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                            <TextBlock.Text>
                                <Binding Path="Files.Count" StringFormat="{}{0} file(s)" />
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>

                    <!-- UploadPackageFileDto (Child) Template -->
                    <HierarchicalDataTemplate.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="24" Background="{DynamicResource LogAltRowBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- File Name -->
                                <TextBlock Grid.Column="0" Text="{Binding FileName}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="4,0" />

                                <!-- File Size -->
                                <TextBlock Grid.Column="1" Text="{Binding FileSize, Converter={StaticResource ByteUnitConverter}}"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <!-- File Hoster -->
                                <TextBlock Grid.Column="2" Text="{Binding FileHosterName}" VerticalAlignment="Center" Margin="4,0" />

                                <!-- Start Date -->
                                <TextBlock Grid.Column="3" Text="{Binding StartDateTime, Converter={StaticResource DateTimeFormatConverter}}"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <!-- Finished Date -->
                                <TextBlock Grid.Column="4" Text="{Binding FinishedDateTime, Converter={StaticResource DateTimeFormatConverter}}"
                                           VerticalAlignment="Center" Margin="4,0" />

                                <!-- File URL -->
                                <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="4,0">
                                    <Hyperlink NavigateUri="{Binding FileUrl}">
                                        <TextBlock Text="{Binding FileUrl}" TextTrimming="CharacterEllipsis" />
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </HierarchicalDataTemplate.ItemTemplate>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
