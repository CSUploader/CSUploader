<UserControl x:Class="CSUploader.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:behaviors="clr-namespace:CSUploader.Behaviors"
             xmlns:vm="clr-namespace:CSUploader.ViewModels"
             xmlns:upload="clr-namespace:CSUploader.Upload"
             xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LogsViewModel}"
             d:DesignWidth="1600" d:DesignHeight="1100"
             Background="{DynamicResource LogBackgroundBrush}">

    <UserControl.Resources>
        <conv:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
        <conv:UrlDecodeConverter x:Key="UrlDecodeConverter" />

        <!-- Single-line message rendering: collapse newlines, ellipsis on overflow,
             full text available via tooltip + double-click for the details dialog. -->
        <Style x:Key="LogMessageStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding Message}" />
        </Style>

        <!-- URL column rendering (HTTP tab): same single-line ellipsis treatment as the
             message column, but the tooltip shows the url-decoded URL for readability. -->
        <Style x:Key="LogUrlStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding HttpTransaction.Url, Converter={StaticResource UrlDecodeConverter}}" />
        </Style>
        <Style x:Key="LogRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="MaxHeight" Value="22" />
        </Style>

        <!-- Shared DataGrid style for log tabs -->
        <Style x:Key="LogDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DataGridGridLineBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource LogBackgroundBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource LogBackgroundBrush}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource LogAltRowBrush}" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLineBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderBrush" Value="{DynamicResource DataGridGridLineBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Auto-Scroll Checkbox -->
        <CheckBox Grid.Row="0" Content="{loc:Loc Logs_AutoScroll}" IsChecked="{Binding AutoScroll}" Margin="4,4,4,8" />

        <!-- Log Tabs -->
        <TabControl Grid.Row="1">

            <!-- Status Tab -->
            <TabItem Header="{loc:Loc Logs_Tab_Status}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" HorizontalAlignment="Right" Margin="4,4,4,4"
                            Width="80" Height="24"
                            Content="{loc:Loc Logs_BtnClear}"
                            Command="{Binding ClearStatusLogsCommand}"
                            Style="{StaticResource JD2Button}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding StatusLogs}" Style="{StaticResource LogDataGridStyle}"
                              x:Name="StatusLogGrid"
                              Tag="{x:Static upload:SettingKey.LogsStatusTabHiddenColumns}"
                              Loaded="LogGrid_Loaded"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              behaviors:AutoScrollBehavior.IsEnabled="{Binding AutoScroll}"
                              RowStyle="{StaticResource LogRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_DateTime}" Binding="{Binding DateTime, Converter={StaticResource DateTimeFormatConverter}}" Width="160" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Filename}" Binding="{Binding Filename}" Width="180" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Function}" Binding="{Binding Function}" Width="160" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Line}" Binding="{Binding LineNumber}" Width="60" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Message}" Binding="{Binding Message}" Width="600" MinWidth="120"
                                                ElementStyle="{StaticResource LogMessageStyle}" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Thread}" Binding="{Binding ThreadId}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- HTTP Tab -->
            <TabItem Header="{loc:Loc Logs_Tab_Http}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" HorizontalAlignment="Right" Margin="4,4,4,4"
                            Width="80" Height="24"
                            Content="{loc:Loc Logs_BtnClear}"
                            Command="{Binding ClearHttpLogsCommand}"
                            Style="{StaticResource JD2Button}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding HttpLogs}" Style="{StaticResource LogDataGridStyle}"
                              x:Name="HttpLogGrid"
                              Tag="{x:Static upload:SettingKey.LogsHttpTabHiddenColumns}"
                              Loaded="LogGrid_Loaded"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              behaviors:AutoScrollBehavior.IsEnabled="{Binding AutoScroll}"
                              RowStyle="{StaticResource LogRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_DateTime}" Binding="{Binding DateTime, Converter={StaticResource DateTimeFormatConverter}}" Width="160" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Status}" Binding="{Binding StatusCode}" Width="60" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Url}"
                                                Binding="{Binding HttpTransaction.Url, Converter={StaticResource UrlDecodeConverter}}"
                                                Width="320" ElementStyle="{StaticResource LogUrlStyle}" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Filename}" Binding="{Binding Filename}" Width="180" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Function}" Binding="{Binding Function}" Width="160" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Line}" Binding="{Binding LineNumber}" Width="60" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Message}" Binding="{Binding Message}" Width="600" MinWidth="120"
                                                ElementStyle="{StaticResource LogMessageStyle}" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Thread}" Binding="{Binding ThreadId}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Errors Tab -->
            <TabItem Header="{loc:Loc Logs_Tab_Errors}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" HorizontalAlignment="Right" Margin="4,4,4,4"
                            Width="80" Height="24"
                            Content="{loc:Loc Logs_BtnClear}"
                            Command="{Binding ClearErrorLogsCommand}"
                            Style="{StaticResource JD2Button}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ErrorLogs}" Style="{StaticResource LogDataGridStyle}"
                              x:Name="ErrorLogGrid"
                              Tag="{x:Static upload:SettingKey.LogsErrorsTabHiddenColumns}"
                              Loaded="LogGrid_Loaded"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              behaviors:AutoScrollBehavior.IsEnabled="{Binding AutoScroll}"
                              RowStyle="{StaticResource LogRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_DateTime}" Binding="{Binding DateTime, Converter={StaticResource DateTimeFormatConverter}}" Width="160" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Filename}" Binding="{Binding Filename}" Width="180" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Function}" Binding="{Binding Function}" Width="160" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Line}" Binding="{Binding LineNumber}" Width="60" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Message}" Binding="{Binding Message}" Width="600" MinWidth="120"
                                                ElementStyle="{StaticResource LogMessageStyle}" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Thread}" Binding="{Binding ThreadId}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- UI Tab -->
            <TabItem Header="{loc:Loc Logs_Tab_UI}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" HorizontalAlignment="Right" Margin="4,4,4,4"
                            Width="80" Height="24"
                            Content="{loc:Loc Logs_BtnClear}"
                            Command="{Binding ClearUILogsCommand}"
                            Style="{StaticResource JD2Button}" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding UILogs}" Style="{StaticResource LogDataGridStyle}"
                              x:Name="UILogGrid"
                              Tag="{x:Static upload:SettingKey.LogsUITabHiddenColumns}"
                              Loaded="LogGrid_Loaded"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              behaviors:AutoScrollBehavior.IsEnabled="{Binding AutoScroll}"
                              RowStyle="{StaticResource LogRowStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_DateTime}" Binding="{Binding DateTime, Converter={StaticResource DateTimeFormatConverter}}" Width="160" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Filename}" Binding="{Binding Filename}" Width="180" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Function}" Binding="{Binding Function}" Width="160" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Line}" Binding="{Binding LineNumber}" Width="60" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Message}" Binding="{Binding Message}" Width="600" MinWidth="120"
                                                ElementStyle="{StaticResource LogMessageStyle}" />
                            <DataGridTextColumn Header="{loc:Loc Logs_Col_Thread}" Binding="{Binding ThreadId}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
