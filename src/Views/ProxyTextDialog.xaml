<Window x:Class="CSUploader.Views.ProxyTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        Title="{loc:Loc ProxyText_WindowTitle}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="DescriptionText"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,8" />

        <TextBox Grid.Row="1"
                 x:Name="BodyBox"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="{DynamicResource ContentBackgroundBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 Padding="6" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CopyButton" Content="{loc:Loc ProxyText_BtnCopy}" Width="80" Margin="0,0,8,0" Click="Copy_Click"
                    Visibility="Collapsed" />
            <Button x:Name="OkButton" Content="{loc:Loc ProxyText_BtnImport}" Width="100" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click" />
            <Button x:Name="CancelButton" Content="{loc:Loc ProxyText_BtnCancel}" Width="80" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
