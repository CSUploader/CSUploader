<Window x:Class="CSUploader.Views.ErrorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        Title="{loc:Loc Common_Error}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico"
        Width="640" Height="420"
        MinWidth="360" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The full error: the human-readable summary plus any raw response body. A sign-in
             failure from the XFileSharing pipeline appends a multi-hundred-character HTML
             snippet, which is why it lives here (read-only, scrollable, selectable) instead of
             in the fixed-size Add Account window that opened it. -->
        <TextBox Grid.Row="0"
                 x:Name="DetailBox"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 Background="{DynamicResource ContentBackgroundBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 BorderThickness="1"
                 Padding="6" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:Loc Common_Copy}" Width="80" Margin="0,0,8,0" Click="Copy_Click" />
            <Button Content="{loc:Loc Common_Close}" Width="80" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
