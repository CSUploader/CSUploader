<Window x:Class="CSUploader.Views.EditProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        Title="{loc:Loc EditProxy_AddTitle}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceMutedBrush}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,5" />
            <!-- Match the rendered height of FieldInput TextBoxes; the default WPF
                 ComboBox templating measures taller than a TextBox with the same
                 padding/font, so the row alignment would otherwise jump at the Type
                 field. -->
            <Setter Property="Height" Value="29" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" Padding="12,0"
                                BorderThickness="1" BorderBrush="{DynamicResource DialogButtonBorderBrush}"
                                Background="{DynamicResource DialogButtonBgBrush}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DialogButtonHoverBorderBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogButtonHoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DialogButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="3" Padding="12,0"
                                BorderThickness="1" BorderBrush="{DynamicResource SaveButtonBorderBrush}"
                                Background="{DynamicResource SaveButtonBgBrush}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SaveButtonHoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SaveButtonPressedBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="{DynamicResource SurfaceBrush}" CornerRadius="4"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Settings_Conn_Col_Type}" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="TypeCombo" Style="{StaticResource FieldCombo}" Margin="0,0,0,10" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Settings_Conn_Col_Host}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HostBox" Style="{StaticResource FieldInput}" Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Settings_Conn_Col_Port}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PortBox" Style="{StaticResource FieldInput}" Margin="0,0,0,10"
                     HorizontalAlignment="Left" Width="100" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Settings_Conn_Col_User}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="UsernameBox" Style="{StaticResource FieldInput}" Margin="0,0,0,10" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc Settings_Conn_Col_Password}" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" Style="{StaticResource FieldInput}" Margin="0,0,0,10" />

            <CheckBox Grid.Row="5" Grid.Column="1" x:Name="EnabledCheck"
                      Content="{loc:Loc EditProxy_EnabledLabel}"
                      FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />

            <!-- Test-status line + Details button. Hosts the test outcome and a
                 Details affordance that opens the same HttpDetailsWindow the Connection
                 grid uses (request + response with headers and body). -->
            <Grid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="TestStatusText"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Grid.Column="1"
                        x:Name="TestDetailsButton"
                        Content="{loc:Loc Settings_Conn_Btn_Details}"
                        FontSize="11"
                        Padding="6,1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="TestDetailsButton_Click" />
            </Grid>

            <!-- Bottom button row: Test on the left, Save/Cancel right-aligned. -->
            <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="TestButton"
                        Content="{loc:Loc EditProxy_BtnTest}"
                        Style="{StaticResource DialogButton}"
                        Click="TestButton_Click" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton"
                            Content="{loc:Loc EditProxy_BtnSave}" Style="{StaticResource SaveButton}"
                            Click="SaveButton_Click" Margin="0,0,8,0" IsDefault="True" />
                    <Button Content="{loc:Loc EditProxy_BtnCancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
