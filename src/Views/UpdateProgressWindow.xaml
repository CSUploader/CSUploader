<Window x:Class="CSUploader.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        Title="{loc:Loc UpdateProgress_WindowTitle}"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="StatusText"
                   Text="{loc:Loc UpdateProgress_StatusInitial}"
                   FontSize="13"
                   Margin="0,0,0,12" />
        <ProgressBar x:Name="Progress"
                     Height="18"
                     Minimum="0"
                     Maximum="100"
                     Value="0" />
        <TextBlock x:Name="PercentText"
                   Text="{loc:Loc UpdateProgress_PercentInitial}"
                   HorizontalAlignment="Right"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11" />
    </StackPanel>
</Window>
