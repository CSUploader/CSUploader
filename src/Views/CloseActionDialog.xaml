<Window x:Class="CSUploader.Views.CloseActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close CSUploader"
        Icon="pack://application:,,,/Properties/Images/Logo/icon.ico"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="What would you like the close button to do?"
                   TextWrapping="Wrap"
                   FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Pick one — you can change this later under Settings → General."
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,0,0,16" />

        <CheckBox Grid.Row="2"
                  x:Name="RememberCheck"
                  Content="Remember my choice"
                  IsChecked="True"
                  Margin="0,0,0,16"
                  Foreground="{DynamicResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Minimize to tray" Width="140" Margin="0,0,8,0"
                    IsDefault="True" Click="MinimizeToTray_Click" />
            <Button Content="Exit" Width="100" Margin="0,0,8,0"
                    Click="Exit_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
