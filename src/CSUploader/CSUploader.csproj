<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only, opt-in AvaDevBridge wiring. MSBuild auto-imports only Directory.Build.props, so the
       machine-specific local props (which defines AvaDevBridgeCsproj) is imported explicitly here.
       Absent on CI → no import, no reference, no AVA_BRIDGE define; the build stays self-contained. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)..\..\Directory.Build.local.props')" />

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(AvaDevBridgeCsproj)' != '' and Exists('$(AvaDevBridgeCsproj)')">
    <AvaBridgeEnabled>true</AvaBridgeEnabled>
    <DefineConstants>$(DefineConstants);AVA_BRIDGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(AvaBridgeEnabled)' == 'true'">
    <ProjectReference Include="$(AvaDevBridgeCsproj)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Multi-target: the Windows head keeps its full WebView2 sign-in + DWM dark-title-bar; the
         portable net10.0 target builds a Linux-runnable app (Avalonia is cross-platform) with the
         Windows-only bits conditioned out below. -->
    <TargetFrameworks>net10.0-windows10.0.17763.0;net10.0</TargetFrameworks>
    <RootNamespace>CSUploader</RootNamespace>
    <AssemblyName>CSUploader</AssemblyName>
    <!-- release.yml derives the SHIPPED version from the pushed vX.Y.Z tag
         (-p:Version), so this is the loose-build fallback — keep it in sync with the release tag. -->
    <Version>1.8.0</Version>
    <AssemblyVersion>1.8.0.0</AssemblyVersion>
    <!-- Was left at 1.0.0.0 through the 1.1.0 release; kept in step with the others from 1.2.0 on. -->
    <FileVersion>1.8.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>preview</LangVersion>
    <!-- WebView2's managed API marshals COM; required for the WebView2 login host (CoreWebView2 COM marshaling).
         Windows-target only — the WebView2 host does not exist in the portable build. -->
    <BuiltInComInteropSupport Condition="$(TargetFramework.Contains('windows'))">true</BuiltInComInteropSupport>
    <!-- Compiled bindings are the default; the port-parity exception that kept them off is spent.
         Every view whose bindings are meant to be checked declares an x:DataType, so a binding to a
         member that doesn't exist is a BUILD error rather than a blank cell nobody notices — the
         failure BindingErrorSink was written to catch after one sat in LogsView for months.
         What is still reflection, and why — three bindings and two elements, nothing else:
           • three {ReflectionBinding}s, all the same hop: the Connection panel's three child rows
             each fetch their view-model through the ancestor WINDOW's DataContext, whose runtime
             type varies by host (MainViewModel in the app, plain doubles in the headless suites),
             so no cast would be true. What that hop yields is typed, and everything below it
             compiles — including the proxy grid's columns, whose row type the compiler infers from
             the typed ItemsSource;
           • two x:CompileBindings="False" elements: the uploads grid, whose COLUMNS bind rows that
             are Package or PackageFile with no shared base (its context menu re-enables compilation
             and its SelectedItem names the view-model explicitly, so only the columns rely on it),
             and the DEBUG-only dev gallery, deliberately untyped throwaway scaffolding.
         Where a type is awkward but nameable, it is named rather than surrendered: bindings carry
         their own DataType for nested records (Type+Nested) and closed generics (x:TypeArguments). -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon Condition="$(TargetFramework.Contains('windows'))">..\Properties\Images\Logo\icon.ico</ApplicationIcon>
    <!-- Win32 supportedOS manifest — REQUIRED for Avalonia NativeControlHost / WebView2 hosting.
         Windows-target only (a Win32 manifest is meaningless on Linux). -->
    <ApplicationManifest Condition="$(TargetFramework.Contains('windows'))">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- DataGrid versions independently of the core (12.1.2 is its current line against the 12.1
         core). Pinned so the resolution graph is locked before any grid work (design §Hard
         constraints). -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Reserved for head-local MVVM helpers as views arrive; if still unused at the Phase 9
         cutover, drop it (same rule that removed it from the WPF head in c4e9b82). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <!-- WebView2 login host (Core wrapper only; see _DropWebView2DesktopWrappers). Windows-target only —
         Linux has no WebView2; the portable build stubs interactive sign-in. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" Condition="$(TargetFramework.Contains('windows'))" />
    <!-- CefGlue/CEF interactive sign-in host — NON-Windows only (Linux/macOS); Windows uses WebView2 above.
         120.6099.211 = CEF/Chromium 120. Avalonia.ReactiveUI is a transitive dep of CefGlue.Avalonia that
         tops out at 11.3.9 — pinned so it can't drag in 11.0.9. The package was RENAMED ReactiveUI.Avalonia
         for Avalonia 12, but CefGlue depends on this identity, so the rename cannot satisfy it: referencing
         the new name instead of this pin ships BOTH adapters and silently downgrades this one to 11.0.9.
         Nothing else here uses ReactiveUI. This 11-era adapter over Avalonia 12 was live-validated
         on Linux before v1.7.0; no CefGlue build for 12 exists, so revalidate there after either
         dependency changes. -->
    <PackageReference Include="CefGlue.Avalonia" Version="120.6099.211" Condition="!$(TargetFramework.Contains('windows'))" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.9" Condition="!$(TargetFramework.Contains('windows'))" />
    <!-- File-type SVG rendering (FileTypeIconConverter to a cached SvgImage) via Svg.Skia. Depends on
         Svg.Skia + SkiaSharp, which can UPLIFT the app's SkiaSharp above the build Avalonia.Skia
         pins (it did against 11.3.18's 2.88.9) - verified to render at runtime (live Skia proof),
         not by faith. -->
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSUploader.Core\CSUploader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the WPF head's icon; no duplication. If the Link'd avares path does not resolve
         at runtime (verify with AssetLoader in Step 5), copy the .ico to Assets\ instead. -->
    <AvaloniaResource Include="..\Properties\Images\Logo\icon.ico" Link="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF head's image tree is the single source of truth; linked, not copied.
         avares URIs: /Assets/Images/<subpath> (root-relative in XAML; full avares:// with
         the assembly name code-side — the Phase 2 gate convention). BitmapImageResources
         merges the keyed subset (ImageResources.xaml parity); extra unkeyed PNGs ride along
         harmlessly, exactly as the WPF head embeds the whole folder. -->
    <AvaloniaResource Include="..\Properties\Images\**\*" Link="Assets\Images\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- vscode-icons file-type SVGs from the git submodule, embedded as AvaloniaResource so
         Svg.Skia renders them by avares URI (avares://…/FileTypes/<name>.svg). Mirror of the WPF
         head's glob (src/CSUploader.csproj), one directory deeper — hence ..\..\external. -->
    <AvaloniaResource Include="..\..\external\vscode-icons\icons\*.svg" Link="FileTypes\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- A fresh worktree/clone without submodule init leaves the glob empty, which silently ships an
       app with no file-type icons (a glob matching zero files is not an MSBuild error). Fail the
       build instead — same guard as the WPF head. -->
  <Target Name="EnsureVsCodeIconsSubmodule" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('..\..\external\vscode-icons\icons\file_type_json.svg')" Text="vscode-icons submodule not initialized — run: git submodule update --init --recursive" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="CSUploader.Tests" />
  </ItemGroup>

  <!-- The Developer settings category is a DEBUG-only tool: drop its view and code-behind from every
       other configuration so a shipped build contains neither the page nor the mock-server switch.
       SettingsView.axaml.cs guards the only reference to the type with #if DEBUG, so the two cannot
       drift apart — removing the file without the guard would fail the build rather than ship a
       dangling page. Same Remove idiom as the per-TFM exclusions below, keyed on Configuration. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Views\DeveloperSettingsView.axaml.cs" />
    <AvaloniaXaml Remove="Views\DeveloperSettingsView.axaml" />
  </ItemGroup>

  <!-- CefGlue sign-in code references the non-Windows-only CefGlue packages, so exclude it from the
       WINDOWS compile (the inverse of the WebView2 exclusion below). Globs match zero files until the
       Cef* files land (Tasks 4/5). -->
  <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
    <Compile Remove="Views\Cef\**" />
    <AvaloniaXaml Remove="Views\Cef\**" />
    <Compile Remove="Services\Cef*.cs" />
  </ItemGroup>

  <!-- Linux-port: the WebView2 sign-in host is Windows-only. Drop its source + the XAML login window
       from the portable build; App registers UnsupportedInteractiveAuthService instead (see App.axaml.cs). -->
  <ItemGroup Condition="!$(TargetFramework.Contains('windows'))">
    <Compile Remove="Views\WebView2Host.cs" />
    <Compile Remove="Views\WebViewLoginWindow.axaml.cs" />
    <Compile Remove="Services\AvaloniaWebViewInteractiveAuthService.cs" />
    <AvaloniaXaml Remove="Views\WebViewLoginWindow.axaml" />
    <!-- The DEBUG dev gallery demos the WebView2 login window (and is a Windows-bridge tool); App only
         launches it under #if DEBUG && WINDOWS, so drop it from the portable build. -->
    <Compile Remove="DevTools\GalleryWindow.axaml.cs" />
    <AvaloniaXaml Remove="DevTools\GalleryWindow.axaml" />
  </ItemGroup>

  <!-- The WebView2 SDK references its WPF + WinForms wrapper assemblies for every net5+ TFM
       (no UseWpf/UseWindowsForms gate). This Avalonia head consumes ONLY the Core API; the WPF
       wrapper pulls in WPF's WindowsBase 5.0 → an unresolvable MSB3277 conflict against the
       net10 WindowsBase. Drop both desktop wrappers before RAR — Core.dll and the native
       WebView2Loader copy are untouched. Permanent: the Avalonia head consumes only Microsoft.Web.WebView2.Core. -->
  <Target Name="_DropWebView2DesktopWrappers" BeforeTargets="ResolveAssemblyReferences" Condition="$(TargetFramework.Contains('windows'))">
    <ItemGroup>
      <Reference Remove="@(Reference-&gt;WithMetadataValue('Filename','Microsoft.Web.WebView2.Wpf'))" />
      <Reference Remove="@(Reference-&gt;WithMetadataValue('Filename','Microsoft.Web.WebView2.WinForms'))" />
    </ItemGroup>
  </Target>

</Project>
