<!-- Design tokens ported 1:1 from the WPF Tokens.xaml:8-41 (spacing / typography / control sizing /
     corners + the runtime-overridable grid font). The WPF Tokens.xaml re-templates (ComboBox/Menu/
     ScrollBar/TabControl/DatePicker/Calendar, :155-895) are deliberately NOT ported — FluentTheme +
     the ThemeVariant brush dictionaries cover dark mode, which is the only reason those existed. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Grid font tokens — runtime-overridable via IThemeApplier.ApplyGridFont (Settings →
       General → Grid Font/Size). Grids consume them via DynamicResource. -->
  <FontFamily x:Key="GridFontFamily">Tahoma</FontFamily>
  <x:Double x:Key="GridFontSize">12</x:Double>

  <!-- Spacing -->
  <Thickness x:Key="SpacingNone">0</Thickness>
  <Thickness x:Key="SpacingXs">2</Thickness>
  <Thickness x:Key="SpacingSm">4</Thickness>
  <Thickness x:Key="SpacingMd">8</Thickness>
  <Thickness x:Key="SpacingLg">12</Thickness>
  <Thickness x:Key="SpacingXl">16</Thickness>
  <Thickness x:Key="GroupBoxPadding">8,6,8,8</Thickness>

  <!-- Vertical-only spacing -->
  <Thickness x:Key="RowSpacingSm">0,0,0,4</Thickness>
  <Thickness x:Key="RowSpacingMd">0,0,0,8</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,6</Thickness>

  <!-- Typography -->
  <x:Double x:Key="FontSizeXs">11</x:Double>
  <x:Double x:Key="FontSizeSm">12</x:Double>
  <x:Double x:Key="FontSizeMd">13</x:Double>
  <x:Double x:Key="FontSizeLg">14</x:Double>

  <!-- Control sizing -->
  <x:Double x:Key="ControlHeightSm">24</x:Double>
  <x:Double x:Key="ControlHeightMd">28</x:Double>
  <x:Double x:Key="DataGridRowHeight">26</x:Double>
  <GridLength x:Key="LabelWidth">110</GridLength>

  <!-- Phase 9 header-metrics reclaim (design line 101 reconcile item 10): the Fluent DataGridColumnHeader
       template statically reserves DataGridSortIconMinWidth (32px) for the sort glyph even when none shows,
       clipping short headers to blank at &lt;44px. App-scoped (merged into Application.Resources) so the
       DynamicResource in the theme's sort-icon ColumnDefinition.MinWidth resolves to this override.
       Value tuned to 8 against the Task 1 contact sheet (Step 6): the accounts '&#x2713;' column is the binding
       constraint at 30px — content = width - header-padding(2,0) - reserve, so 30-4-8 = 18px shows the glyph,
       and the proxies 'On' column (40px) gets 28px. 16 (a naive half) left only 6px on the 30px column, still
       blank. Sortable columns keep their glyph: the reserve is a MIN — the Auto column grows to the 12px glyph
       when a column is actually sorted, costing only a small reflow the checkbox (never-sorted) columns avoid. -->
  <x:Double x:Key="DataGridSortIconMinWidth">8</x:Double>

  <!-- Corners -->
  <CornerRadius x:Key="RadiusSm">2</CornerRadius>
  <CornerRadius x:Key="RadiusMd">4</CornerRadius>
</ResourceDictionary>
