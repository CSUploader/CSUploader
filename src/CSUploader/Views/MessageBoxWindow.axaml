<!-- The Avalonia head's custom message box (design: MessageBox.Show sites -> a small custom
     message-box window, no MsBox.Avalonia dependency). This IS the WPF ConfirmationDialog port
     (ConfirmationDialog.xaml): the YesNoDontAskAgain mode is message + "Don't ask again" checkbox;
     Ok / YesNo drop the checkbox. Button roles/visibility are set per mode in code-behind. The
     per-type icon (Phase 9) reproduces WPF MessageBox.Show's OS system icon as a themed glyph. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        x:Class="CSUploader.Views.MessageBoxWindow"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/icon.ico"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Window.Resources>
    <!-- Message-box severity glyphs (Material Design Icons, Apache 2.0). Kept window-local — the only
         consumer is this box, and unlike the ImageGeometries.axaml set these have NO WPF ImageResources
         counterpart (WPF drew OS shell icons for MessageBox.Show, so they are outside the WPF key-parity
         drift gate). The code-behind resolves one by key per MessageBoxIcon and tints it with a theme brush
         (ErrorBrush / WarningBrush / InfoAccentBrush / AccentBrush) so the glyph reads in light and dark. -->

    <!-- "close-circle" — X in a filled disc, for MessageBoxImage.Error. -->
    <StreamGeometry x:Key="MessageBoxErrorGeometry">M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z</StreamGeometry>

    <!-- "alert" — exclamation in a triangle, for MessageBoxImage.Warning. -->
    <StreamGeometry x:Key="MessageBoxWarningGeometry">M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z</StreamGeometry>

    <!-- "information" — i in a filled disc, for MessageBoxImage.Information. -->
    <StreamGeometry x:Key="MessageBoxInformationGeometry">M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2Z</StreamGeometry>

    <!-- "help-circle" — ? in a filled disc, for MessageBoxImage.Question (the Yes/No confirmation). -->
    <StreamGeometry x:Key="MessageBoxQuestionGeometry">M15.07,11.25L14.17,12.17C13.45,12.89 13,13.5 13,15H11V14.5C11,13.39 11.45,12.39 12.17,11.67L13.41,10.41C13.78,10.05 14,9.55 14,9C14,7.89 13.1,7 12,7A2,2 0 0,0 10,9H8A4,4 0 0,1 12,5A4,4 0 0,1 16,9C16,9.88 15.64,10.67 15.07,11.25M13,19H11V17H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
  </Window.Resources>

  <!-- Two columns: the optional icon (Auto — collapses to 0 when hidden, so a no-icon box is flush-left,
       identical to the pre-Phase-9 single-column layout), then the message/checkbox/buttons stack. -->
  <Grid Margin="16" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
    <Path Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
          x:Name="IconGlyph"
          Width="28" Height="28"
          Stretch="Uniform"
          VerticalAlignment="Top"
          Margin="0,2,14,0"
          IsVisible="False" />

    <TextBlock Grid.Row="0" Grid.Column="1"
               x:Name="MessageText"
               TextWrapping="Wrap"
               FontSize="13"
               VerticalAlignment="Center"
               Margin="0,0,0,16" />

    <CheckBox Grid.Row="1" Grid.Column="1"
              x:Name="DontAskAgainCheck"
              Content="{loc:Loc Confirmation_DontAskAgain}"
              Margin="0,0,0,16"
              IsVisible="False"
              Foreground="{DynamicResource TextSecondaryBrush}" />

    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="YesButton"
              Content="{loc:Loc Confirmation_BtnYes}"
              MinWidth="80" Margin="0,0,8,0"
              IsVisible="False"
              Click="Yes_Click" />
      <Button x:Name="NoButton"
              Content="{loc:Loc Confirmation_BtnNo}"
              MinWidth="80"
              IsVisible="False"
              Click="No_Click" />
      <Button x:Name="OkButton"
              Content="{loc:Loc Common_OK}"
              MinWidth="80"
              IsVisible="False"
              Click="Ok_Click" />
    </StackPanel>
  </Grid>
</Window>
