<!-- Avalonia port of the WPF Uploads tab (src/Views/UploadsView.xaml:104-644). This task (Phase 6 Task 10)
     lands the grid + columns + toolbar + filter bar + the durable filtered collection view, and takes the
     Uploads MainWindow tab live. The custom DataGridColumnHeader re-template (lock ToggleButton + built-in
     drag-resize + stock sort glyph) is the Task 1 GO recipe copied VERBATIM from the now-deleted
     HeaderTemplateProbeWindow; header->column association is by matching header.Content to column.Header
     (the 21 Uploads_Col_* headers are unique, confirmed, so content-match is safe). The overview panel,
     premium footer, context menu, editable Order and package-expanding copy are Tasks 11-12. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:beh="clr-namespace:CSUploader.Behaviors"
             xmlns:ctrl="clr-namespace:CSUploader.Views.Controls"
             xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
             xmlns:vm="clr-namespace:CSUploader.ViewModels;assembly=CSUploader.Core"
             x:Class="CSUploader.Views.UploadsView"
             x:DataType="vm:UploadsViewModel">

  <UserControl.Resources>
    <conv:ByteUnitConverter x:Key="ByteUnitConverter" />
    <conv:SingleLineConverter x:Key="SingleLineConverter" />
    <conv:TimeSpanFormatConverter x:Key="TimeSpanConverter" />
    <conv:DateTimeFormatConverter x:Key="DateTimeConverter" />
    <conv:SpeedLimitConverter x:Key="SpeedLimitConverter" />
    <conv:FileStateDisplayConverter x:Key="FileStateConverter" />
    <conv:FileStateIconConverter x:Key="FileStateIconConverter" />
    <conv:HosterIconConverter x:Key="HosterIconConverter" />
    <conv:FileTypeIconConverter x:Key="FileTypeIconConverter" />
    <conv:ProgressWidthConverter x:Key="ProgressWidthConverter" />

    <!-- Context-menu converters (Task 11): the Start label + the Start/ForceStart/Stop visibility both
         track the right-clicked SelectedRow's state. Twins of the WPF StartMenuLabel/ItemStateToVisibility
         resources, returning a bool for IsVisible instead of a WPF Visibility. -->
    <conv:StartMenuLabelConverter x:Key="StartMenuLabel" />
    <conv:ItemStateToVisibilityConverter x:Key="ItemStateToVisibility" />

    <!-- Stock sort-glyph geometries (Task 1 recipe): copied verbatim from the installed 11.3.13 Fluent
         DataGrid theme so the custom header reproduces Avalonia's stock sort indicator. The WPF custom
         header shows NO glyph — keeping Avalonia's is the accepted divergence recorded in Task 1. -->
    <StreamGeometry x:Key="UploadsSortIconAscendingPath">M1965 947l-941 -941l-941 941l90 90l787 -787v1798h128v-1798l787 787z</StreamGeometry>
    <StreamGeometry x:Key="UploadsSortIconDescendingPath">M1875 1011l-787 787v-1798h-128v1798l-787 -787l-90 90l941 941l941 -941z</StreamGeometry>

    <!-- JD2 lock ToggleButton (mirrors WPF UploadsView.xaml:317-345). 14x14 padlock: unlocked (dim) ->
         locked (AccentBrush) via :checked. Vector Paths, NOT the WPF head's Segoe MDL2 glyphs (E785/E72E):
         MDL2 is a Windows-only font, so on Linux the glyphs rendered as missing-glyph boxes (tofu). The
         open-lock geometry is the closed one with the right shackle leg lifted clear of the body. Defined
         before LockableHeaderTheme so the StaticResource reference resolves. -->
    <StreamGeometry x:Key="UploadsLockOpenPath">M2.75,7 L2.75,4.5 A3.25,3.25 0 0 1 9.25,4.5 L9.25,5.5 L7.75,5.5 L7.75,4.5 A1.75,1.75 0 0 0 4.25,4.5 L4.25,7 Z M1,8.5 A1.5,1.5 0 0 1 2.5,7 L9.5,7 A1.5,1.5 0 0 1 11,8.5 L11,12.5 A1.5,1.5 0 0 1 9.5,14 L2.5,14 A1.5,1.5 0 0 1 1,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="UploadsLockClosedPath">M2.75,7 L2.75,4.5 A3.25,3.25 0 0 1 9.25,4.5 L9.25,7 L7.75,7 L7.75,4.5 A1.75,1.75 0 0 0 4.25,4.5 L4.25,7 Z M1,8.5 A1.5,1.5 0 0 1 2.5,7 L9.5,7 A1.5,1.5 0 0 1 11,8.5 L11,12.5 A1.5,1.5 0 0 1 9.5,14 L2.5,14 A1.5,1.5 0 0 1 1,12.5 Z</StreamGeometry>
    <ControlTheme x:Key="LockToggleTheme" TargetType="ToggleButton">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ToolTip.Tip" Value="{loc:Loc Uploads_ColumnHeader_LockTip}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Path x:Name="Glyph"
                  Data="{StaticResource UploadsLockOpenPath}"
                  Width="8" Height="10" Stretch="Uniform"
                  Fill="{DynamicResource TextSecondaryBrush}"
                  Opacity="0.45"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Path#Glyph">
        <Setter Property="Opacity" Value="1.0" />
      </Style>
      <Style Selector="^:checked /template/ Path#Glyph">
        <Setter Property="Data" Value="{StaticResource UploadsLockClosedPath}" />
        <Setter Property="Opacity" Value="1.0" />
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
      </Style>
    </ControlTheme>

    <!-- The pinned custom header (Task 1 GO recipe, verbatim). DataGridColumnHeader has NO OnApplyTemplate /
         NameScope lookups, so re-template is free-form (only a ContentPresenter for Content is required).
         Resize is the header's OWN 5px-edge pointer logic gated on DataGridColumn.CanUserResize (no
         PART_*Gripper exists), and sort is its PointerReleased -> ProcessSort — both survive any hit-testable
         template. The lock ToggleButton is kept 8px clear of the edge so the 5px resize region stays
         grabbable. Wired via DataGrid.ColumnHeaderTheme below. -->
    <ControlTheme x:Key="LockableHeaderTheme" TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource GridFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource GridFontSize}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="HeaderBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource DataGridGridLineBrush}"
                  BorderThickness="0,0,1,1">
            <Grid x:Name="PART_ColumnHeaderRoot" ColumnDefinitions="*,Auto,Auto">
              <Panel Grid.Column="0"
                     Margin="{TemplateBinding Padding}"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid ColumnDefinitions="*,Auto">
                  <ContentPresenter x:Name="PART_ContentPresenter"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                  <Path x:Name="SortIcon"
                        Grid.Column="1"
                        IsVisible="False"
                        Height="9"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{TemplateBinding Foreground}"
                        Stretch="Uniform" />
                </Grid>
              </Panel>
              <ToggleButton x:Name="LockToggle"
                            Grid.Column="1"
                            Theme="{StaticResource LockToggleTheme}"
                            Margin="2,0,8,0"
                            VerticalAlignment="Center"
                            Click="ColumnLock_Click" />
              <Rectangle x:Name="VerticalSeparator"
                         Grid.Column="2"
                         Width="1"
                         VerticalAlignment="Stretch"
                         Fill="{DynamicResource DataGridGridLineBrush}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      </Style>
      <Style Selector="^:sortascending /template/ Path#SortIcon">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Data" Value="{StaticResource UploadsSortIconAscendingPath}" />
      </Style>
      <Style Selector="^:sortdescending /template/ Path#SortIcon">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Data" Value="{StaticResource UploadsSortIconDescendingPath}" />
      </Style>
    </ControlTheme>

    <!-- Toolbar button (rule 40): 36x36 flat button, hover/pressed border. WPF Style x:Key="ToolbarButton". -->
    <ControlTheme x:Key="ToolbarButtonTheme" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="1,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonHoverBorderBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource ToolbarButtonPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonPressedBorderBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Row chrome (WPF RowStyle): grid font + min height. -->
    <Style Selector="DataGridRow">
      <Setter Property="FontFamily" Value="{DynamicResource GridFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource GridFontSize}" />
      <Setter Property="MinHeight" Value="20" />
    </Style>

    <!-- Zebra alt-row shading (Task 4 helper toggles the .alt class). -->
    <Style Selector="DataGridRow.alt">
      <Setter Property="Background" Value="{DynamicResource DataGridAltRowBrush}" />
    </Style>

    <!-- Name-column chevron: hidden (space reserved) on file rows so the file name keeps its indent. WPF
         used Visibility=Hidden; Avalonia has no Hidden, so Opacity 0 + no hit-testing reproduces
         "invisible but still occupies its 20px slot" (the conditional .filerow class comes from
         Classes.filerow="{Binding !IsPackageRow}"). -->
    <Style Selector="ToggleButton.name-chevron.filerow">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Package-row name is SemiBold (WPF DataTrigger on IsPackageRow). -->
    <Style Selector="TextBlock.pkg-name.package-row">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Rule-20 cell classes for the two read-only text columns that carried an ElementStyle in WPF
         (DataGridTextColumn has no ElementStyle on Avalonia). -->
    <Style Selector="DataGridCell.path-cell TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DataGridCell.error-cell TextBlock">
      <Setter Property="Foreground" Value="Red" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Overview stat pairs (rule 40: the WPF per-TextBlock inline styling collapses to Classes selectors).
         Each pair is a horizontal StackPanel of a secondary label + a bold primary value. -->
    <Style Selector="StackPanel.stat">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Margin" Value="0,0,16,1" />
    </Style>
    <Style Selector="StackPanel.stat > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.stat-label">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="TextBlock.stat-value">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Background="{DynamicResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Toolbar (JD2-style: large icons, hover borders). -->
    <Border Grid.Row="0" Background="{DynamicResource DataGridHeaderBrush}"
            BorderBrush="{DynamicResource DataGridGridLineBrush}" BorderThickness="0,0,0,1"
            Padding="4,2">
      <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Button x:Name="AddButton" Theme="{StaticResource ToolbarButtonTheme}" Click="AddUploadButton_Click"
                ToolTip.Tip="{loc:Loc Uploads_Toolbar_AddTip}">
          <TextBlock Text="+" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
        </Button>

        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4" />

        <Button Theme="{StaticResource ToolbarButtonTheme}" Command="{Binding StartCommand}"
                ToolTip.Tip="{loc:Loc Uploads_Toolbar_StartTip}">
          <Image Source="{StaticResource ButtonStartImage}" Width="24" Height="24" />
        </Button>
        <Button Theme="{StaticResource ToolbarButtonTheme}" Command="{Binding PauseCommand}"
                ToolTip.Tip="{loc:Loc Uploads_Toolbar_PauseTip}">
          <Image Source="{StaticResource ButtonPauseImage}" Width="24" Height="24" />
        </Button>
        <Button Theme="{StaticResource ToolbarButtonTheme}" Command="{Binding StopCommand}"
                ToolTip.Tip="{loc:Loc Uploads_Toolbar_StopTip}">
          <Image Source="{StaticResource ButtonStopImage}" Width="24" Height="24" />
        </Button>

        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4" />

        <Button Theme="{StaticResource ToolbarButtonTheme}"
                Command="{Binding MoveUpCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=uploadsGrid}"
                ToolTip.Tip="{loc:Loc Uploads_Tooltip_MoveUp}">
          <TextBlock Text="&#x25B2;" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
        <Button Theme="{StaticResource ToolbarButtonTheme}"
                Command="{Binding MoveDownCommand}"
                CommandParameter="{Binding SelectedItem, ElementName=uploadsGrid}"
                ToolTip.Tip="{loc:Loc Uploads_Tooltip_MoveDown}">
          <TextBlock Text="&#x25BC;" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>

        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4" />

        <!-- Remove's SelectedItems parameter is wired in code-behind (rule 19). -->
        <Button x:Name="RemoveButton" Theme="{StaticResource ToolbarButtonTheme}"
                Command="{Binding RemoveSelectedCommand}"
                ToolTip.Tip="{loc:Loc Uploads_Toolbar_RemoveTip}">
          <TextBlock Text="&#x2715;" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
      </StackPanel>

        <!-- Speedometer (JDownloader-style): live aggregate upload speed + a sparkline of the last ~10 s
             (20 samples at the 500 ms refresh tick). SpeedGraph derives its translucent area fill from the
             accent LineBrush, so it follows the theme. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
          <TextBlock Text="{Binding UploadSpeed}" FontWeight="SemiBold" FontSize="12"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <Border Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource InputFieldBorderBrush}"
                  BorderThickness="1" CornerRadius="2" Width="150" Height="24" Padding="2,1">
            <ctrl:SpeedGraph Samples="{Binding SpeedHistory}" LineBrush="{DynamicResource AccentBrush}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main DataGrid. IsReadOnly=False is here ONLY so the Order cell can be typed into (Task 11 adds the
         BeginningEdit guard that cancels edits for every other column); all read-only text columns are
         Mode=OneWay so an interim edit can never write back through a throwing converter (rule 32). -->
    <!-- reflection island, narrowed to what actually needs it: the grid shows Package AND PackageFile
         rows through one column set — duck-typed members (Name/Size/State/…) with no shared base, so no
         x:DataType exists for the COLUMNS. Everything on this element that binds the VM instead of a row
         is compiled anyway: the context menu re-enables compilation below, and SelectedItem names the
         view-model on the binding. What the compiler cannot check for the columns,
         UploadsViewTests.MixedRows_BindQuietly does — it realizes BOTH row types and asserts the view
         raises no binding errors. -->
    <DataGrid x:Name="uploadsGrid" Grid.Row="1"
              x:CompileBindings="False"
              Classes="listview"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              CanUserSortColumns="True"
              SelectionMode="Extended"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
              VerticalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
              Background="{DynamicResource SurfaceBrush}"
              BorderThickness="0"
              ClipboardCopyMode="IncludeHeader"
              SelectedItem="{CompiledBinding SelectedRow, Mode=OneWayToSource, DataType={x:Type vm:UploadsViewModel}}"
              ColumnHeaderTheme="{StaticResource LockableHeaderTheme}"
              beh:DataGridZebraStriping.IsEnabled="True"
              beh:DataGridSelectionBehaviors.ClearSelectionOnEmptyClick="True"
              beh:DataGridSelectionBehaviors.SelectRowOnRightClick="True">

      <!-- Row context menu (rules 18/19, Task 11): commands bind through the ContextMenu's inherited
           DataContext (the grid's VM), so the WPF PlacementTarget.Tag / RelativeSource=ContextMenu bindings
           collapse to plain {Binding …}. The Start label + Start/ForceStart/Stop visibility track the
           right-clicked SelectedRow (updated by SelectRowOnRightClick before the menu opens). The nine
           SelectedItems-carrying command parameters are assigned in code-behind (rule 19). Opening snapshots
           the multi-selection into the VM and suppresses the menu on an empty-space right-click
           (_rightClickOnItem, recorded at press time since Opening carries no source). -->
      <DataGrid.ContextMenu>
        <!-- Back INSIDE the compiler's reach: every binding here targets the UploadsViewModel the view
             root declares, not a row, so the island the grid needs for its mixed columns must not
             swallow them too. -->
        <ContextMenu Opening="RowContextMenu_Opening" x:CompileBindings="True">
          <!-- Label + visibility track the focused (right-clicked) row; the command operates on the WHOLE
               selection via SelectedItems, so a multi-row selection all starts. -->
          <MenuItem x:Name="StartMenuItem"
                    Header="{Binding SelectedRow, Converter={StaticResource StartMenuLabel}}"
                    Command="{Binding StartSelectedCommand}"
                    IsVisible="{Binding SelectedRow, Converter={StaticResource ItemStateToVisibility}, ConverterParameter=Startable}">
            <MenuItem.Icon><Image Source="{StaticResource ButtonStartImage}" Width="16" Height="16" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="ForceStartMenuItem"
                    Header="{loc:Loc Uploads_Context_ForceStart}"
                    Command="{Binding ForceStartSelectedCommand}"
                    IsVisible="{Binding SelectedRow, Converter={StaticResource ItemStateToVisibility}, ConverterParameter=ForceStartable}">
            <MenuItem.Icon><Path Data="{StaticResource ForceStartGeometry}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="StopMenuItem"
                    Header="{loc:Loc Uploads_Context_Stop}"
                    Command="{Binding StopSelectedCommand}"
                    IsVisible="{Binding SelectedRow, Converter={StaticResource ItemStateToVisibility}, ConverterParameter=Stoppable}">
            <MenuItem.Icon><Image Source="{StaticResource ActionCancelImage}" Width="16" Height="16" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="SkipMenuItem"
                    Header="{loc:Loc Uploads_Context_SkipUpload}"
                    Command="{Binding SkipUploadCommand}">
            <MenuItem.Icon><Image Source="{StaticResource ActionSkipImage}" Width="16" Height="16" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="ResetMenuItem"
                    Header="{loc:Loc Uploads_Context_Reset}"
                    Command="{Binding ResetFileCommand}">
            <MenuItem.Icon><Image Source="{StaticResource ActionResetImage}" Width="16" Height="16" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem x:Name="OpenSourceDirMenuItem"
                    Header="{loc:Loc Uploads_Context_OpenSourceDir}"
                    Command="{Binding OpenSourceDirectoryCommand}">
            <MenuItem.Icon><Image Source="{StaticResource ActionFolderImage}" Width="16" Height="16" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem x:Name="OpenUrlMenuItem"
                    Header="{loc:Loc Common_Context_OpenUrl}"
                    Command="{Binding OpenUrlCommand}" />
          <MenuItem x:Name="SetSpeedLimitMenuItem"
                    Header="{loc:Loc Uploads_Context_SetSpeedLimit}"
                    Command="{Binding SetSpeedLimitCommand}">
            <MenuItem.Icon><Image Source="{StaticResource ActionSpeedImage}" Width="16" Height="16" /></MenuItem.Icon>
          </MenuItem>
          <!-- Enabled only for a package row (set in RowContextMenu_Opening); Click (not a command)
               because beginning the inline edit needs the grid's cell/edit machinery. -->
          <MenuItem x:Name="RenamePackageMenuItem"
                    Header="{loc:Loc Uploads_Context_RenamePackage}"
                    Click="RenamePackage_Click" />
          <MenuItem Header="{loc:Loc Uploads_Context_Move}">
            <MenuItem Header="{loc:Loc Uploads_Move_Up10}"   Command="{Binding MoveSelectedCommand}" CommandParameter="-10" />
            <MenuItem Header="{loc:Loc Uploads_Move_Up1}"    Command="{Binding MoveSelectedCommand}" CommandParameter="-1" />
            <MenuItem Header="{loc:Loc Uploads_Move_Down1}"  Command="{Binding MoveSelectedCommand}" CommandParameter="1" />
            <MenuItem Header="{loc:Loc Uploads_Move_Down10}" Command="{Binding MoveSelectedCommand}" CommandParameter="10" />
          </MenuItem>
          <Separator />
          <!-- Per-column copy submenu. Each item passes its column key (the resx Uploads_Col_* suffix) as
               CommandParameter; the VM extracts the value from SelectedRows via reflection. The row-copy
               entry DIVERGES from UploadedView: UploadsView cannot use the built-in Ctrl+C (it only copies
               SelectedItems, no package expansion) — CopyRow_Click builds a package-expanding TSV instead. -->
          <MenuItem Header="{loc:Loc Common_Context_Copy}">
            <MenuItem x:Name="CopyRowMenuItem"
                      Header="{loc:Loc Uploaded_Context_Copy}"
                      InputGesture="Ctrl+C"
                      Click="CopyRow_Click" />
            <Separator />
            <MenuItem Header="{loc:Loc Uploads_Col_Name}" Command="{Binding CopyColumnCommand}" CommandParameter="Name" />
            <MenuItem Header="{loc:Loc Uploads_Col_Size}" Command="{Binding CopyColumnCommand}" CommandParameter="Size" />
            <MenuItem Header="{loc:Loc Uploads_Col_Hoster}" Command="{Binding CopyColumnCommand}" CommandParameter="Hoster" />
            <MenuItem Header="{loc:Loc Uploads_Col_Account}" Command="{Binding CopyColumnCommand}" CommandParameter="Account" />
            <MenuItem Header="{loc:Loc Uploads_Col_Status}" Command="{Binding CopyColumnCommand}" CommandParameter="Status" />
            <MenuItem Header="{loc:Loc Uploads_Col_Speed}" Command="{Binding CopyColumnCommand}" CommandParameter="Speed" />
            <MenuItem Header="{loc:Loc Uploads_Col_ETA}" Command="{Binding CopyColumnCommand}" CommandParameter="ETA" />
            <MenuItem Header="{loc:Loc Uploads_Col_BytesLoaded}" Command="{Binding CopyColumnCommand}" CommandParameter="BytesLoaded" />
            <MenuItem Header="{loc:Loc Uploads_Col_BytesRemaining}" Command="{Binding CopyColumnCommand}" CommandParameter="BytesRemaining" />
            <MenuItem Header="{loc:Loc Uploads_Col_Progress}" Command="{Binding CopyColumnCommand}" CommandParameter="Progress" />
            <MenuItem Header="{loc:Loc Uploads_Col_Path}" Command="{Binding CopyColumnCommand}" CommandParameter="Path" />
            <MenuItem Header="{loc:Loc Uploads_Col_Added}" Command="{Binding CopyColumnCommand}" CommandParameter="Added" />
            <MenuItem Header="{loc:Loc Uploads_Col_Finished}" Command="{Binding CopyColumnCommand}" CommandParameter="Finished" />
            <MenuItem Header="{loc:Loc Uploads_Col_Started}" Command="{Binding CopyColumnCommand}" CommandParameter="Started" />
            <MenuItem Header="{loc:Loc Uploads_Col_ScheduledAt}" Command="{Binding CopyColumnCommand}" CommandParameter="ScheduledAt" />
            <MenuItem Header="{loc:Loc Uploads_Col_Duration}" Command="{Binding CopyColumnCommand}" CommandParameter="Duration" />
            <MenuItem Header="{loc:Loc Uploads_Col_Order}" Command="{Binding CopyColumnCommand}" CommandParameter="Order" />
            <MenuItem Header="{loc:Loc Uploads_Col_SpeedLimit}" Command="{Binding CopyColumnCommand}" CommandParameter="SpeedLimit" />
            <MenuItem Header="{loc:Loc Uploads_Col_Hash}" Command="{Binding CopyColumnCommand}" CommandParameter="Hash" />
            <MenuItem Header="{loc:Loc Uploads_Col_URL}" Command="{Binding CopyColumnCommand}" CommandParameter="URL" />
            <MenuItem Header="{loc:Loc Uploads_Col_Error}" Command="{Binding CopyColumnCommand}" CommandParameter="Error" />
          </MenuItem>
          <!-- Paste-ready link export of the selection's COMPLETED files (packages expand to their
               files). Keys are LinkExport.ParseKey inputs. -->
          <MenuItem Header="{loc:Loc Common_CopyLinks}">
            <MenuItem Header="{loc:Loc Common_CopyLinks_ByFilePlain}" Command="{Binding CopyLinksCommand}" CommandParameter="ByFile.Plain" />
            <MenuItem Header="{loc:Loc Common_CopyLinks_ByFileBBCode}" Command="{Binding CopyLinksCommand}" CommandParameter="ByFile.BBCode" />
            <MenuItem Header="{loc:Loc Common_CopyLinks_ByFileMarkdown}" Command="{Binding CopyLinksCommand}" CommandParameter="ByFile.Markdown" />
            <Separator />
            <MenuItem Header="{loc:Loc Common_CopyLinks_ByHosterPlain}" Command="{Binding CopyLinksCommand}" CommandParameter="ByHoster.Plain" />
            <MenuItem Header="{loc:Loc Common_CopyLinks_ByHosterBBCode}" Command="{Binding CopyLinksCommand}" CommandParameter="ByHoster.BBCode" />
            <MenuItem Header="{loc:Loc Common_CopyLinks_ByHosterMarkdown}" Command="{Binding CopyLinksCommand}" CommandParameter="ByHoster.Markdown" />
          </MenuItem>
          <Separator />
          <MenuItem x:Name="RemoveMenuItem"
                    Header="{loc:Loc Uploads_Context_Remove}"
                    InputGesture="Delete"
                    Command="{Binding RemoveSelectedCommand}" />
          <!-- Selection-independent sweep — no SelectedItems parameter, so no code-behind wiring. -->
          <MenuItem x:Name="RemoveAllCompletedMenuItem"
                    Header="{loc:Loc Uploads_Context_RemoveAllCompleted}"
                    Command="{Binding RemoveAllCompletedCommand}" />
        </ContextMenu>
      </DataGrid.ContextMenu>

      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{loc:Loc Uploads_Col_Name}" Width="248" CanUserReorder="False"
                                ClipboardContentBinding="{Binding Name}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <!-- Horizontal stack: collapsed elements take zero width, so the package row's name slides
                   flush against its chevron, while file rows keep their indent via the always-rendered
                   (Opacity-0 on files) chevron + the file icon. -->
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Classes="name-chevron"
                              Classes.filerow="{Binding !IsPackageRow}"
                              Cursor="Hand"
                              Background="Transparent" BorderThickness="0" Padding="0"
                              MinWidth="0" MinHeight="0"
                              IsChecked="{Binding IsExpanded, FallbackValue=False}"
                              Click="ExpandToggle_Click">
                  <ToggleButton.Template>
                    <ControlTemplate>
                      <Border Background="Transparent" Width="20" Height="20">
                        <Panel>
                          <TextBlock Text="&#x2212;"
                                     FontFamily="{DynamicResource GridFontFamily}" FontSize="14" FontWeight="Bold"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                          <TextBlock Text="+"
                                     FontFamily="{DynamicResource GridFontFamily}" FontSize="14" FontWeight="Bold"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Panel>
                      </Border>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <!-- File-type icon: shown for files, collapsed for packages so the package name flows
                     tight against the chevron. -->
                <Image Source="{Binding Name, Converter={StaticResource FileTypeIconConverter}}"
                       Width="16" Height="16" Margin="2,0,6,0" VerticalAlignment="Center"
                       IsVisible="{Binding !IsPackageRow}" />
                <TextBlock Classes="pkg-name"
                           Classes.package-row="{Binding IsPackageRow}"
                           Text="{Binding Name}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Padding="4,0" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <!-- Package-row rename editor (F2 / click the current cell). Files never enter edit — the
               BeginningEdit guard cancels them (a file's Name is the real filename the hosters receive).
               OneWay like the Order editor: the CellEditEnding handler routes the typed text through
               RenamePackageCommand, so blank/unchanged input is dropped instead of written through. -->
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Name, Mode=OneWay}" VerticalContentAlignment="Center" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{loc:Loc Uploads_Col_Size}" Width="120"
                                ClipboardContentBinding="{Binding Size, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Package rows show [N] file count first, like JD2. -->
                <TextBlock Text="{Binding FileCount, StringFormat='[{0}]'}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"
                           IsVisible="{Binding IsPackageRow}" />
                <TextBlock Text="{Binding Size, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTemplateColumn Header="{loc:Loc Uploads_Col_Hoster}" Width="120"
                                ClipboardContentBinding="{Binding HosterDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{Binding HosterDisplay, Converter={StaticResource HosterIconConverter}}"
                       Width="18" Height="18" Margin="0,0,6,0" />
                <TextBlock Text="{Binding HosterDisplay}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- AccountDisplay is on both Package and PackageFile rows (like HosterDisplay). Rule 32 OneWay. -->
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_Account}"
                            Binding="{Binding AccountDisplay, Mode=OneWay}"
                            ClipboardContentBinding="{Binding AccountDisplay}"
                            Width="130" />

        <DataGridTemplateColumn Header="{loc:Loc Uploads_Col_Status}" Width="140"
                                ClipboardContentBinding="{Binding State, Converter={StaticResource FileStateConverter}, TargetNullValue=''}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{Binding State, Converter={StaticResource FileStateIconConverter}}"
                       Width="14" Height="14" Margin="0,0,4,0" />
                <TextBlock Text="{Binding State, Converter={StaticResource FileStateConverter}, TargetNullValue=''}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="{loc:Loc Uploads_Col_Speed}"
                            Binding="{Binding Speed, Converter={StaticResource ByteUnitConverter}, TargetNullValue='', Mode=OneWay}"
                            ClipboardContentBinding="{Binding Speed, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}"
                            Width="90" />
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_ETA}"
                            Binding="{Binding TimeRemaining, Converter={StaticResource TimeSpanConverter}, TargetNullValue='', Mode=OneWay}"
                            ClipboardContentBinding="{Binding TimeRemaining, Converter={StaticResource TimeSpanConverter}, TargetNullValue=''}"
                            Width="80" />
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_BytesLoaded}"
                            Binding="{Binding BytesLoaded, Converter={StaticResource ByteUnitConverter}, TargetNullValue='', Mode=OneWay}"
                            ClipboardContentBinding="{Binding BytesLoaded, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}"
                            Width="100" />
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_BytesRemaining}"
                            Binding="{Binding BytesRemaining, Converter={StaticResource ByteUnitConverter}, TargetNullValue='', Mode=OneWay}"
                            ClipboardContentBinding="{Binding BytesRemaining, Converter={StaticResource ByteUnitConverter}, TargetNullValue=''}"
                            Width="110" />

        <DataGridTemplateColumn Header="{loc:Loc Uploads_Col_Progress}" Width="140"
                                ClipboardContentBinding="{Binding Progress, StringFormat='{}{0:0.0}%', TargetNullValue=''}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <!-- Rule 35: WPF's ActualWidth -> Avalonia Bounds.Width; the ElementName binding resolves
                   inside this CellTemplate's name scope (PGrid is the template root). ProgressWidthConverter
                   is unchanged; the MultiBinding is read-only (IMultiValueConverter has no ConvertBack). -->
              <Grid x:Name="PGrid" Margin="2,3">
                <Border Background="{DynamicResource ProgressBarTrackBrush}" CornerRadius="1" Height="14" />
                <Border Background="{DynamicResource ProgressBarFillBrush}" CornerRadius="1"
                        HorizontalAlignment="Left" Height="14">
                  <Border.Width>
                    <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                      <Binding Path="Progress" />
                      <Binding Path="Bounds.Width" ElementName="PGrid" />
                    </MultiBinding>
                  </Border.Width>
                </Border>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                           Text="{Binding Progress, StringFormat='{}{0:0.0}%', TargetNullValue=''}" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="{loc:Loc Uploads_Col_Path}"
                            Binding="{Binding Path, Mode=OneWay}"
                            ClipboardContentBinding="{Binding Path}"
                            CellStyleClasses="path-cell"
                            Width="180" />
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_Added}"
                            Binding="{Binding AddedDate, Converter={StaticResource DateTimeConverter}, Mode=OneWay}"
                            ClipboardContentBinding="{Binding AddedDate, Converter={StaticResource DateTimeConverter}}"
                            Width="130" IsVisible="False" />
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_Finished}"
                            Binding="{Binding FinishedDate, Converter={StaticResource DateTimeConverter}, TargetNullValue='', Mode=OneWay}"
                            ClipboardContentBinding="{Binding FinishedDate, Converter={StaticResource DateTimeConverter}, TargetNullValue=''}"
                            Width="130" IsVisible="False" />
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_Started}"
                            Binding="{Binding StartedDate, Converter={StaticResource DateTimeConverter}, TargetNullValue='', Mode=OneWay}"
                            ClipboardContentBinding="{Binding StartedDate, Converter={StaticResource DateTimeConverter}, TargetNullValue=''}"
                            Width="130" IsVisible="False" />
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_ScheduledAt}"
                            Binding="{Binding ScheduledStartTime, Converter={StaticResource DateTimeConverter}, TargetNullValue='', Mode=OneWay}"
                            ClipboardContentBinding="{Binding ScheduledStartTime, Converter={StaticResource DateTimeConverter}, TargetNullValue=''}"
                            Width="130" IsVisible="False" />
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_Duration}"
                            Binding="{Binding Duration, Converter={StaticResource TimeSpanConverter}, TargetNullValue='', Mode=OneWay}"
                            ClipboardContentBinding="{Binding Duration, Converter={StaticResource TimeSpanConverter}, TargetNullValue=''}"
                            Width="80" IsVisible="False" />

        <!-- Order: display OrderDisplay + a OneWay editing TextBox. The editable commit path (BeginningEdit/
             CellEditEnding guards) is Task 11; the OneWay editing box is load-bearing so a TwoWay box can't
             fight SetOrderCommand by writing QueueOrder back. -->
        <!-- Task 11 resolves this column by its header ("Order") for the BeginningEdit/CellEditEnding guards:
             Avalonia's DataGridColumn is not a namescope StyledElement, so x:Name does not apply to it. -->
        <DataGridTemplateColumn Header="{loc:Loc Uploads_Col_Order}" Width="60"
                                IsVisible="False"
                                ClipboardContentBinding="{Binding OrderDisplay}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding OrderDisplay}" VerticalAlignment="Center" Margin="4,0,0,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <TextBox Text="{Binding QueueOrder, Mode=OneWay}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn Header="{loc:Loc Uploads_Col_SpeedLimit}"
                            Binding="{Binding EffectiveSpeedLimitKBps, Converter={StaticResource SpeedLimitConverter}, Mode=OneWay}"
                            ClipboardContentBinding="{Binding EffectiveSpeedLimitKBps, Converter={StaticResource SpeedLimitConverter}}"
                            Width="90" IsVisible="False" />

        <!-- Hash / URL: template columns so the value can be blanked on package rows (they aggregate none).
             WPF used a style-setter Text trigger; Avalonia hides the value TextBlock via IsVisible on file
             rows (recorded port decision). -->
        <DataGridTemplateColumn Header="{loc:Loc Uploads_Col_Hash}" Width="280" MinWidth="100"
                                IsVisible="False" SortMemberPath="FileHash"
                                ClipboardContentBinding="{Binding FileHash}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding FileHash}"
                         IsVisible="{Binding !IsPackageRow}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         FontFamily="Consolas, Cascadia Mono, Segoe UI"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{loc:Loc Uploads_Col_URL}" Width="200"
                                IsVisible="False" SortMemberPath="FileUrl"
                                ClipboardContentBinding="{Binding FileUrl}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding FileUrl}"
                         IsVisible="{Binding !IsPackageRow}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

        <!-- Error: display goes through SingleLineConverter so embedded newlines don't blow up the row
             height; the ClipboardContentBinding stays on the raw Error so copy gets the full server text. -->
        <DataGridTextColumn Header="{loc:Loc Uploads_Col_Error}"
                            Binding="{Binding Error, Converter={StaticResource SingleLineConverter}, Mode=OneWay}"
                            ClipboardContentBinding="{Binding Error}"
                            CellStyleClasses="error-cell"
                            Width="220" MinWidth="60" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Row 2: JD2 "Upload Overview" stats panel (mirror src/Views/UploadsView.xaml:646-791). rule 33:
         WPF Visibility+converter -> IsVisible; rule 31: IsCheckable -> ToggleType=CheckBox (+ IsChecked
         TwoWay); rule 10: MouseLeftButtonUp -> PointerReleased + a left-button guard (code-behind). The stats
         area's right-click ContextMenu is bridge-un-openable (ContextRequested vs a real PointerPressed), so
         the 12-toggle menu is headless-verified. -->
    <Border x:Name="OverviewPanel" Grid.Row="2"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            IsVisible="{Binding ShowUploadOverview}">
      <Grid RowDefinitions="Auto,Auto">
        <!-- Title bar: green chevron + title (toggles the stats row) + ✕ close button (hides the whole panel). -->
        <Border Grid.Row="0" Padding="4,2" Background="{DynamicResource OverviewTitleGradientBrush}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Width="16" Height="16" MinWidth="0" MinHeight="0" Margin="4,0,2,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0"
                    FontSize="10" Content="&#x2715;" Foreground="{DynamicResource OverviewCloseBrush}"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="{loc:Loc Uploads_Overview_CloseTip}"
                    Click="OverviewCloseButton_Click" />

            <!-- The chevron + title toggles IsOverviewExpanded on a LEFT release. Background=Transparent so the
                 whole strip is hit-testable (an unpainted panel is not). -->
            <StackPanel x:Name="OverviewToggle" Orientation="Horizontal" VerticalAlignment="Center"
                        Cursor="Hand" Background="Transparent"
                        PointerReleased="OverviewToggle_PointerReleased"
                        ToolTip.Tip="{loc:Loc Uploads_Overview_ToggleTip}">
              <TextBlock Text="{Binding OverviewToggleGlyph}" FontSize="10"
                         Foreground="{DynamicResource OverviewArrowBrush}" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Loc Uploads_Overview_Title}" FontSize="11" FontWeight="SemiBold"
                         Margin="4,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Stats area (collapses via the chevron). Right-click ContextMenu toggles the 12 fields (rule 31);
             each stat pair is IsVisible per its Show* flag (rule 33). -->
        <Border x:Name="OverviewStatsArea" Grid.Row="1"
                Background="{DynamicResource SurfaceAltBrush}" Padding="6,3,6,4"
                BorderBrush="{DynamicResource DataGridGridLineBrush}" BorderThickness="0,1,0,0"
                IsVisible="{Binding IsOverviewExpanded}">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{loc:Loc Uploads_Overview_Packages}" ToggleType="CheckBox" IsChecked="{Binding ShowPackages, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_Links}" ToggleType="CheckBox" IsChecked="{Binding ShowLinks, Mode=TwoWay}" />
              <Separator />
              <MenuItem Header="{loc:Loc Uploads_Overview_TotalBytes}" ToggleType="CheckBox" IsChecked="{Binding ShowTotalBytes, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_Uploadspeed}" ToggleType="CheckBox" IsChecked="{Binding ShowUploadspeed, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_BytesLoaded}" ToggleType="CheckBox" IsChecked="{Binding ShowBytesLoaded, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_RemainingBytes}" ToggleType="CheckBox" IsChecked="{Binding ShowRemainingBytes, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_Eta}" ToggleType="CheckBox" IsChecked="{Binding ShowEta, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_Elapsed}" ToggleType="CheckBox" IsChecked="{Binding ShowElapsed, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_FinishAt}" ToggleType="CheckBox" IsChecked="{Binding ShowFinishAt, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_RunningUploads}" ToggleType="CheckBox" IsChecked="{Binding ShowRunningUploads, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_OpenConnections}" ToggleType="CheckBox" IsChecked="{Binding ShowOpenConnections, Mode=TwoWay}" />
              <Separator />
              <MenuItem Header="{loc:Loc Uploads_Overview_FinishedLinks}" ToggleType="CheckBox" IsChecked="{Binding ShowFinishedLinks, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_SkippedLinks}" ToggleType="CheckBox" IsChecked="{Binding ShowSkippedLinks, Mode=TwoWay}" />
              <MenuItem Header="{loc:Loc Uploads_Overview_FailedLinks}" ToggleType="CheckBox" IsChecked="{Binding ShowFailedLinks, Mode=TwoWay}" />
            </ContextMenu>
          </Border.ContextMenu>

          <!-- Each stat is a label+value pair that collapses when toggled off (WrapPanel order verbatim from WPF). -->
          <WrapPanel Orientation="Horizontal">
            <StackPanel x:Name="PackagesStat" Classes="stat" IsVisible="{Binding ShowPackages}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_PackagesLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding PackageCount}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowTotalBytes}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_TotalBytesLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding TotalBytes}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowBytesLoaded}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_BytesLoadedLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding BytesLoaded}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowEta}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_EtaLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding Eta}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowElapsed}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_ElapsedLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding Elapsed}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowFinishAt}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_FinishAtLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding FinishAt}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowOpenConnections}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_OpenConnectionsLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding RunningUploads}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowLinks}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_LinksLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding FileCount}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowUploadspeed}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_UploadspeedLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding UploadSpeed}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowRemainingBytes}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_RemainingBytesLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding RemainingBytes}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowRunningUploads}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_RunningUploadsLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding RunningUploads}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowFinishedLinks}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_FinishedLinksLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding FinishedLinks}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowSkippedLinks}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_SkippedLinksLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding SkippedLinks}" />
            </StackPanel>
            <StackPanel Classes="stat" IsVisible="{Binding ShowFailedLinks}">
              <TextBlock Classes="stat-label" Text="{loc:Loc Uploads_Overview_FailedLinksLabel}" />
              <TextBlock Classes="stat-value" Text="{Binding FailedLinks}" />
            </StackPanel>
          </WrapPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Row 3: JD2-style filter bar. -->
    <Border Grid.Row="3" Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="6,4">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left"
                   Text="{loc:Loc Uploads_FilterLabel}"
                   Width="110" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,4,0" />
        <TextBox Text="{Binding FilterText}" FontSize="11"
                 VerticalContentAlignment="Center"
                 ToolTip.Tip="{loc:Loc Uploads_FilterTip}" />
      </DockPanel>
    </Border>

    <!-- Row 4: premium account footer link (mirror :811-833). rule 10: MouseLeftButtonUp -> PointerReleased. -->
    <Border Grid.Row="4" Background="{DynamicResource SurfaceMutedBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="8,3">
      <StackPanel x:Name="PremiumAccountLink" Orientation="Horizontal" Cursor="Hand"
                  Background="Transparent"
                  PointerReleased="PremiumAccountLink_PointerReleased">
        <TextBlock Text="&#x2795;" FontFamily="Segoe UI Symbol" FontSize="11"
                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{loc:Loc Uploads_FooterPremiumLink}" FontSize="11"
                   Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
