<!-- Avalonia port of the WPF Settings tab (src/Views/SettingsView.xaml). Task 4 lands the shell — the
     ListBox sidebar, the four SelectedCategoryIndex-switched panels, and the General + Upload panels;
     the Connection (proxies) and Accounts grids fill panels 2/3 in Tasks 5/6. Panel switching maps the
     WPF Style.Triggers DataTrigger (port rule 39) to IsVisible bound through StepVisibilityConverter.
     The SidebarItem/SectionTitle/SettingRow WPF keyed styles map to a ControlTheme + Classes selectors
     (port rule 40); the WPF SelectedValuePath/DisplayMemberPath combos become SelectedValueBinding/
     DisplayMemberBinding (§Reality-check #11/#18). No theme toggle here — the grid FONT is the only
     theme-adjacent control (§Reality-check #17). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CSUploader.Converters"
             xmlns:beh="clr-namespace:CSUploader.Behaviors"
             xmlns:vm="clr-namespace:CSUploader.ViewModels;assembly=CSUploader.Core"
             xmlns:dal="clr-namespace:CSUploader.Dal;assembly=CSUploader.Core"
             xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
             xmlns:coreloc="clr-namespace:CSUploader.Lib.Localization;assembly=CSUploader.Core"
             xmlns:upload="clr-namespace:CSUploader.Upload;assembly=CSUploader.Core"
             xmlns:v="clr-namespace:CSUploader.Views"
             x:Class="CSUploader.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource SurfaceBrush}">

  <UserControl.Resources>
    <conv:StepVisibilityConverter x:Key="StepVisibilityConverter" />
    <conv:ProxyTestOutcomeIconConverter x:Key="ProxyTestOutcomeIcon" />

    <!-- Accounts grid converters (Task 6). Read-only grid, so every data column stays OneWay (rule 32);
         the storage "Available" cell is the rule-34 MultiBinding site (StorageAvailableDisplayMulti). -->
    <conv:HosterIconConverter x:Key="HosterIconConverter" />
    <conv:AccountCheckStatusToColorConverter x:Key="AccountCheckStatusToColor" />
    <conv:ByteUnitConverter x:Key="ByteUnit" />
    <conv:DateTimeFormatConverter x:Key="DateTimeFormat" />
    <conv:InvertBoolConverter x:Key="InvertBool" />
    <conv:StringToFontFamilyConverter x:Key="StringToFontFamily" />
    <conv:StorageAvailableDisplayMultiConverter x:Key="StorageAvailableDisplayMulti" />

    <!-- SidebarItem ListBoxItem template (rule 40): flat hover/selected fills over the sidebar,
         applied via ItemContainerTheme. WPF's IsMouseOver/IsSelected triggers become :pointerover/
         :selected pseudo-class /template/ styles on the named Border. -->
    <ControlTheme x:Key="SidebarItemTheme" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="6,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
      </Style>
      <Style Selector="^:selected /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
      </Style>
    </ControlTheme>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- SectionTitle -> Classes="section-title" (rule 40; underlined accent heading). -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="TextDecorations" Value="Underline" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- SectionDesc -> Classes="section-desc" -->
    <Style Selector="TextBlock.section-desc">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="40,2,0,10" />
    </Style>

    <!-- SettingRow -> Classes="setting-row": a full-width JD2-style hover highlight so the user can
         tell which setting pairs with which description. Background=Transparent keeps the Grid
         hit-testable across its width (standing note a); :pointerover swaps the fill. -->
    <Style Selector="Grid.setting-row">
      <Setter Property="Margin" Value="40,0,0,2" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.setting-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
    </Style>

    <!-- SettingLabel -> Classes="setting-label" -->
    <Style Selector="TextBlock.setting-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- SettingInput -> Classes="setting-input" -->
    <Style Selector="TextBox.setting-input">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ── Proxy/accounts DataGrid chrome (Tasks 5/6). Header chrome mirrors the Phase 5 grids so the
         Settings grids read consistently with Uploaded/Logs; zebra maps AlternatingRowBackground
         (port rule 21) via the .alt class the DataGridZebraStriping behavior toggles. ── -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Padding" Value="6,5" />
    </Style>
    <Style Selector="DataGridRow.alt">
      <Setter Property="Background" Value="{DynamicResource DataGridAltRowBrush}" />
    </Style>

    <!-- Proxies grid opacity drop when Use-proxies is off (WPF DataGrid.Style DataTrigger → Opacity 0.45).
         A per-VALUE trigger can't be a plain selector, so bind a conditional class off !ProxiesEnabled
         (the grid's DataContext is the ConnectionManagerViewModel) and dim it here. The grid stays fully
         interactive so proxies can be curated before the master switch is flipped back on. -->
    <Style Selector="DataGrid.proxies-off">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Center the checkbox in the proxy "On" and accounts enabled columns (WPF
         DataGridCheckBoxColumn.ElementStyle). Padding/MinWidth=0 collapse the Fluent checkbox to its
         box width — otherwise the content-presenter padding + default MinWidth widen the control and
         HorizontalAlignment=Center leaves the box biased to the left of the cell. -->
    <Style Selector="DataGridCell.check-center CheckBox">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <!-- Monospace timestamp cells in the accounts grid so Added/Refreshed columns align (WPF's
         FontFamily="Consolas, Segoe UI" on those DataGridTextColumns; rule 20 → cell class). -->
    <Style Selector="DataGridCell.mono-cell TextBlock">
      <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
    </Style>

    <!-- Compact up/down priority buttons, styled like WPF's classic raised arrow buttons: the shared
         jd2 chrome (flat light-grey fill, thin border, near-square 1px corners — the same look the
         Add/Remove/Test All toolbar buttons use) at a compact 28x22 glyph size. Without the explicit
         brushes they fall back to the full Fluent Button look (medium-grey rounded fill), which reads
         too heavy next to WPF. MinWidth=0 stops them inheriting the Fluent Button MinWidth and widening.
         Hover/pressed override PART_ContentPresenter to beat the Fluent accent-highlight states. -->
    <Style Selector="Button.prio-btn">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource JD2ButtonBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JD2ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="1" />
    </Style>
    <Style Selector="Button.prio-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource JD2ButtonHoverBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JD2ButtonHoverBorderBrush}" />
    </Style>
    <Style Selector="Button.prio-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource JD2ButtonPressedBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource JD2ButtonPressedBorderBrush}" />
    </Style>

    <!-- Flatten the inline Type dropdown to WPF's classic combo look. Grounded in the Avalonia 11.3
         Fluent ComboBox template (parts Border#Background and PathIcon#DropDownGlyph; :pointerover/
         :pressed paint the whole-control Border#Background, and CornerRadius is TemplateBound to both
         border parts). Scoped via the grid-combo class so the General-tab and dialog combos keep the
         Fluent look. The rest state stays transparent/borderless (set inline) so it blends into the
         cell like WPF; here we (1) square the corners so any hover/focus box isn't the rounded Fluent
         pill, (2) replace the Fluent accent hover/press with a flat themed grey, and (3) shrink the
         chunky 12px chevron to a small 8px glyph tucked nearer the right edge. The 32px chevron COLUMN
         is a template literal and can't be narrowed without copying the whole template — left as-is. -->
    <Style Selector="ComboBox.grid-combo">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBox.grid-combo:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
    </Style>
    <Style Selector="ComboBox.grid-combo:pressed /template/ Border#Background">
      <Setter Property="Background" Value="{DynamicResource ContentAltBackgroundBrush}" />
    </Style>
    <Style Selector="ComboBox.grid-combo /template/ PathIcon#DropDownGlyph">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="140,1,*">

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <ListBox x:Name="Sidebar"
               Background="Transparent" BorderThickness="0"
               SelectedIndex="{Binding SelectedCategoryIndex}"
               ItemContainerTheme="{StaticResource SidebarItemTheme}"
               SelectionMode="Single" Padding="0" Margin="0">
        <ListBoxItem>
          <StackPanel HorizontalAlignment="Center" Width="120">
            <Image Source="{StaticResource StatusOkImage}" Width="32" Height="32"
                   HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="{loc:Loc Settings_Sidebar_General}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel HorizontalAlignment="Center" Width="120">
            <Image Source="{StaticResource StatusUploadingImage}" Width="32" Height="32"
                   HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="{loc:Loc Settings_Sidebar_Upload}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel HorizontalAlignment="Center" Width="120">
            <Image Source="{StaticResource ActionSpeedImage}" Width="32" Height="32"
                   HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="{loc:Loc Settings_Sidebar_Connection}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel HorizontalAlignment="Center" Width="120">
            <Image Source="{StaticResource AccountImage}" Width="32" Height="32"
                   HorizontalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="{loc:Loc Settings_Sidebar_Accounts}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>
    </Border>

    <Border Grid.Column="1" Background="{DynamicResource SidebarSeparatorBrush}" />

    <!-- Content panels (switched by SelectedCategoryIndex; rule 39). All four occupy Column 2 and
         overlap — IsVisible picks the live one. -->

    <!-- 0: General -->
    <ScrollViewer Grid.Column="2" x:Name="GeneralPanel"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource SurfaceBrush}" Padding="0"
                  IsVisible="{Binding SelectedCategoryIndex, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=0}">
      <StackPanel Margin="20,16,20,20" MaxWidth="900">
        <!-- Language. The picker takes effect immediately; already-open dialogs keep whatever
             language they captured at construction. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <PathIcon Data="{StaticResource SettingsLanguageGeometry}"
                    Foreground="{DynamicResource AccentBrush}"
                    Width="20" Height="20" VerticalAlignment="Center" Margin="2,0,10,0" />
          <TextBlock Text="{loc:Loc Settings_General_Language_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_General_Language_Desc}" />

        <!-- Every option ComboBox on this page follows the same shape, and this is the one place it is
             explained. ItemsSource and SelectedValue address THIS view-model and compile against the
             view's x:DataType. The two item-level bindings address a ROW, and ComboBox — unlike a
             DataGridTextColumn — does NOT infer its item type from a typed ItemsSource: left alone they
             resolve against SettingsViewModel and fail to build. So each names its own row type on the
             binding: the language list's is a record nested in this view-model
             (SettingsViewModel+LanguageEntry), the option lists' are closed generics
             (LocalizedOption<T> via x:TypeArguments). Both shapes are expressible, so none of these is
             reflection — an earlier revision assumed they weren't nameable and wrongly gave up on ten
             bindings. -->
        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_General_Language_Label}" Classes="setting-label" />
          <ComboBox Grid.Column="1" x:Name="LanguageCombo" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedValueBinding="{CompiledBinding Value, DataType={x:Type vm:SettingsViewModel+LanguageEntry}}"
                    DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type vm:SettingsViewModel+LanguageEntry}}"
                    SelectedValue="{Binding Language}"
                    FontSize="12" Padding="4,3" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
          <PathIcon Data="{StaticResource SettingsDeveloperGeometry}"
                    Foreground="{DynamicResource AccentBrush}"
                    Width="20" Height="20" VerticalAlignment="Center" Margin="2,0,10,0" />
          <TextBlock Text="{loc:Loc Settings_General_Developer_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_General_Developer_Desc}" />

        <Grid Classes="setting-row">
          <CheckBox Content="{loc:Loc Settings_General_UseMockServer}"
                    IsChecked="{Binding UseMockServer}" VerticalAlignment="Center" />
        </Grid>

        <!-- Grid appearance (font for Uploads / Uploaded tabs) -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
          <PathIcon Data="{StaticResource SettingsGridAppearanceGeometry}"
                    Foreground="{DynamicResource AccentBrush}"
                    Width="20" Height="20" VerticalAlignment="Center" Margin="2,0,10,0" />
          <TextBlock Text="{loc:Loc Settings_General_GridAppearance_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_General_GridAppearance_Desc}" />

        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_General_GridFont}" Classes="setting-label" />
          <ComboBox Grid.Column="1" x:Name="FontCombo" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding GridFontFamilyOptions}"
                    SelectedItem="{Binding GridFontFamily}"
                    FontSize="12" Padding="4,3">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <!-- Two-column row: the font's name in the default UI font (so CJK/Arabic-only fonts
                     don't render their English name as boxes) plus a small "AaBb 123" sample in the
                     actual font as a preview. -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding}" />
                  <TextBlock Grid.Column="1" Text="AaBb 123"
                             FontFamily="{Binding Converter={StaticResource StringToFontFamily}}"
                             Margin="12,0,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_General_GridFontSize}" Classes="setting-label" />
          <TextBox Grid.Column="1" HorizontalAlignment="Stretch"
                   Text="{Binding GridFontSize, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                   Classes="setting-input"
                   HorizontalContentAlignment="Right" />
        </Grid>

        <!-- Window behaviour (minimize / close -> tray) -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
          <PathIcon Data="{StaticResource SettingsWindowBehaviourGeometry}"
                    Foreground="{DynamicResource AccentBrush}"
                    Width="20" Height="20" VerticalAlignment="Center" Margin="2,0,10,0" />
          <TextBlock Text="{loc:Loc Settings_General_WindowBehaviour_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_General_WindowBehaviour_Desc}" />

        <Grid Classes="setting-row">
          <CheckBox Content="{loc:Loc Settings_General_MinimizeToTray}"
                    IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center" />
        </Grid>

        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_General_CloseAction}" Classes="setting-label" />
          <ComboBox Grid.Column="1" x:Name="CloseActionCombo" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding CloseActionOptions}"
                    SelectedValueBinding="{CompiledBinding Value, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:CloseAction}}"
                    DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:CloseAction}}"
                    SelectedValue="{Binding CloseAction}"
                    FontSize="12" Padding="4,3" />
        </Grid>

        <!-- Notifications -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
          <PathIcon Data="{StaticResource SettingsNotificationsGeometry}"
                    Foreground="{DynamicResource AccentBrush}"
                    Width="20" Height="20" VerticalAlignment="Center" Margin="2,0,10,0" />
          <TextBlock Text="{loc:Loc Settings_General_Notifications_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_General_Notifications_Desc}" />

        <Grid Classes="setting-row">
          <CheckBox Content="{loc:Loc Settings_General_ShowCompletionToasts}"
                    IsChecked="{Binding ShowCompletionToasts}" VerticalAlignment="Center" />
        </Grid>

        <!-- Off means the app opens straight away: no splash, nothing asked before it appears. It
             does NOT mean no check - a quiet one runs just after the window appears, so an installed
             build still reports an update in the title bar and Help -> Install Update still installs
             it. This hides the interruption, not the feature; the six-hourly poll is unaffected. -->
        <Grid Classes="setting-row">
          <CheckBox Content="{loc:Loc Settings_General_CheckForUpdatesAtStartup}"
                    IsChecked="{Binding CheckForUpdatesAtStartup}" VerticalAlignment="Center" />
        </Grid>

        <!-- What to DO with what that check finds - a separate question, so a separate box. Bound
             IsEnabled rather than IsVisible: a row that vanishes takes its own explanation with it,
             and someone who unticked the box above should still be able to see what they have
             switched off. Indented one step to show it belongs to the row above; the stored value
             survives being greyed out, because turning the check back on should restore the choice
             the user last made rather than silently reset it. -->
        <Grid Classes="setting-row" Margin="60,0,0,2">
          <CheckBox Content="{loc:Loc Settings_General_AutoInstallUpdatesAtStartup}"
                    IsChecked="{Binding AutoInstallUpdatesAtStartup}"
                    IsEnabled="{Binding CheckForUpdatesAtStartup}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Confirmation prompts -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
          <PathIcon Data="{StaticResource SettingsConfirmationGeometry}"
                    Foreground="{DynamicResource AccentBrush}"
                    Width="20" Height="20" VerticalAlignment="Center" Margin="2,0,10,0" />
          <TextBlock Text="{loc:Loc Settings_General_ConfirmationPrompts_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_General_ConfirmationPrompts_Desc}" />

        <ItemsControl x:Name="ConfirmationPromptsList" ItemsSource="{Binding ConfirmationPrompts}" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <!-- setting-row gives each prompt the same full-width hover highlight (and 40px indent). -->
              <Grid Classes="setting-row">
                <CheckBox IsChecked="{Binding AskAgain}"
                          Content="{Binding Label}"
                          VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Database — destructive cleanup, kept last so the user scrolls past the everyday settings. -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
          <PathIcon Data="{StaticResource SettingsDatabaseGeometry}"
                    Foreground="{DynamicResource AccentBrush}"
                    Width="20" Height="20" VerticalAlignment="Center" Margin="2,0,10,0" />
          <TextBlock Text="{loc:Loc Settings_General_Database_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_General_Database_Desc}" />

        <Grid Margin="40,4,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Width="120" Classes="jd2"
                    Command="{Binding ClearDatabaseCommand}"
                    Content="{loc:Loc Settings_General_Database_BtnClear}" />
            <Button Width="120" Margin="8,0,0,0" Classes="jd2"
                    Command="{Binding ClearLogsCommand}"
                    Content="{loc:Loc Settings_General_Database_BtnClearLogs}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- 1: Upload -->
    <ScrollViewer Grid.Column="2" x:Name="UploadPanel"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource SurfaceBrush}" Padding="0"
                  IsVisible="{Binding SelectedCategoryIndex, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">
      <StackPanel Margin="20,16,20,20" MaxWidth="900">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <Image Source="{StaticResource StatusRunningImage}" Width="24" Height="24"
                 VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="{loc:Loc Settings_Upload_Mgmt_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_Upload_Mgmt_Desc}" />

        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_MaxConcurrent}" Classes="setting-label" />
          <TextBox Grid.Column="1" HorizontalAlignment="Stretch"
                   Text="{Binding MaxConcurrentUploadJobs, UpdateSourceTrigger=LostFocus}" Classes="setting-input" HorizontalContentAlignment="Right" />
        </Grid>

        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_MaxParallelParts}" Classes="setting-label"
                     ToolTip.Tip="{loc:Loc Settings_Upload_MaxParallelPartsTip}" />
          <TextBox Grid.Column="1" HorizontalAlignment="Stretch"
                   Text="{Binding MaxParallelPartsPerFile, UpdateSourceTrigger=LostFocus}" Classes="setting-input"
                   HorizontalContentAlignment="Right" />
        </Grid>

        <Grid Classes="setting-row" ColumnDefinitions="*,Auto,252">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_MaxPerHoster}" Classes="setting-label" />
          <CheckBox Grid.Column="1" IsChecked="{Binding MaxUploadsPerHostEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Grid.Column="2" HorizontalAlignment="Stretch"
                   Text="{Binding MaxUploadsPerHost, UpdateSourceTrigger=LostFocus}" Classes="setting-input"
                   IsEnabled="{Binding MaxUploadsPerHostEnabled}" HorizontalContentAlignment="Right" />
        </Grid>

        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_RemoveFinished}" Classes="setting-label" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding RemoveFinishedUploadsOptions}"
                    SelectedValueBinding="{CompiledBinding Value, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:RemoveFinishedUploadsMode}}"
                    DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:RemoveFinishedUploadsMode}}"
                    SelectedValue="{Binding RemoveFinishedUploads}"
                    FontSize="12" Padding="4,3" />
        </Grid>

        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_IfFileExists}" Classes="setting-label" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding IfFileExistsOptions}"
                    SelectedValueBinding="{CompiledBinding Value, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:IfFileExistsBehavior}}"
                    DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:IfFileExistsBehavior}}"
                    SelectedValue="{Binding IfFileExists}"
                    FontSize="12" Padding="4,3" />
        </Grid>

        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_MaxCpuJobs}" Classes="setting-label" />
          <TextBox Grid.Column="1" HorizontalAlignment="Stretch"
                   Text="{Binding MaxConcurrentCPUJobs, UpdateSourceTrigger=LostFocus}" Classes="setting-input" HorizontalContentAlignment="Right" />
        </Grid>

        <Grid Classes="setting-row" ColumnDefinitions="*,Auto,252">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_SpeedLimit}" Classes="setting-label" />
          <CheckBox Grid.Column="1" IsChecked="{Binding SpeedLimitEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Grid.Column="2" HorizontalAlignment="Stretch"
                   Text="{Binding SpeedLimitValue, UpdateSourceTrigger=LostFocus}" Classes="setting-input"
                   IsEnabled="{Binding SpeedLimitEnabled}" HorizontalContentAlignment="Right" />
        </Grid>

        <!-- Autostart Uploads -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
          <Image Source="{StaticResource StatusUploadingImage}" Width="24" Height="24"
                 VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="{loc:Loc Settings_Upload_Autostart_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_Upload_Autostart_Desc}" />

        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_Autostart}" Classes="setting-label" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding AutostartUploadsOptions}"
                    SelectedValueBinding="{CompiledBinding Value, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:AutostartUploadsMode}}"
                    DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:AutostartUploadsMode}}"
                    SelectedValue="{Binding AutostartUploads}"
                    FontSize="12" Padding="4,3" />
        </Grid>

        <!-- Upload Wizard -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,2">
          <Image Source="{StaticResource StatusUploadingImage}" Width="24" Height="24"
                 VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="{loc:Loc Settings_Upload_Wizard_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_Upload_Wizard_Desc}" />

        <!-- Only the mode the hoster step OPENS on. The wizard's own filter still moves freely, and
             its "Clear filter" returns to Both regardless of what is chosen here. -->
        <Grid Classes="setting-row" ColumnDefinitions="*,360">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_WizardHosterFilter}" Classes="setting-label" />
          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding WizardHosterAccountFilterOptions}"
                    SelectedValueBinding="{CompiledBinding Value, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:HosterAccountFilter}}"
                    DisplayMemberBinding="{CompiledBinding Label, DataType={x:Type coreloc:LocalizedOption, x:TypeArguments=upload:HosterAccountFilter}}"
                    SelectedValue="{Binding WizardHosterAccountFilter}"
                    FontSize="12" Padding="4,3" />
        </Grid>

        <!-- Where "Add files…" / "Add folder…" open. Empty is the default and means "reopen where I
             last was", so there is no mode control to set — the box being empty IS the mode. The
             tooltip carries that, since a blank path box otherwise looks merely unset. -->
        <!-- Columns sum to 360 so the box's LEFT edge lines up with every other setting row's
             control, which all sit in a single 360px column. The button's 8px gap has to come out
             of that 360, not be added to it — 272+80 plus an 8px margin pushed the whole block 8px
             right of its neighbours, which is exactly how far off it looked. -->
        <Grid Classes="setting-row" ColumnDefinitions="*,272,88"
              ToolTip.Tip="{loc:Loc Settings_Upload_DefaultUploadDirectoryTip}">
          <TextBlock Grid.Column="0" Text="{loc:Loc Settings_Upload_DefaultUploadDirectory}" Classes="setting-label" />
          <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Classes="setting-input"
                   Text="{Binding DefaultUploadDirectory, UpdateSourceTrigger=LostFocus}"
                   Watermark="{loc:Loc Settings_Upload_DefaultUploadDirectory_Watermark}" />
          <Button Grid.Column="2" Content="{loc:Loc Common_Browse}" Margin="8,0,0,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding BrowseForDefaultUploadDirectoryCommand}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- 2: Connection Manager (editable proxies grid). Its CONTENT runs on the ConnectionManagerViewModel,
         reached via the parent Window's MainViewModel (the SettingsView's own DataContext is the
         SettingsViewModel); §Reality-check #19.

         The Grid itself deliberately does NOT override DataContext — each of its three row children
         carries the ConnectionManagerViewModel instead. That looks like duplication and is load-bearing:
         this panel's visibility belongs to the SettingsViewModel, so with the override here IsVisible had
         to reach back up as `$visualParent[UserControl].DataContext.SelectedCategoryIndex`, and that
         explicit DataContext hop is evaluated BEFORE the DataContext arrives — MainWindow hosts this view
         as <views:SettingsView DataContext="{Binding SettingsViewModel}" /> inside a TabItem, so it is in
         the visual tree first. Result: two "'Value is null.' (Grid #ConnectionPanel)" binding errors on
         every startup. Leaving the Grid on the inherited SettingsViewModel lets IsVisible bind straight to
         SelectedCategoryIndex with no hop to be null — which is exactly how every sibling panel here works,
         and why none of them ever logged this.

         Rule 32 is PER-GRID and THIS grid is the exception: the Host/Port/User/Password
         DataGridTextColumns, the Enabled DataGridCheckBoxColumn and the Type template ComboBox ALL stay
         TWO-WAY (rule 37) — a blanket OneWay would silently drop every edit. -->
    <Grid Grid.Column="2" x:Name="ConnectionPanel"
          Background="{DynamicResource SurfaceBrush}"
          RowDefinitions="Auto,*,Auto"
          IsVisible="{Binding SelectedCategoryIndex, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">

      <!-- The three row children each carry the ConnectionManagerViewModel — see the Grid's comment.
           Only the ACQUISITION is unknowable: it reaches through the ancestor WINDOW's untyped
           DataContext, whose runtime type varies by host (MainWindow's MainViewModel in production,
           plain test doubles in the headless suites), so no cast would be truthful — hence an explicit
           {ReflectionBinding} for that one hop on each of the three. What it yields is always a
           ConnectionManagerViewModel, so the subtree declares it and everything below compiles. -->
      <StackPanel Grid.Row="0" Margin="20,16,20,0"
                  x:DataType="vm:ConnectionManagerViewModel"
                  DataContext="{ReflectionBinding DataContext.ConnectionManagerViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <Image Source="{StaticResource ActionSpeedImage}" Width="24" Height="24"
                 VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="{loc:Loc Settings_Conn_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Text="{loc:Loc Settings_Conn_Desc}" />
        <CheckBox Content="{loc:Loc Settings_Conn_UseProxies}"
                  IsChecked="{Binding ProxiesEnabled}"
                  ToolTip.Tip="{loc:Loc Settings_Conn_UseProxiesTip}"
                  Margin="0,8,0,0" />
        <CheckBox Content="{loc:Loc Settings_Conn_AutoDisable}"
                  IsChecked="{Binding AutoDisableFailingProxies}"
                  ToolTip.Tip="{loc:Loc Settings_Conn_AutoDisableTip}"
                  Margin="0,4,0,0" />
        <CheckBox Content="{loc:Loc Settings_Conn_AllowInvalidCert}"
                  IsChecked="{Binding AllowInvalidServerCertificates}"
                  ToolTip.Tip="{loc:Loc Settings_Conn_AllowInvalidCertTip}"
                  Margin="0,4,0,0" />
      </StackPanel>

      <!-- The grid dims (Opacity 0.45, via the proxies-off conditional class) when Use-proxies is off but
           stays interactive so proxies can be curated before flipping the master switch back on. -->
      <DataGrid x:Name="ProxyGrid" Grid.Row="1" Margin="20,8,20,8"
                x:DataType="vm:ConnectionManagerViewModel"
                DataContext="{ReflectionBinding DataContext.ConnectionManagerViewModel, RelativeSource={RelativeSource AncestorType=Window}}"
                Classes.proxies-off="{Binding !ProxiesEnabled}"
                ItemsSource="{Binding Proxies}"
                AutoGenerateColumns="False"
                SelectionMode="Extended"
                HeadersVisibility="Column"
                GridLinesVisibility="All"
                BorderThickness="0"
                Background="{DynamicResource SurfaceBrush}"
                HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                VerticalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                beh:DataGridZebraStriping.IsEnabled="True"
                beh:DataGridSelectionBehaviors.ClearSelectionOnEmptyClick="True"
                beh:DataGridSelectionBehaviors.SelectRowOnRightClick="True">

        <!-- Row context menu (rules 18/19): commands bind through the ContextMenu's inherited DataContext
             (the grid's ConnectionManagerViewModel); the SelectedItems-carrying parameters (Test / Remove /
             Export-selected) are assigned in code-behind. Unlike the Uploaded menu this one is NOT suppressed
             on whitespace — Opening instead hides the row-only items (WPF ProxyGrid_ContextMenuOpening). -->
        <DataGrid.ContextMenu>
          <ContextMenu Opening="ProxyGrid_ContextMenuOpening">
            <MenuItem x:Name="ProxyContextTestItem"
                      Header="{loc:Loc Settings_Conn_Context_Test}"
                      Command="{Binding TestCommand}" />
            <MenuItem x:Name="ProxyContextRemoveItem"
                      Header="{loc:Loc Settings_Conn_Context_Remove}"
                      InputGesture="Delete"
                      Command="{Binding RemoveSelectedCommand}" />
            <Separator x:Name="ProxyContextRowSeparator" />
            <MenuItem Header="{loc:Loc Settings_Conn_Btn_Add}" Command="{Binding AddCommand}" />
            <Separator />
            <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import}">
              <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import_FromText}" Command="{Binding ImportFromTextCommand}" />
              <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import_FromFile}" Command="{Binding ImportFromFileCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export}">
              <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_AllToText}" Command="{Binding ExportAllToTextCommand}" />
              <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_AllToFile}" Command="{Binding ExportAllToFileCommand}" />
              <Separator />
              <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_OkToText}" Command="{Binding ExportOkToTextCommand}" />
              <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_OkToFile}" Command="{Binding ExportOkToFileCommand}" />
              <Separator x:Name="ProxyContextExportSelectedSeparator" />
              <MenuItem x:Name="ProxyContextExportSelectedToTextItem"
                        Header="{loc:Loc Settings_Conn_Btn_Export_SelectedToText}"
                        Command="{Binding ExportSelectedToTextCommand}" />
              <MenuItem x:Name="ProxyContextExportSelectedToFileItem"
                        Header="{loc:Loc Settings_Conn_Btn_Export_SelectedToFile}"
                        Command="{Binding ExportSelectedToFileCommand}" />
            </MenuItem>
          </ContextMenu>
        </DataGrid.ContextMenu>

        <DataGrid.Columns>
          <!-- On: two-way (rule 37), centered via the check-center cell class. ACCEPTED DIVERGENCE (prep
               item 10 — systemic Fluent narrow-header-clipping): the "On" label does NOT paint here. The
               label IS present (bridge-verified: the header TextBlock's Text == "On"), but the stock
               DataGridColumnHeader reserves ~45px of horizontal chrome (the sort-glyph area), so at 40px
               this column's content presenter measures to zero width and the label clips to nothing (Test at
               60px clips to "Te"; ≥~80px columns are fine). This is NOT a missing-content bug — an explicit
               TextBlock header clips identically. The fix is the Phase-9 one-shot metrics pass (min-widths /
               sort-glyph reclaim); per the plan this is LOGGED, not half-fixed per-column here. -->
          <DataGridCheckBoxColumn Header="{loc:Loc Settings_Conn_Col_On}"
                                  Binding="{Binding Enabled}"
                                  CellStyleClasses="check-center"
                                  Width="40" />
          <!-- Priority: up/down re-stamp row order (MoveUp/MoveDown on the grid's VM, row as parameter). -->
          <DataGridTemplateColumn Header="{loc:Loc Settings_Conn_Col_Priority}" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Button Classes="prio-btn" Content="&#x25B2;" Margin="0,0,2,0"
                          Command="{Binding $parent[DataGrid].DataContext.MoveUpCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{loc:Loc Settings_Conn_PriorityUpTip}" />
                  <Button Classes="prio-btn" Content="&#x25BC;"
                          Command="{Binding $parent[DataGrid].DataContext.MoveDownCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{loc:Loc Settings_Conn_PriorityDownTip}" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- Type: template ComboBox (no DataGridComboBoxColumn on 11.3.13), SelectedItem two-way (rule 37). -->
          <DataGridTemplateColumn Header="{loc:Loc Settings_Conn_Col_Type}" Width="100" SortMemberPath="Type">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox Classes="grid-combo"
                          ItemsSource="{x:Static vm:ConnectionManagerViewModel.ProxyTypeOptions}"
                          SelectedItem="{Binding Type}"
                          BorderThickness="0" Background="Transparent"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <!-- Host/Port/User/Password: DEFAULT (two-way) binding — rule 37, NO Mode=OneWay, no UpdateSourceTrigger. -->
          <DataGridTextColumn Header="{loc:Loc Settings_Conn_Col_Host}" Binding="{Binding Host}" Width="*" MinWidth="120" />
          <DataGridTextColumn Header="{loc:Loc Settings_Conn_Col_Port}" Binding="{Binding Port}" Width="80" />
          <DataGridTextColumn Header="{loc:Loc Settings_Conn_Col_User}" Binding="{Binding Username}" Width="120" />
          <DataGridTextColumn Header="{loc:Loc Settings_Conn_Col_Password}" Binding="{Binding Password}" Width="120" />
          <!-- Test/Status: read-only template columns (icon + trimmed status + Details button). -->
          <DataGridTemplateColumn Header="{loc:Loc Settings_Conn_Col_Test}" Width="60" SortMemberPath="TestOutcome" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Image Source="{Binding TestOutcome, Converter={StaticResource ProxyTestOutcomeIcon}}"
                       Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding TestStatus}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{loc:Loc Settings_Conn_Col_Status}" Width="280" SortMemberPath="TestStatus" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding TestStatus}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding TestStatus}" />
                  <Button Grid.Column="1"
                          Content="{loc:Loc Settings_Conn_Btn_Details}"
                          FontSize="11" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                          IsVisible="{Binding HasTestDetails}"
                          Command="{Binding $parent[DataGrid].DataContext.ShowTestDetailsCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Button bar: Add / Remove(▾) / Test All on the left; Import(▾) / Export(▾) on the right. The three
           split buttons open a MenuFlyout on click; their items route through code-behind Click handlers that
           resolve the grid's VM + live SelectedItems (the flyout lives in a separate popup namescope, so a
           cross-popup ElementName/SelectedItems binding is not reliable — same rule-19 reason the grid menu's
           params are code-behind). Add / Test All are plain buttons bound directly to the inherited VM. -->
      <DockPanel Grid.Row="2" Margin="20,0,20,16"
                 x:DataType="vm:ConnectionManagerViewModel"
                 DataContext="{ReflectionBinding DataContext.ConnectionManagerViewModel, RelativeSource={RelativeSource AncestorType=Window}}">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Classes="jd2" Margin="0,0,8,0">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import_FromText}" Click="ProxyImportFromText_Click" />
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Import_FromFile}" Click="ProxyImportFromFile_Click" />
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{loc:Loc Settings_Conn_Btn_Import}" />
              <TextBlock Text="&#x25BE;" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="jd2">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_AllToText}" Click="ProxyExportAllToText_Click" />
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_AllToFile}" Click="ProxyExportAllToFile_Click" />
                <Separator />
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_OkToText}" Click="ProxyExportOkToText_Click" />
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_OkToFile}" Click="ProxyExportOkToFile_Click" />
                <Separator />
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_SelectedToText}" Click="ProxyExportSelectedToText_Click" />
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_Export_SelectedToFile}" Click="ProxyExportSelectedToFile_Click" />
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{loc:Loc Settings_Conn_Btn_Export}" />
              <TextBlock Text="&#x25BE;" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Button Classes="jd2" Command="{Binding AddCommand}" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="+" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,4,0" />
              <TextBlock Text="{loc:Loc Settings_Conn_Btn_Add}" />
            </StackPanel>
          </Button>
          <Button Classes="jd2" Margin="0,0,6,0">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_RemoveSelected}" Click="ProxyRemoveSelected_Click" />
                <MenuItem Header="{loc:Loc Settings_Conn_Btn_RemoveFailed}" Click="ProxyRemoveFailed_Click" />
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2212;" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,4,0" />
              <TextBlock Text="{loc:Loc Settings_Conn_Btn_Remove}" />
              <TextBlock Text="&#x25BE;" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="jd2" Command="{Binding TestAllCommand}"
                  ToolTip.Tip="{loc:Loc Settings_Conn_Btn_TestAllTip}" Margin="0,0,6,0"
                  Content="{loc:Loc Settings_Conn_Btn_TestAll}" />
          <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Margin="12,0,0,0"
                     Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" />
        </StackPanel>
      </DockPanel>
    </Grid>

    <!-- 3: Accounts (READ-ONLY grid; rule 32 is PER-GRID and THIS grid is the read-only side — every data
         column binds OneWay). Its DataContext is the account manager split out of SettingsViewModel:
         Accounts / SelectedAccount / the account commands all live on AccountManagerViewModel now. The
         storage "Available" cell is the rule-34 MultiBinding site. Panel visibility keys off the PARENT
         view-model's SelectedCategoryIndex — reached through the typed $parent cast because this element's
         own DataContext is already the account manager. -->
    <Grid Grid.Column="2" x:Name="AccountsPanel"
          Background="{DynamicResource SurfaceBrush}"
          RowDefinitions="Auto,*,Auto,Auto"
          DataContext="{Binding AccountManager}"
          x:DataType="vm:AccountManagerViewModel"
          IsVisible="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectedCategoryIndex, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">

      <!-- Header -->
      <StackPanel Grid.Row="0" Margin="20,16,20,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
          <Image Source="{StaticResource AccountImage}" Width="24" Height="24"
                 VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="{loc:Loc Settings_Accounts_Title}" Classes="section-title" />
        </StackPanel>
        <Separator Margin="0,0,0,4" />
        <TextBlock Classes="section-desc" Margin="0,0,0,8" Text="{loc:Loc Settings_Accounts_Desc}" />
      </StackPanel>

      <!-- Read-only accounts grid. IsReadOnly=True (no cell editing); the ONE interactive control is the
           enabled checkbox in the leftmost template column (an intentional control in the CellTemplate, not a
           cell edit — so IsReadOnly does not gate it). Double-tap a row opens the Phase-5 EditAccountWindow
           through EditAccountCommand. Rows dim (Opacity 0.45) when the account is Disabled, via the scoped
           DataGrid.Styles binding below. -->
      <DataGrid x:Name="accountsGrid" Grid.Row="1" Margin="20,0,20,0"
                ItemsSource="{Binding Accounts}"
                SelectedItem="{Binding SelectedAccount}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Extended"
                HeadersVisibility="Column"
                CanUserResizeColumns="True"
                GridLinesVisibility="All"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}"
                Background="{DynamicResource ContentBackgroundBrush}"
                HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                VerticalGridLinesBrush="{DynamicResource BorderSubtleBrush}"
                DoubleTapped="AccountsGrid_DoubleTapped"
                beh:DataGridZebraStriping.IsEnabled="True"
                beh:DataGridSelectionBehaviors.ClearSelectionOnEmptyClick="True"
                beh:DataGridSelectionBehaviors.SelectRowOnRightClick="True">

        <!-- Per-row dim when Disabled (WPF DataGridRow DataTrigger → Opacity 0.45). Scoped to this grid so
             the proxy grid (items have no Disabled) is unaffected; the binding resolves against each row's
             item and follows recycling. The grid-scoped .alt override repaints the zebra rows with the
             accounts grid's ContentAltBackgroundBrush (WPF SettingsView.xaml:856 AlternatingRowBackground) —
             identical to the shared DataGridAltRowBrush in light, distinct in dark; grid-scoped outranks the
             UserControl-level DataGridRow.alt style. -->
        <DataGrid.Styles>
          <Style Selector="DataGridRow" x:DataType="dal:FileHosterLoginDto">
            <Setter Property="Opacity" Value="{Binding Disabled, Converter={x:Static v:SettingsView.DisabledToOpacity}}" />
          </Style>
          <Style Selector="DataGridRow.alt">
            <Setter Property="Background" Value="{DynamicResource ContentAltBackgroundBrush}" />
          </Style>
        </DataGrid.Styles>

        <!-- Row context menu (rules 18/19): commands bind through the inherited AccountManagerViewModel
             DataContext; the SelectedItems-carrying parameters (Refresh / Enable / Disable / Delete) are
             assigned in code-behind. The row-only items hide on a whitespace right-click
             (AccountsGrid_ContextMenuOpening), leaving only Add. Edit takes no parameter (operates on
             SelectedAccount). -->
        <DataGrid.ContextMenu>
          <ContextMenu Opening="AccountsGrid_ContextMenuOpening">
            <MenuItem x:Name="AccountsContextEditItem"
                      Header="{loc:Loc Settings_Accounts_Context_Edit}"
                      Command="{Binding EditAccountCommand}" />
            <MenuItem x:Name="AccountsContextRefreshItem"
                      Header="{loc:Loc Settings_Accounts_Context_Refresh}"
                      Command="{Binding RefreshSelectedAccountsCommand}" />
            <Separator x:Name="AccountsContextRowSeparator1" />
            <MenuItem x:Name="AccountsContextEnableItem"
                      Header="{loc:Loc Settings_Accounts_Context_Enable}"
                      Command="{Binding EnableSelectedAccountsCommand}" />
            <MenuItem x:Name="AccountsContextDisableItem"
                      Header="{loc:Loc Settings_Accounts_Context_Disable}"
                      Command="{Binding DisableSelectedAccountsCommand}" />
            <Separator x:Name="AccountsContextRowSeparator2" />
            <!-- No InputGesture: WPF's Accounts Delete item shows no gesture text, and the Delete key
                 is wired independently as a grid KeyBinding in code-behind (rule 24). -->
            <MenuItem x:Name="AccountsContextDeleteItem"
                      Header="{loc:Loc Settings_Accounts_Context_Delete}"
                      Command="{Binding RemoveSelectedAccountsCommand}" />
            <Separator x:Name="AccountsContextRowSeparator3" />
            <MenuItem Header="{loc:Loc Settings_Accounts_Btn_Add}" Command="{Binding AddAccountDialogCommand}" />
          </ContextMenu>
        </DataGrid.ContextMenu>

        <DataGrid.Columns>
          <!-- Enabled: template column (WPF has NO DataGridCheckBoxColumn here — the checkbox reflects the
               INVERSE of Disabled and its Click fans the toggle out to the whole selection). The "✓" header
               glyph is subject to the SAME accepted divergence as the proxy "On" header (prep item 10 —
               systemic Fluent narrow-header-clipping): at 30px the header content clips to zero width. The
               glyph is decorative (WPF shows a checkmark); the Phase-9 metrics pass reclaims the room. -->
          <DataGridTemplateColumn Header="&#x2713;" Width="30" CanUserResize="False"
                                  CellStyleClasses="check-center">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="dal:FileHosterLoginDto">
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsChecked="{Binding Disabled, Converter={StaticResource InvertBool}}"
                          Click="AccountEnabledCheckBox_Click" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Hoster: icon + name (read-only template). -->
          <DataGridTemplateColumn Header="{loc:Loc Settings_Accounts_Col_Hoster}" Width="180"
                                  x:DataType="dal:FileHosterLoginDto"
                                  SortMemberPath="FileHosterName"
                                  ClipboardContentBinding="{Binding FileHosterName}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="dal:FileHosterLoginDto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Image Source="{Binding FileHosterName, Converter={StaticResource HosterIconConverter}}"
                         Width="18" Height="18" Margin="0,0,6,0"
                         RenderOptions.BitmapInterpolationMode="HighQuality" />
                  <TextBlock Text="{Binding FileHosterName}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Status: trimmed StatusMessage recoloured by CheckStatus. The brush converter resolves against
               the active theme variant at conversion time (§Phase-4 prep 7): a live theme flip does NOT
               re-run it, but the cell repaints as the status changes or the row recycles — acceptable, and
               it reads correctly in both themes (verified in the bridge shots). -->
          <!-- No SortMemberPath: WPF's template Status column has no sort path either (header click is a
               no-op), so strict parity omits it. -->
          <DataGridTemplateColumn Header="{loc:Loc Settings_Accounts_Col_Status}" Width="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="dal:FileHosterLoginDto">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding StatusMessage}"
                           Foreground="{Binding CheckStatus, Converter={StaticResource AccountCheckStatusToColor}}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Username: OneWay (rule 32 — read-only; Avalonia's default TwoWay would push the string back on
               bind). Binds DisplayName, not Username, so key-only accounts (Ufile/NitroFlare, no username)
               show a masked key instead of a blank cell and several stay distinguishable. -->
          <DataGridTextColumn x:DataType="dal:FileHosterLoginDto" Header="{loc:Loc Settings_Accounts_Col_Username}"
                              Binding="{Binding DisplayName, Mode=OneWay}" Width="180" />

          <!-- Password: fixed masked cell (WPF ElementStyle sets Text="******"). Accounts never show the
               cleartext secret even in WPF — a template column with a literal string mask. -->
          <DataGridTemplateColumn Header="{loc:Loc Settings_Accounts_Col_Password}" Width="100">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="******" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <!-- Type: OneWay text (rule 32). -->
          <DataGridTextColumn x:DataType="dal:FileHosterLoginDto" Header="{loc:Loc Settings_Accounts_Col_Type}"
                              Binding="{Binding AccountType, Mode=OneWay}" Width="80" />

          <!-- Used: OneWay (rule 32 AND mandatory — ByteUnitConverter throws on ConvertBack, so a TwoWay
               bind would push default(long) back and blank the cell). ConverterParameter '-' renders the
               "unknown usage" placeholder for hosters that report no figure. -->
          <DataGridTextColumn x:DataType="dal:FileHosterLoginDto" Header="{loc:Loc Settings_Accounts_Col_Used}"
                              Binding="{Binding StorageUsedBytes, Converter={StaticResource ByteUnit}, ConverterParameter='-', Mode=OneWay}"
                              Width="90" />

          <!-- Available: the rule-34 MultiBinding site. VERDICT: MultiBinding-on-DataGridTextColumn.Binding
               WORKS on 11.3.13 (the column's GenerateElement just does TextBlock.Bind(TextProperty, IBinding),
               and MultiBinding is an IBinding) — no template-column fallback needed. Mode=OneWay per rule 34
               (read-only; the child bindings over the NOTIFYING StorageUsedBytes/StorageQuotaBytes keep it
               live as refresh updates the row in place). -->
          <DataGridTextColumn x:DataType="dal:FileHosterLoginDto" Header="{loc:Loc Settings_Accounts_Col_Available}" Width="110">
            <DataGridTextColumn.Binding>
              <MultiBinding Converter="{StaticResource StorageAvailableDisplayMulti}" Mode="OneWay">
                <Binding Path="StorageUsedBytes" />
                <Binding Path="StorageQuotaBytes" />
                <Binding Path="FileHosterName" />
              </MultiBinding>
            </DataGridTextColumn.Binding>
          </DataGridTextColumn>

          <!-- Added / Refreshed: OneWay monospace timestamps (DateTimeFormatConverter throws on ConvertBack →
               OneWay mandatory; blank when null). -->
          <DataGridTextColumn x:DataType="dal:FileHosterLoginDto" Header="{loc:Loc Settings_Accounts_Col_AddedAt}"
                              Binding="{Binding CreatedDateTime, Converter={StaticResource DateTimeFormat}, Mode=OneWay}"
                              CellStyleClasses="mono-cell" Width="140" />
          <DataGridTextColumn x:DataType="dal:FileHosterLoginDto" Header="{loc:Loc Settings_Accounts_Col_RefreshedAt}"
                              Binding="{Binding LastRefreshedDateTime, Converter={StaticResource DateTimeFormat}, Mode=OneWay}"
                              CellStyleClasses="mono-cell" Width="140" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- JD2-style bottom button bar: Add / Remove / Refresh. Remove takes the grid's live SelectedItems
           (assigned in code-behind, rule 19). -->
      <Border Grid.Row="2" Margin="20,0,20,0" Padding="6,6"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
              Background="{DynamicResource ButtonBarGradientBrush}">
        <StackPanel Orientation="Horizontal">
          <Button Classes="jd2" Command="{Binding AddAccountDialogCommand}" Margin="0,0,4,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="+" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="{loc:Loc Settings_Accounts_Btn_Add}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="AccountsRemoveButton" Classes="jd2"
                  Command="{Binding RemoveSelectedAccountsCommand}" Margin="0,0,4,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2212;" FontWeight="Bold" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Text="{loc:Loc Settings_Accounts_Btn_Remove}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="jd2" Command="{Binding RefreshAllAccountsCommand}">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource ActionRetryImage}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="{loc:Loc Settings_Accounts_Btn_Refresh}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <!-- Status message: neutral by default, InfoAccent while a verify is in flight (rule 40 — bound to
           IsCheckingAccount through a conditional class so it stays theme-live via DynamicResource). -->
      <TextBlock Grid.Row="3" Text="{Binding CheckAccountStatus}" FontSize="11" Margin="20,6,20,8"
                 TextWrapping="Wrap" HorizontalAlignment="Left"
                 Classes.checking="{Binding IsCheckingAccount}"
                 Foreground="{DynamicResource TextSecondaryBrush}">
        <TextBlock.Styles>
          <Style Selector="TextBlock.checking">
            <Setter Property="Foreground" Value="{DynamicResource InfoAccentBrush}" />
          </Style>
        </TextBlock.Styles>
      </TextBlock>

    </Grid>

  </Grid>
</UserControl>
