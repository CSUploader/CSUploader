<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        xmlns:views="clr-namespace:CSUploader.Views"
        xmlns:vm="clr-namespace:CSUploader.ViewModels;assembly=CSUploader.Core"
        x:Class="CSUploader.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1024" Height="800"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico">
  <Grid RowDefinitions="Auto,*">
    <Menu Grid.Row="0" Background="{DynamicResource SurfaceBrush}" FontSize="12">
      <MenuItem Header="{loc:Loc Main_Menu_File}">
        <MenuItem Header="{loc:Loc Main_Menu_File_Exit}" Click="MenuExit_Click" />
      </MenuItem>
      <MenuItem Header="{loc:Loc Main_Menu_View}">
        <MenuItem Header="{loc:Loc Main_Menu_View_UploadOverview}"
                  ToggleType="CheckBox"
                  IsChecked="{Binding UploadsViewModel.ShowUploadOverview, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="{Binding ThemeMenuLabel}" Command="{Binding ToggleThemeCommand}" />
      </MenuItem>
      <MenuItem Header="{loc:Loc Main_Menu_Help}">
        <MenuItem Header="{loc:Loc Main_Menu_Help_CheckForUpdates}" Click="MenuCheckForUpdates_Click" />
        <MenuItem Header="{loc:Loc Main_Menu_Help_InstallUpdate}"
                  Command="{Binding InstallUpdateCommand}"
                  IsEnabled="{Binding IsUpdateAvailable}" />
        <Separator />
        <MenuItem Header="{loc:Loc Main_Menu_Help_About}" Click="MenuAbout_Click" />
      </MenuItem>
    </Menu>

    <!-- Each view's DataContext is bound on its TabItem, not on the view. A DataContext binding follows the
         VISUAL parent, and the TabControl takes a deselected tab's view out of the visual tree, so a binding
         on the view turned its DataContext to null on every tab switch and back on return. Each grid then
         came back unselected and scrolled to the top — the Settings and Logs grids unsorted too — and every
         grid but History's got a new DataGridCollectionView, which subscribes to its collection for good.
         TabItems stay in the tab strip, so their bindings never break, and each view inherits a DataContext
         that stays put. -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="{loc:Loc Main_Tab_Uploads}" DataContext="{Binding UploadsViewModel}"><views:UploadsView /></TabItem>
      <TabItem Header="{loc:Loc Main_Tab_Uploaded}" DataContext="{Binding UploadedViewModel}"><views:UploadedView /></TabItem>
      <TabItem Header="{loc:Loc Main_Tab_Settings}" DataContext="{Binding SettingsViewModel}"><views:SettingsView /></TabItem>
      <TabItem Header="{loc:Loc Main_Tab_Logs}" DataContext="{Binding LogsViewModel}"><views:LogsView /></TabItem>
    </TabControl>
  </Grid>
</Window>
