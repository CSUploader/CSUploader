<!-- Avalonia port of the WPF Upload Wizard (src/Views/UploadWizardWindow.xaml). Task 7 lands the window
     shell, the step indicator, the 4-step nav bar (Back / Cancel / Next), and STEP 0 (the merged
     source-picker + files grid). Steps 1 (hosters) and 3 (start mode + DatePicker) arrive in Task 8; the
     Summary step 2 (custom Expander) in Task 9. Panel/step switching is rule 39 (StepVisibilityConverter,
     int==param -> IsVisible); the step-indicator weighting is StepFontConverter; the mode radios are the
     two-way EnumBool group (rule 8, its full exercise is Task 8). rule-33 visibility-converter sites become
     IsVisible bindings — the head has no bool-to-visibility converter. The wizard opens as a Window from the
     Uploads toolbar (Task 12); this task's standalone surface is the gallery WizardButton. The VM is
     DI-registered (Transient) and resolved from the container via App.Services (Phase 9 ledger fix d). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        xmlns:conv="clr-namespace:CSUploader.Converters"
        xmlns:beh="clr-namespace:CSUploader.Behaviors"
        x:Class="CSUploader.Views.UploadWizardWindow"
        Title="{loc:Loc Wizard_Title}"
        Width="850" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource SurfaceBrush}"
        Icon="/Assets/icon.ico">

  <Window.Resources>
    <conv:ByteUnitConverter x:Key="ByteUnitConverter" />
    <conv:StepVisibilityConverter x:Key="StepVisibilityConverter" />
    <conv:StepFontConverter x:Key="StepFontConverter" />
    <conv:EnumBoolConverter x:Key="EnumBoolConverter" />
    <conv:FileTypeIconConverter x:Key="FileTypeIconConverter" />
    <!-- Task 8: step 1's hoster-icon column + step 3's DatePicker. DateTimeOffsetConverter (Task 2) bridges
         the DatePicker's DateTimeOffset? SelectedDate to the VM's non-nullable DateTime ScheduledDate
         (rule 36); a stateless converter is harmless to instance per-window (Task 2 placement note). -->
    <conv:HosterIconConverter x:Key="HosterIconConverter" />
    <conv:DateTimeOffsetConverter x:Key="DateTimeOffsetConverter" />

    <!-- Step 2 Summary — the custom Expander re-template (rule 38). Task 2 arbitrated this against stock Fluent
         in the gallery and recorded the recipe; per Task 2's placement decision the PRODUCTION copy is authored
         view-local HERE (the WPF SummaryExpander/SummaryExpanderToggle are window-local, and the wizard Summary
         step is the single consumer — hoisting a one-consumer theme to a shared surface adds coupling without
         reuse). Verbatim from the pinned recipe: Avalonia's Expander has NO OnApplyTemplate / named-part lookup
         (ILSpy, Avalonia.Controls 11.3.18) — it drives content visibility purely via the :expanded pseudo-class,
         and IsExpanded is a TwoWay StyledProperty, so a free-form template works. The base HeaderedContentControl/
         ContentControl register PART_HeaderPresenter/PART_ContentPresenter, so those two presenters keep their
         part names. The chevron rotates via a :checked pseudo-class style (WPF Trigger IsChecked=False -> the
         Avalonia :checked style), the body shows via the :expanded style (WPF Trigger IsExpanded=True). -->
    <ControlTheme x:Key="SummaryExpanderToggleTheme" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Padding="6,4">
            <Path x:Name="Chevron" Width="8" Height="8" Stretch="Uniform"
                  Fill="{DynamicResource TextPrimaryBrush}"
                  Data="M 0,0 L 4,4 L 8,0 Z"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <RotateTransform Angle="-90" />
              </Path.RenderTransform>
            </Path>
          </Border>
        </ControlTemplate>
      </Setter>
      <!-- Collapsed (unchecked) -> chevron points right (-90, the template base); expanded (checked) -> down (0). -->
      <Style Selector="^:checked /template/ Path#Chevron">
        <Setter Property="RenderTransform">
          <RotateTransform Angle="0" />
        </Setter>
      </Style>
    </ControlTheme>

    <ControlTheme x:Key="SummaryExpanderTheme" TargetType="Expander">
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3">
            <Grid RowDefinitions="Auto,Auto">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Background="Transparent">
                <ToggleButton Theme="{StaticResource SummaryExpanderToggleTheme}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="2,0,4,0" />
                <ContentPresenter x:Name="PART_HeaderPresenter"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  VerticalAlignment="Center" />
              </StackPanel>
              <ContentPresenter x:Name="PART_ContentPresenter"
                                Grid.Row="1"
                                IsVisible="False"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="0" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:expanded /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>
  </Window.Resources>

  <!-- Step 1's "Add account…" affordance is a Classes="link" TextBlock (rule 28 — the Avalonia stand-in for
       the WPF Hyperlink): accent text, hand cursor, underline on hover; a left-button PointerReleased handler
       runs AddAccountForHosterCommand (mirrors EditAccountWindow's Details link). -->
  <Window.Styles>
    <Style Selector="TextBlock.link">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.link:pointerover">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <!-- Step 2 Summary capacity line: normally TextSecondaryBrush; red + bold when the checked files exceed the
         account's free space. WPF drove this with a Style.Triggers DataTrigger on IsOverCapacity; rule 40 maps
         it to a conditional class (Classes.capacity-over="{Binding IsOverCapacity}") whose style wins over the
         base Foreground. DynamicResource so it re-colors on a live theme flip. -->
    <Style Selector="TextBlock.capacity-over">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Grid header chrome, matching Uploads / History / Logs / Settings. The wizard's grids were the
         only ones that set none, so they fell through to Fluent's default header — a saturated blue bar
         that matched neither the pre-Avalonia app nor any other grid here. Window-level (like
         SettingsView's) so both the step-1 file list and the step-2 hoster list pick it up.
         DynamicResource so a live theme flip re-colors them. -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Padding" Value="6,5" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Step indicator -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <!-- The DirectorySource / FilesSource pair share step 0; only the active mode's label shows (rule 33). -->
        <TextBlock Text="{loc:Loc Wizard_Step_DirectorySource}" FontSize="13"
                   FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=0}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0"
                   IsVisible="{Binding IsDirectoryMode}" />
        <TextBlock Text="{loc:Loc Wizard_Step_FilesSource}" FontSize="13"
                   FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=0}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0"
                   IsVisible="{Binding IsFilesMode}" />
        <TextBlock Text="{loc:Loc Wizard_Step_FileHosters}" FontSize="13"
                   FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=1}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0" />
        <TextBlock Text="{loc:Loc Wizard_Step_Summary}" FontSize="13"
                   FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=2}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,30,0" />
        <TextBlock Text="{loc:Loc Wizard_Step_Start}" FontSize="13"
                   FontWeight="{Binding CurrentStep, Converter={StaticResource StepFontConverter}, ConverterParameter=3}"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </StackPanel>
    </Border>

    <!-- Step content -->
    <Grid Grid.Row="1" Margin="20,16,20,8">

      <!-- Step 0: source picker + file list (merged). IsSharedSizeScope lets the Package-title and Filter
           label columns share one width (SharedSizeGroup=WizStep0Label) so both input boxes line up. -->
      <Grid x:Name="Step0Panel" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
            Grid.IsSharedSizeScope="True"
            IsVisible="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=0}">

        <!-- Row 0: the two Add buttons. There is no Directory/Files MODE any more - a package routinely
             draws from more than one place, and under the old model picking a second folder silently
             discarded the first. Both buttons append to ONE list; the strip below says what came from
             where and lets any of it be taken back. Native pickers, so manual-only in a bridge session. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
          <Button x:Name="AddFoldersButton" Content="{loc:Loc Wizard_Step0_AddFolders}"
                  MinWidth="130" Padding="10,6" Command="{Binding AddFoldersCommand}" />
          <Button x:Name="AddFilesButton" Content="{loc:Loc Wizard_Step0_AddFiles}"
                  MinWidth="130" Padding="10,6" Margin="8,0,0,0" Command="{Binding AddFilesCommand}" />
          <TextBlock Text="{loc:Loc Wizard_Step0_DropHint}" FontSize="11" Margin="12,0,0,0"
                     VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Row 1: what has been added. Hidden until there is something, so an empty wizard stays quiet. -->
        <Border Grid.Row="1" x:Name="SourcesStrip" Margin="0,0,0,12" Padding="6,4" MaxHeight="110"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                IsVisible="{Binding HasSources}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="SourcesList" ItemsSource="{Binding Sources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,1">
                    <!-- Folder vs file, so a walked folder and a single picked file are told apart at a
                         glance. Vector paths, not a font glyph: MDL2 is Windows-only and renders as tofu
                         on Linux (what the step-1 padlock learned). -->
                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Margin="2,0,6,0"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Data="M1,3 A1,1 0 0 1 2,2 L5.5,2 L7,3.5 L14,3.5 A1,1 0 0 1 15,4.5 L15,13 A1,1 0 0 1 14,14 L2,14 A1,1 0 0 1 1,13 Z"
                          IsVisible="{Binding IsFolder}" />
                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform" Margin="2,0,6,0"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          Data="M3,1 L10,1 L13,4 L13,15 L3,15 Z M10,1 L10,4 L13,4"
                          IsVisible="{Binding !IsFolder}" />
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               ToolTip.Tip="{Binding Path}" />
                    <TextBlock Grid.Column="2" Text="{Binding FileCount}" FontSize="11" Margin="8,0,6,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Grid.Column="3" Padding="5,2" MinWidth="0" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="{loc:Loc Wizard_Step0_RemoveSource}"
                            Command="{Binding $parent[ItemsControl].DataContext.RemoveSourceCommand}"
                            CommandParameter="{Binding}">
                      <Path Width="9" Height="9" Stretch="Uniform"
                            Fill="{DynamicResource TextSecondaryBrush}"
                            Data="M1,2.4 L2.4,1 L8,6.6 L13.6,1 L15,2.4 L9.4,8 L15,13.6 L13.6,15 L8,9.4 L2.4,15 L1,13.6 L6.6,8 Z" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!-- Row 2: package title. Shared label column (WizStep0Label) aligns the box with the Filter box
             below; the trailing 88px spacer (Browse width 80 + its 8px margin) aligns the box's right edge
             with the directory textbox above. -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="WizStep0Label" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="88" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{loc:Loc Wizard_Step1_PackageTitleLabel}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" Text="{Binding PackageTitle}"
                   FontSize="12" Padding="4,3" VerticalContentAlignment="Center" />
        </Grid>

        <!-- Row 3: filter (directory mode only — files-mode users curated the list themselves) -->
        <Grid Grid.Row="3" Margin="0,0,0,8"
              IsVisible="{Binding IsDirectoryMode}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="WizStep0Label" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="88" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{loc:Loc Wizard_Step1_FilterLabel}" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" Text="{Binding FileFilter}"
                   FontSize="12" Padding="4,3" VerticalContentAlignment="Center" />
        </Grid>

        <!-- Row 4: bulk-action buttons. Select All / Deselect All stay directory-mode-only (a curated
             files-mode list doesn't benefit from "select everything I just picked"), but Remove is always
             available. RemoveSelectedFilesCommand's parameter = filesGrid.SelectedItems, assigned in code-
             behind (rule 19 — DataGrid.SelectedItems is not a bindable AvaloniaProperty). -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
          <Button Content="{loc:Loc Wizard_Step1_BtnSelectAll}" MinWidth="100" Padding="10,4"
                  IsVisible="{Binding IsDirectoryMode}"
                  Command="{Binding SelectAllCommand}" />
          <Button Content="{loc:Loc Wizard_Step1_BtnDeselectAll}" MinWidth="100" Padding="10,4" Margin="6,0,0,0"
                  IsVisible="{Binding IsDirectoryMode}"
                  Command="{Binding SelectNoneCommand}" />
          <Button x:Name="RemoveFilesButton" Content="{loc:Loc Wizard_Step1_BtnRemove}" MinWidth="100" Padding="10,4" Margin="6,0,0,0"
                  Command="{Binding RemoveSelectedFilesCommand}" />
        </StackPanel>

        <!-- Row 5: DataGrid of files. Grid is editable (default) so the include-checkbox column toggles; the
             File + Size columns are IsReadOnly. Row visibility follows FileEntry.IsVisible via the scoped
             DataGridRow style (§Reality-check #20 — same recycling-safe pattern the accounts grid uses for
             its Disabled dim). -->
        <DataGrid Grid.Row="5" x:Name="filesGrid" ItemsSource="{Binding Files}"
                  AutoGenerateColumns="False" SelectionMode="Extended"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  Background="{DynamicResource ContentBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  beh:DataGridSelectionBehaviors.ClearSelectionOnEmptyClick="True"
                  beh:DataGridSelectionBehaviors.SelectRowOnRightClick="True">
          <DataGrid.Styles>
            <!-- Filter hides a row by collapsing it (WPF DataGridRow DataTrigger IsVisible=False -> Collapsed).
                 Scoped to this grid, resolved against each row's FileEntry, and follows recycling. -->
            <Style Selector="DataGridRow">
              <Setter Property="IsVisible" Value="{Binding IsVisible}" />
            </Style>
            <!-- Selection checkbox: truly centered in its column. HorizontalAlignment=Center alone left the
                 box a few px left because the FluentTheme CheckBox (RootGrid ColumnDefinitions "20,*")
                 reserves its 8px content Padding to the right of the box even with no content; zero the
                 Padding/MinWidth so the control's width is just the 20px box, which then centers exactly. -->
            <Style Selector="DataGridCell.check-center CheckBox">
              <Setter Property="HorizontalAlignment" Value="Center" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="MinWidth" Value="0" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="35"
                                    CellStyleClasses="check-center" />
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step1_Col_File}" Width="*" IsReadOnly="True"
                                    SortMemberPath="RelativePath"
                                    ClipboardContentBinding="{Binding RelativePath}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{Binding RelativePath, Converter={StaticResource FileTypeIconConverter}}"
                           Width="16" Height="16" Margin="2,0,6,0" />
                    <TextBlock Text="{Binding RelativePath}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Mode=OneWay is load-bearing: Avalonia's DataGridTextColumn.Binding defaults to TwoWay and
                 writes the ConvertBack result back on bind even in a read-only column; ByteUnitConverter
                 throws on ConvertBack, which would blank FileEntry.Size (the UploadedView port gotcha). -->
            <DataGridTextColumn Header="{loc:Loc Wizard_Step1_Col_Size}"
                                Binding="{Binding Size, Converter={StaticResource ByteUnitConverter}, Mode=OneWay}"
                                Width="100" IsReadOnly="True" />
          </DataGrid.Columns>
        </DataGrid>

        <!-- Row 6: selection footer — live ticked-file count (left) + live total size (right). Both bind
             the VM's IsSelected-based stats (not Files.Count, which kept reading the same after unchecking
             rows) so the footer always agrees with what Finish actually queues. -->
        <Grid Grid.Row="6" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{loc:Loc Wizard_Step1_SelectedLabel}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="4,0,0,0" Text="{Binding SelectedFileCount, Mode=OneWay}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="4,0,0,0" Text="{loc:Loc Wizard_Step1_FilesUnit}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{loc:Loc Wizard_Step1_TotalSizeLabel}" />
            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="4,0,0,0" Text="{Binding SelectedTotalSizeDisplay, Mode=OneWay}" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Step 1: File Hosters (Task 8). Per-row enable checkbox + account association; the display
           columns are read-only (rule 32 — the row VM is only ever read here). rule-33 visibility-converter
           sites → IsVisible; the WPF DataTrigger-driven per-row !CanUse dim (+ tooltip) and the
           italic-when-no-saved-accounts hoster name become conditional-class bindings (rule 40). The grid
           is SelectionMode=Single with the ClearSelectionOnEmptyClick + SelectRowOnRightClick behaviors. -->
      <Grid x:Name="Step1Panel" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
            IsVisible="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=1}">

        <TextBlock Grid.Row="0" Text="{loc:Loc Wizard_Step2_Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="{loc:Loc Wizard_Step2_Desc}"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

        <!-- Filter bar. The list is ~80 hosters long, so it needs a way in: a name box and an
             anonymous-only toggle. The grid's ItemsSource is a DataGridCollectionView built in
             code-behind (the Uploads tab's pattern) — the filter is a VIEW concern, so a hoster that
             is ticked and then filtered out of sight still uploads, and the count on the right is
             what says so. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,220,Auto,*,Auto,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Text="{loc:Loc Wizard_Step2_FilterLabel}"
                     FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBox Grid.Column="1" x:Name="HosterFilterBox"
                   Text="{Binding HosterFilterText}"
                   Watermark="{loc:Loc Wizard_Step2_FilterWatermark}"
                   FontSize="11" Padding="6,3" VerticalContentAlignment="Center" />
          <CheckBox Grid.Column="2" IsChecked="{Binding AnonymousHostersOnly}"
                    Content="{loc:Loc Wizard_Step2_FilterAnonymous}"
                    FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                    ToolTip.Tip="{loc:Loc Wizard_Step2_FilterAnonymousTip}" />
          <TextBlock Grid.Column="4" Text="{Binding HosterFilterSummary}"
                     FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     IsVisible="{Binding IsHosterFilterActive}" />
          <Button Grid.Column="5" Command="{Binding ClearHosterFilterCommand}"
                  Content="{loc:Loc Wizard_Step2_FilterClear}"
                  FontSize="11" Padding="8,3" VerticalAlignment="Center"
                  IsVisible="{Binding IsHosterFilterActive}" />
        </Grid>

        <DataGrid Grid.Row="3" x:Name="fileHostersGrid"
                  AutoGenerateColumns="False" SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  VerticalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
                  Background="{DynamicResource ContentBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  beh:DataGridSelectionBehaviors.ClearSelectionOnEmptyClick="True"
                  beh:DataGridSelectionBehaviors.SelectRowOnRightClick="True">
          <DataGrid.Styles>
            <!-- Conditional classes bound to each row's FileHosterSelectionViewModel, scoped to this grid so
                 they reach the cell-template content (the same mechanism the step-0 check-center style uses).
                 .blocked = WPF's !CanUse Opacity=0.45 (+ the account-required tooltip); .no-accounts = WPF's
                 !HasAccounts FontStyle=Italic. -->
            <Style Selector="StackPanel.blocked">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="ToolTip.Tip" Value="{loc:Loc Wizard_Step2_AccountRequiredTooltip}" />
            </Style>
            <Style Selector="TextBlock.blocked">
              <Setter Property="Opacity" Value="0.45" />
            </Style>
            <Style Selector="TextBlock.no-accounts">
              <Setter Property="FontStyle" Value="Italic" />
              <!-- Italic glyphs lean past the advance width the layout measures, so the last letter's
                   overhang gets clipped at the TextBlock's right edge — visible as a missing final
                   character on names ending in e/d/o ("Wormhole" losing its e). Reserve a few pixels
                   for the lean. Set here, on the style that causes it, so the two travel together. -->
              <Setter Property="Padding" Value="0,0,4,0" />
            </Style>
          </DataGrid.Styles>
          <DataGrid.Columns>
            <!-- Use: the two-way enable checkbox when the row is usable, else an "account required" padlock
                 (rule 33 both ways — IsVisible=CanUse / IsVisible=!CanUse). The padlock is a vector Path, NOT
                 the WPF head's Segoe MDL2 Assets glyph: MDL2 is a Windows-only font, so on Linux the glyph
                 rendered as a missing-glyph box (tofu). The checkbox zeroes Padding/MinWidth so the box itself
                 centres exactly (Fluent reserves 8px content padding right of the 20px box even with no
                 content — the step-0 check-center fix), aligning it with the centred padlock. -->
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step2_Col_Use}" Width="42" SortMemberPath="Use">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding Use}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Padding="0" MinWidth="0"
                              IsVisible="{Binding CanUse}" />
                    <Path x:Name="UseLockGlyph"
                          Data="M2.75,7 L2.75,4.5 A3.25,3.25 0 0 1 9.25,4.5 L9.25,7 L7.75,7 L7.75,4.5 A1.75,1.75 0 0 0 4.25,4.5 L4.25,7 Z M1,8.5 A1.5,1.5 0 0 1 2.5,7 L9.5,7 A1.5,1.5 0 0 1 11,8.5 L11,12.5 A1.5,1.5 0 0 1 9.5,14 L2.5,14 A1.5,1.5 0 0 1 1,12.5 Z"
                          Width="11" Height="13" Stretch="Uniform"
                          Fill="{DynamicResource TextSecondaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          IsVisible="{Binding !CanUse}"
                          ToolTip.Tip="{loc:Loc Wizard_Step2_AccountRequiredTooltip}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- FileHoster: icon + name; dimmed with a tooltip when !CanUse, italic when no saved accounts. -->
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step2_Col_FileHoster}" Width="180" IsReadOnly="True"
                                    SortMemberPath="FileHosterName"
                                    ClipboardContentBinding="{Binding FileHosterName}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                              Classes.blocked="{Binding !CanUse}">
                    <Image Source="{Binding FileHosterName, Converter={StaticResource HosterIconConverter}}"
                           Width="18" Height="18" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding FileHosterName}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Classes.no-accounts="{Binding !HasAccounts}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Account: the saved-accounts + synthetic-Anonymous dropdown (two-way SelectedAccount) when
                 usable; otherwise an "Add account…" link (rule 28) that opens the add-account dialog for
                 this hoster. The command lives on the grid's DataContext (the wizard VM). -->
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step2_Col_Account}" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <ComboBox ItemsSource="{Binding AccountOptions}"
                              SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              VerticalAlignment="Center" HorizontalAlignment="Stretch"
                              Margin="0,2,8,2" Padding="8,2" FontSize="12"
                              BorderBrush="{DynamicResource InputFieldBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="2"
                              Background="{DynamicResource SurfaceMutedBrush}"
                              IsVisible="{Binding CanUse}" />
                    <TextBlock Classes="link" VerticalAlignment="Center" FontSize="12" Padding="6,2"
                               Text="{loc:Loc Wizard_Step2_AddAccountLink}"
                               IsVisible="{Binding !CanUse}"
                               ToolTip.Tip="{loc:Loc Wizard_Step2_AccountRequiredTooltip}"
                               PointerReleased="AddAccountLink_PointerReleased" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- Max file size for the selected account (re-resolves when the account dropdown changes —
                 tiers can differ). Read-only display (rule 32). -->
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step2_Col_MaxFileSize}" Width="110" IsReadOnly="True"
                                    SortMemberPath="MaxFileSizeBytes"
                                    ClipboardContentBinding="{Binding MaxFileSizeDisplay}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding MaxFileSizeDisplay}" FontSize="12"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Padding="6,2" Foreground="{DynamicResource TextPrimaryBrush}"
                             Classes.blocked="{Binding !CanUse}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- How many uploads this hoster takes at once for the selected account — "No limit" for most.
                 This is the HOSTER's ceiling, not the effective one: the scheduler uses the smaller of it
                 and the per-host setting in Settings. Re-resolves with the account dropdown (tiers differ)
                 and is read-only display (rule 32). -->
            <DataGridTemplateColumn Header="{loc:Loc Wizard_Step2_Col_MaxConcurrent}" Width="100" IsReadOnly="True"
                                    SortMemberPath="MaxConcurrentUploads"
                                    ClipboardContentBinding="{Binding MaxConcurrentUploadsDisplay}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding MaxConcurrentUploadsDisplay}" FontSize="12"
                             VerticalAlignment="Center" HorizontalAlignment="Right"
                             Padding="6,2" Foreground="{DynamicResource TextPrimaryBrush}"
                             Classes.blocked="{Binding !CanUse}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Hoster-limit violations surface in-place (not a dialog) so the user sees which constraints fail
             while toggling hosters/files; Next stays disabled (via CanGoNext) until the list empties. -->
        <!-- Nothing ticked yet: Next is disabled, and a disabled button with no explanation is the
             thing people file bugs about. Kept out of the limits panel below, whose heading is about a
             hoster's constraints and would misfile this. -->
        <TextBlock Grid.Row="4" x:Name="PickAHosterHint"
                   Text="{loc:Loc Wizard_Step2_PickAtLeastOne}"
                   FontSize="12" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   IsVisible="{Binding !HasSelectedHoster}" />

        <Border Grid.Row="5" x:Name="HosterWarningsBorder" Margin="0,8,0,0" Padding="8,6"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                CornerRadius="3"
                IsVisible="{Binding HasHosterValidationWarnings}">
          <StackPanel>
            <TextBlock Text="{loc:Loc Wizard_Hoster_LimitsHeader}"
                       FontWeight="SemiBold" FontSize="12"
                       Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,4" />
            <!-- Cap the inner height so a package with many oversized files doesn't push the buttons off. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" MaxHeight="120">
              <ItemsControl ItemsSource="{Binding HosterValidationWarnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Step 2: Summary — what will actually upload, grouped by destination hoster (Task 9). Each hoster is a
           custom-templated Expander (SummaryExpanderTheme, rule 38): a flat rotating chevron ToggleButton + a
           rich header (icon, name, account, N-of-M-files-selected, capacity), over an expandable list of per-
           file include checkboxes. rule-33 visibility-converter sites become IsVisible; the WPF capacity-line
           DataTrigger recolor (red+bold over capacity) becomes the Classes.capacity-over conditional class
           (rule 40). Reaching this step triggers a storage refresh for IStorageRefreshablePipeline hosters — a
           network no-op for Catbox (not refreshable) / Anonymous accounts, the safe selection the drivers use. -->
      <Grid x:Name="Step2Panel" RowDefinitions="Auto,Auto,Auto,*"
            IsVisible="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}">

        <TextBlock Grid.Row="0" Text="{loc:Loc Wizard_Summary_Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="{loc:Loc Wizard_Summary_Desc}"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel Grid.Row="2">
          <!-- Auto-fit notice (warning amber) — files were unchecked to keep a hoster within its free space. -->
          <Border x:Name="AutoFitBanner" IsVisible="{Binding HasAutoFitNotice}"
                  Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource WarningBrush}"
                  BorderThickness="1" CornerRadius="3"
                  Padding="10,8" Margin="0,0,0,12">
            <TextBlock Text="{Binding AutoFitNotice}"
                       Foreground="{DynamicResource WarningBrush}"
                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
          </Border>

          <!-- Orphan-files warning banner — files with zero destinations. The user can still proceed (Next
               isn't blocked); those files just don't upload. The WPF header used inline <Run>s bound to
               OrphanFilesCount; Avalonia composes it as two TextBlocks (count + suffix) to avoid the head's
               un-exercised inline-binding path. -->
          <Border x:Name="OrphanBanner" IsVisible="{Binding HasOrphanFiles}"
                  Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource WarningBrush}"
                  BorderThickness="1" CornerRadius="3"
                  Padding="10,8" Margin="0,0,0,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding OrphanFilesCount, Mode=OneWay}"
                           Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc Wizard_Summary_OrphanWarning_Suffix}"
                           Foreground="{DynamicResource WarningBrush}" FontSize="12" FontWeight="SemiBold"
                           Margin="4,0,0,0" TextWrapping="Wrap" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding OrphanFiles}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                      <Image Source="{Binding FileName, Converter={StaticResource FileTypeIconConverter}}"
                             Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding FileName}" FontSize="11"
                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="SummariesList" ItemsSource="{Binding Summaries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Expander Theme="{StaticResource SummaryExpanderTheme}"
                          IsExpanded="True" Margin="0,0,0,8">
                  <Expander.Header>
                    <StackPanel Margin="2,4,8,4">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding HosterName, Converter={StaticResource HosterIconConverter}}"
                               Width="20" Height="20" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding HosterName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AccountUsername}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <!-- Count/size reflect the CHECKED files; a single Text binding (not inline Runs) so it
                             refreshes live as the user toggles files on this hoster. -->
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="{Binding IncludedSummary, Mode=OneWay}" />
                      </StackPanel>

                      <!-- Live storage-refresh indicator: shown while this hoster's free space is re-checked. -->
                      <TextBlock Margin="28,3,0,0" FontSize="11" FontStyle="Italic"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Text="{loc:Loc Wizard_Summary_CheckingSpace}"
                                 IsVisible="{Binding IsRefreshing}" />

                      <!-- Capacity line: "{checked} selected of {free} free" — secondary normally, red + bold
                           when over capacity (Classes.capacity-over, rule 40). Only for quota-reporting hosters. -->
                      <TextBlock Margin="28,3,0,0" FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Classes.capacity-over="{Binding IsOverCapacity}"
                                 Text="{Binding CapacityDisplay, Mode=OneWay}"
                                 IsVisible="{Binding HasQuota}" />

                      <!-- Per-hoster deselection clue: how many files were unchecked here to fit the free space. -->
                      <TextBlock Margin="28,2,0,0" FontSize="11"
                                 Foreground="{DynamicResource WarningBrush}"
                                 Text="{Binding UncheckedDisplay, Mode=OneWay}"
                                 IsVisible="{Binding HasUncheckedFiles}" />

                      <!-- Over-capacity hint (red), shown only when over. -->
                      <TextBlock Margin="28,2,0,0" FontSize="11"
                                 Foreground="{DynamicResource ErrorBrush}"
                                 Text="{Binding CapacityError, Mode=OneWay}"
                                 IsVisible="{Binding IsOverCapacity}" />
                    </StackPanel>
                  </Expander.Header>
                  <Border Background="{DynamicResource SurfaceBrush}"
                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                          BorderThickness="0,1,0,0">
                    <ItemsControl ItemsSource="{Binding Files}" Margin="32,6,12,8">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,2" ColumnDefinitions="Auto,Auto,*,90">
                            <!-- Per-hoster include checkbox — independent of step 0's selection and of every
                                 other hoster's copy; unchecking shrinks this hoster's used total. Scaled to 0.7
                                 to match the step-1 Directory grid's boxes: those sit in DataGridCells and pick
                                 up the global "DataGridCell CheckBox" scale(0.7) in BaseStyles; these summary
                                 rows are a plain ItemsControl (no DataGridCell), so they'd render full-size
                                 without this. Centred origin — bare "0.5,0.5" would be absolute px in Avalonia. -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding Included}"
                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                      RenderTransform="scale(0.7)" RenderTransformOrigin="50%,50%" />
                            <Image Grid.Column="1"
                                   Source="{Binding FileName, Converter={StaticResource FileTypeIconConverter}}"
                                   Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding FileName}"
                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Size, Converter={StaticResource ByteUnitConverter}}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Step 3: When to start (Task 8). The three start-mode RadioButtons are the two-way EnumBool group
           (prep 8 / RC #21): clicking a button writes StartMode; an external StartMode change re-checks the
           matching button and unchecks the others, whose ConvertBack(false) returns BindingOperations.DoNothing
           so an uncheck never nulls the enum. The scheduled row's DatePicker binds the non-nullable DateTime
           ScheduledDate through DateTimeOffsetConverter (rule 36); the time is a free-text TextBox. -->
      <StackPanel x:Name="Step3Panel"
                  IsVisible="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=3}">
        <TextBlock Text="{loc:Loc Wizard_Step3_Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" />
        <TextBlock Text="{loc:Loc Wizard_Step3_Desc}"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

        <StackPanel Margin="0,0,0,12">
          <RadioButton x:Name="ImmediatelyRadio" Content="{loc:Loc Wizard_Step3_Mode_Immediately}"
                       IsChecked="{Binding StartMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Immediately}"
                       GroupName="WizardStartMode" Margin="0,0,0,10" FontSize="12" />
          <RadioButton x:Name="LaterRadio" Content="{loc:Loc Wizard_Step3_Mode_Later}"
                       IsChecked="{Binding StartMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Later}"
                       GroupName="WizardStartMode" Margin="0,0,0,10" FontSize="12" />
          <RadioButton x:Name="ScheduledRadio" Content="{loc:Loc Wizard_Step3_Mode_Scheduled}"
                       IsChecked="{Binding StartMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Scheduled}"
                       GroupName="WizardStartMode" Margin="0,0,0,10" FontSize="12" />
        </StackPanel>

        <StackPanel x:Name="ScheduledRow" Orientation="Horizontal" Margin="24,0,0,0"
                    IsVisible="{Binding IsScheduledMode}">
          <DatePicker x:Name="ScheduledDatePicker"
                      SelectedDate="{Binding ScheduledDate, Converter={StaticResource DateTimeOffsetConverter}}"
                      Width="160" FontSize="12" />
          <TextBox Text="{Binding ScheduledTime}" Width="70" Margin="8,0,0,0"
                   FontSize="12" Padding="4,3" VerticalContentAlignment="Center" />
          <TextBlock Text="{loc:Loc Wizard_Step3_TimeFormatHint}"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                     Margin="8,0,0,0" FontSize="11" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Bottom buttons -->
    <Border Grid.Row="2" Padding="20,8,20,12"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Background="{DynamicResource SurfaceAltBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <!-- Grand total across all hosters — Summary step (StepVisibility param 2) only, left-aligned. -->
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
                   FontSize="12" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="{Binding TotalUploadSummary}"
                   IsVisible="{Binding CurrentStep, Converter={StaticResource StepVisibilityConverter}, ConverterParameter=2}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BackButton" Content="{loc:Loc Wizard_Btn_Back}" Width="80" Height="30" Margin="0,0,8,0"
                  Command="{Binding GoBackCommand}"
                  IsVisible="{Binding CanGoBack}" />
          <!-- Cancel: IsCancel routes Esc here but no longer auto-closes on Avalonia (rule 7), so the
               handler closes explicitly with a non-completed result. -->
          <Button x:Name="CancelButton" Content="{loc:Loc Wizard_Btn_Cancel}" Width="80" Height="30"
                  IsCancel="True" Margin="0,0,8,0" Click="CancelButton_Click" />
          <Button x:Name="NextButton" Content="{Binding NextButtonText}" Width="100" Height="30"
                  Command="{Binding GoNextCommand}"
                  IsEnabled="{Binding CanGoNext}"
                  Classes="primary" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
