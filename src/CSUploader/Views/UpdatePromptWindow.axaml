<!-- "An update is available - install it now?", shown once at startup, owned by the real main window.
     It cannot reuse IDialogService.ShowOptOutConfirmationAsync: a suppressed opt-out there returns
     TRUE silently, which for this question would mean updating forever without asking. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        x:Class="CSUploader.Views.UpdatePromptWindow"
        Title="{loc:Loc UpdatePrompt_WindowTitle}"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="/Assets/icon.ico">
  <StackPanel Margin="20">
    <TextBlock x:Name="MessageText"
               TextWrapping="Wrap"
               FontSize="13"
               Margin="0,0,0,16" />

    <!-- "What's new", from the notes vpk embedded in the package. Collapsed entirely - header and
         all - when the package carries none, so older packages get the old prompt, not an empty
         box. Vertical scroll only: the text wraps, so a horizontal bar would mean a rendering bug. -->
    <StackPanel x:Name="NotesSection" IsVisible="False" Margin="0,0,0,16">
      <TextBlock Text="{loc:Loc UpdatePrompt_WhatsNew}"
                 FontSize="12" FontWeight="SemiBold"
                 Margin="0,0,0,6" />
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3"
              Background="{DynamicResource SurfaceAltBrush}">
        <ScrollViewer x:Name="NotesScroll" Focusable="True" MaxHeight="240"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="NotesText"
                     TextWrapping="Wrap"
                     FontSize="12"
                     Margin="10,8"
                     AutomationProperties.Name="{loc:Loc UpdatePrompt_WhatsNew}" />
        </ScrollViewer>
      </Border>
    </StackPanel>

    <CheckBox x:Name="CheckAtStartupBox"
              Content="{loc:Loc UpdatePrompt_CheckAtStartup}"
              AutomationProperties.Name="{loc:Loc UpdatePrompt_CheckAtStartup}"
              Margin="0,0,0,16" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <!-- Later is IsCancel, so Escape maps to it - and it carries the checkbox as it stands rather
           than a default, because unticking the box and pressing Later must be honoured. -->
      <Button x:Name="LaterButton"
              Content="{loc:Loc UpdatePrompt_BtnLater}"
              IsCancel="True"
              MinWidth="100" />
      <Button x:Name="UpdateNowButton"
              Content="{loc:Loc UpdatePrompt_BtnUpdateNow}"
              IsDefault="True"
              Classes="accent"
              MinWidth="100" />
    </StackPanel>
  </StackPanel>
</Window>
