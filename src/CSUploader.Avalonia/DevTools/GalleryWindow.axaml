<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CSUploader.Lib.Localization"
        xmlns:conv="clr-namespace:CSUploader.Converters"
        xmlns:beh="clr-namespace:CSUploader.Behaviors"
        x:Class="CSUploader.DevTools.GalleryWindow"
        Title="Gallery (dev)"
        Width="900" Height="700"
        WindowStartupLocation="CenterScreen">
  <!-- dev-only; no i18n by design (the single Loc sample below binds a real key ON PURPOSE, to
       exercise the LocExtension path — everything else is hardcoded English). This is a standing
       Phase 3-6 style/token test page: every section exercises one Phase 3 deliverable so the
       contact-sheet reviewer can judge "tokens faithful + density close + everything renders". -->
  <Window.Resources>
    <conv:FileTypeIconConverter x:Key="FileTypeIconConverter" />
  </Window.Resources>

  <ScrollViewer Padding="16">
    <!-- Named so a bridge ava_screenshot can target the full scrollable content by ref: the
         window viewport is 900x700, but this StackPanel arranges to its full desired height, so
         rendering it directly captures every section (incl. the below-fold Phase 4 controls). The
         explicit SurfaceBrush background (matches the window fill — invisible in normal use) gives
         that by-ref render an opaque theme backdrop; without it the panel is transparent and text
         ghosts against the RenderTargetBitmap's empty alpha. -->
    <StackPanel x:Name="GalleryRoot" Spacing="14" Background="{DynamicResource SurfaceBrush}">

      <!-- Action buttons: named so the AvaDevBridge (ava_search by:name) can drive them.
           ThemeToggleButton flips a bool and calls the REAL IThemeApplier.ApplyTheme (the exact
           path SettingsViewModel uses); GridFontButton calls ApplyGridFont("Verdana", 14) to prove
           live DynamicResource propagation into the DataGrid (Task 5's deferred verification). -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ThemeToggleButton"
                AutomationProperties.AutomationId="ThemeToggleButton"
                Classes="primary" Content="Toggle theme (light/dark)" />
        <Button x:Name="GridFontButton"
                AutomationProperties.AutomationId="GridFontButton"
                Classes="secondary" Content="Grid font → Verdana 14" />
      </StackPanel>

      <!-- Palette strip: DynamicResource swatches re-color the moment RequestedThemeVariant flips. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section-header" Text="Palette (DynamicResource — re-colors on theme toggle)" />
        <WrapPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="SurfaceBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="SurfaceAltBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="SurfaceMutedBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource BorderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="BorderBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="TextPrimaryBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="TextSecondaryBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="AccentBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="SelectionBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource SuccessBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="SuccessBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="ErrorBrush" FontSize="11" />
          </StackPanel>
          <StackPanel Width="118" Margin="0,0,8,8" Spacing="2">
            <Border Height="24" Background="{DynamicResource WarningBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            <TextBlock Text="WarningBrush" FontSize="11" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>

      <!-- Typography: one TextBlock per style class (BaseStyles.axaml). -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section-header" Text="Typography" />
        <TextBlock Text="Plain body text (implicit Window font — 13px)." />
        <TextBlock Classes="form-label" Text="form-label class (secondary, centered)" />
        <TextBlock Classes="section-header" Text="section-header class (14px semibold)" />
      </StackPanel>

      <!-- Buttons: the four style classes + a disabled default. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section-header" Text="Buttons" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Default" />
          <Button Classes="primary" Content="Primary" />
          <Button Classes="secondary" Content="Secondary" />
          <Button Classes="jd2" Content="JD2" />
          <Button Content="Disabled" IsEnabled="False" />
        </StackPanel>
      </StackPanel>

      <!-- Inputs. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section-header" Text="Inputs" />
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBox Width="160" Text="Sample text" />
          <ComboBox SelectedIndex="1">
            <ComboBoxItem>First</ComboBoxItem>
            <ComboBoxItem>Second</ComboBoxItem>
            <ComboBoxItem>Third</ComboBoxItem>
          </ComboBox>
          <CheckBox IsChecked="True" Content="Checked" />
          <RadioButton IsChecked="True" Content="Option" />
          <DatePicker />
        </StackPanel>
      </StackPanel>

      <!-- Icons: all four families. Status bitmaps + hoster logos via StaticResource (BitmapImageResources);
           file-type SVGs via FileTypeIconConverter (SkiaSharp raster proof); geometries via PathIcon.
           Placed above the DataGrid so the four families sit in the default (unscrolled) contact-sheet shot. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section-header" Text="Icons (bitmaps · hoster logos · SVG file-types · geometries)" />
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Width="16" Height="16" Source="{StaticResource StatusSuccessImage}" />
          <Image Width="16" Height="16" Source="{StaticResource StatusFailedImage}" />
          <Image Width="16" Height="16" Source="{StaticResource StatusWarningImage}" />
          <Image Width="16" Height="16" Source="{StaticResource StatusQueuedImage}" />
          <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="4,0" />
          <Image Width="20" Height="20" Source="{StaticResource FileHosterRapidgatorImage}" />
          <Image Width="20" Height="20" Source="{StaticResource FileHosterCatboxImage}" />
          <Image Width="20" Height="20" Source="{StaticResource FileHosterMegaImage}" />
          <Image Width="20" Height="20" Source="{StaticResource FileHosterNitroflareImage}" />
        </StackPanel>
        <!-- File-type SVGs: each item is a file-name string bound through FileTypeIconConverter. -->
        <ItemsControl x:Name="FileTypeIconsPanel">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2">
                <Image Width="28" Height="28" Source="{Binding Converter={StaticResource FileTypeIconConverter}}" />
                <TextBlock Text="{Binding}" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Geometries as themed PathIcons. -->
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <PathIcon Width="20" Height="20" Data="{StaticResource SettingsLanguageGeometry}" Foreground="{DynamicResource AccentBrush}" />
          <PathIcon Width="20" Height="20" Data="{StaticResource SettingsDeveloperGeometry}" Foreground="{DynamicResource AccentBrush}" />
          <PathIcon Width="20" Height="20" Data="{StaticResource ForceStartGeometry}" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
      </StackPanel>

      <!-- DataGrid: 5 in-code rows, RowHeight + font from the implicit DataGrid style (both grid-font
           tokens are DynamicResource, so GridFontButton re-fonts it live). Both behavior families are
           attached so the XAML attach path is exercised (DataGridSelectionBehaviors ×2 + AutoScroll). -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section-header" Text="DataGrid (Tahoma 12 by default; GridFontButton → Verdana 14)" />
        <DataGrid x:Name="SampleGrid"
                  Height="150"
                  AutoGenerateColumns="False"
                  GridLinesVisibility="All"
                  beh:DataGridSelectionBehaviors.SelectRowOnRightClick="True"
                  beh:DataGridSelectionBehaviors.ClearSelectionOnEmptyClick="True"
                  beh:AutoScrollBehavior.IsEnabled="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>

      <!-- TabControl + ProgressBar (Phase 4 arbitration): the two Fluent controls Phase 4 consumes
           first, staged in their exact dialog shapes so the contact-sheet reviewer arbitrates
           Fluent-vs-WPF (httpdetails/logdetails tab strips; updateprogress/progress bars) BEFORE any
           dialog that depends on them is ported (Task 1, prep item 5). A 3-tab TabControl whose
           middle tab nests a 2-tab TabControl over a read-only Consolas box on CodeBackgroundBrush
           (the HttpDetails shape); a determinate bar (UpdateProgress: 0-100, Value 42, Height 18)
           and an indeterminate one (ProgressWindow: Height 20). -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section-header" Text="TabControl + ProgressBar (Phase 4 dialog controls)" />
        <TabControl Height="200">
          <TabItem Header="Request">
            <TextBlock Margin="8" Text="Request tab body (classic single-level tab)." />
          </TabItem>
          <TabItem Header="Response">
            <TabControl>
              <TabItem Header="Headers">
                <TextBox IsReadOnly="True" FontFamily="Consolas"
                         Background="{DynamicResource CodeBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="NoWrap"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Text="HTTP/1.1 200 OK&#x0a;Content-Type: application/json&#x0a;Server: nginx" />
              </TabItem>
              <TabItem Header="Body (JSON)">
                <TextBox IsReadOnly="True" FontFamily="Consolas"
                         Background="{DynamicResource CodeBackgroundBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextWrapping="NoWrap"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Text="{}{&#x0a;  &quot;status&quot;: &quot;ok&quot;,&#x0a;  &quot;fileId&quot;: &quot;abc123&quot;&#x0a;}" />
              </TabItem>
            </TabControl>
          </TabItem>
          <TabItem Header="Full Dump">
            <TextBlock Margin="8" Text="Full dump body (classic single-level tab)." />
          </TabItem>
        </TabControl>
        <ProgressBar Minimum="0" Maximum="100" Value="42" Height="18" />
        <ProgressBar IsIndeterminate="True" Height="20" />
      </StackPanel>

      <!-- Loc sample: the one intentional localized binding — proves LocExtension resolves a real key. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section-header" Text="Localization (LocExtension)" />
        <TextBlock Text="{loc:Loc Main_Tab_Uploads}" />
      </StackPanel>

      <!-- Dialogs (Phase 4): launcher buttons calling the production IDialogService (the drivers
           exercise real dialog plumbing). Task 3 lands the three message-box modes; each later dialog
           task adds its own Dialog<Name>Button here. Error → MessageBoxWindow Ok mode; Confirm → YesNo
           mode; Opt-out → the ConfirmationDialog port (YesNo + "Don't ask again"), with a FRESH
           suppression key per click so a ticked "Yes" never silently suppresses the next drive. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section-header" Text="Dialogs (Phase 4)" />
        <TextBlock TextWrapping="Wrap"
                   Text="Message-box launchers through the real IDialogService. Later dialog tasks add their own launchers alongside these." />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="DialogErrorButton"
                  AutomationProperties.AutomationId="DialogErrorButton"
                  Classes="secondary" Content="Show error" />
          <Button x:Name="DialogConfirmButton"
                  AutomationProperties.AutomationId="DialogConfirmButton"
                  Classes="secondary" Content="Show confirm" />
          <Button x:Name="DialogOptOutButton"
                  AutomationProperties.AutomationId="DialogOptOutButton"
                  Classes="secondary" Content="Show opt-out confirm" />
        </StackPanel>

        <!-- Text-centric dialogs (Phase 4 Task 5). ErrorDetails has no IDialogService member (Phase 5's
             EditAccountWindow opens it), so its button constructs the window directly (the same
             new ErrorDetailsWindow(...).ShowDialog(this) the WPF reference driver uses); the ProxyText and
             SpeedLimit buttons go through the REAL IDialogService members the VMs already await. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="DialogErrorDetailsButton"
                  AutomationProperties.AutomationId="DialogErrorDetailsButton"
                  Classes="secondary" Content="Error details…" />
          <Button x:Name="DialogProxyTextEditButton"
                  AutomationProperties.AutomationId="DialogProxyTextEditButton"
                  Classes="secondary" Content="Proxy text (edit)…" />
          <Button x:Name="DialogProxyTextExportButton"
                  AutomationProperties.AutomationId="DialogProxyTextExportButton"
                  Classes="secondary" Content="Proxy text (export)…" />
          <Button x:Name="DialogSpeedLimitButton"
                  AutomationProperties.AutomationId="DialogSpeedLimitButton"
                  Classes="secondary" Content="Speed limit…" />
        </StackPanel>

        <!-- Self-contained dialogs (Phase 4 Task 6): About + CloseAction have no IDialogService member
             (their production openers are the MainWindow menu in Phase 6/7 and close-to-tray in Phase 7),
             so each button constructs the window and ShowDialog(this) directly — the gallery is the owner
             until those phases wire the real callers. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="DialogAboutButton"
                  AutomationProperties.AutomationId="DialogAboutButton"
                  Classes="secondary" Content="About…" />
          <Button x:Name="DialogCloseActionButton"
                  AutomationProperties.AutomationId="DialogCloseActionButton"
                  Classes="secondary" Content="Close action…" />
        </StackPanel>

        <!-- StorageProvider pickers (Phase 4 Task 4): these open NATIVE OS dialogs the bridge cannot
             drive or screenshot, so the agent never clicks them in a bridge session (a native modal would
             wedge the drive loop). They exist for manual click-through smoke and a crash-free
             open check; each is tooltip-marked "manual only". The result path(s) land in PickerResultText.
             The builders behind these members are unit-tested (PickerOptionsTests); the native open is
             the only manually-verified part. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="PickFolderButton"
                  AutomationProperties.AutomationId="PickFolderButton"
                  Classes="secondary" Content="Pick folder…" ToolTip.Tip="manual only" />
          <Button x:Name="PickFilesButton"
                  AutomationProperties.AutomationId="PickFilesButton"
                  Classes="secondary" Content="Pick files (multi)…" ToolTip.Tip="manual only" />
          <Button x:Name="PickOpenFileButton"
                  AutomationProperties.AutomationId="PickOpenFileButton"
                  Classes="secondary" Content="Open file…" ToolTip.Tip="manual only" />
          <Button x:Name="PickSaveFileButton"
                  AutomationProperties.AutomationId="PickSaveFileButton"
                  Classes="secondary" Content="Save file…" ToolTip.Tip="manual only" />
        </StackPanel>
        <TextBlock x:Name="PickerResultText" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Picker result: (none yet)" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
