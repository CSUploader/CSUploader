<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CSUploader.DevTools.HeaderTemplateProbeWindow"
        Title="Header re-template probe (dev)"
        Width="1000" Height="360"
        WindowStartupLocation="CenterOwner">
  <!-- THROWAWAY probe (Phase 6 Task 1, prep item 1): pins the custom DataGridColumnHeader re-template
       (lock ToggleButton + resize survival + sort survival) on a plain window BEFORE UploadsView
       (Task 10) invests in it. Deleted in Task 10 once the recipe is copied across (or the stock-header
       fallback is taken). No i18n by design (dev-tool convention — hardcoded English, matches
       GalleryWindow / the Phase 5 GroupingProbeWindow). -->
  <Window.Resources>

    <!-- Stock sort-glyph geometries, copied verbatim from the installed 11.3.13 Fluent theme
         (submodule AvaloniaUI/Avalonia.Controls.DataGrid @85a0b32, Themes/Fluent.xaml). Keeping the
         SortIcon Path + these paths reproduces Avalonia's stock sort indicator inside the custom
         header — the WPF custom header shows NO sort glyph, so this is the "keep Avalonia's stock
         glyph as an accepted divergence" option (checklist item 2). -->
    <StreamGeometry x:Key="ProbeSortIconAscendingPath">M1965 947l-941 -941l-941 941l90 90l787 -787v1798h128v-1798l787 787z</StreamGeometry>
    <StreamGeometry x:Key="ProbeSortIconDescendingPath">M1875 1011l-787 787v-1798h-128v1798l-787 -787l-90 90l941 941l941 -941z</StreamGeometry>

    <!-- The JD2 lock ToggleButton (mirrors UploadsView.xaml:317-345). 14x14, Segoe MDL2 padlock:
         unlocked E785 (dim) -> locked E72E (AccentBrush) via the :checked pseudo-class. Defined BEFORE
         LockableHeaderTheme so its StaticResource reference below resolves. -->
    <ControlTheme x:Key="LockToggleTheme" TargetType="ToggleButton">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ToolTip.Tip" Value="Lock this column's width" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <TextBlock x:Name="Glyph"
                       Text="&#xE785;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="10"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Opacity="0.45"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ TextBlock#Glyph">
        <Setter Property="Opacity" Value="1.0" />
      </Style>
      <Style Selector="^:checked /template/ TextBlock#Glyph">
        <Setter Property="Text" Value="&#xE72E;" />
        <Setter Property="Opacity" Value="1.0" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      </Style>
    </ControlTheme>

    <!-- The pinned custom header recipe (port rule for Task 10). Cut down from the stock 11.3.13
         DataGridColumnHeader ControlTheme: DataGridColumnHeader has NO OnApplyTemplate / NameScope
         lookups, so re-templating is free-form (the only hard requirement is a ContentPresenter for
         the header Content). Resize is the header's OWN pointer logic (a 5px edge hit-region gated on
         DataGridColumn.CanUserResize) — NO PART_*Gripper exists — so it survives any template with a
         hit-testable root. Sort is the header's OnMouseLeftButtonUp_Click -> ProcessSort, likewise
         template-independent. This theme keeps: a hit-testable HeaderBorder, the ContentPresenter, the
         stock SortIcon Path (toggled by :sortascending/:sortdescending), and ADDS a lock ToggleButton
         docked right (kept 8px clear of the edge so the 5px resize region stays grabbable). -->
    <ControlTheme x:Key="LockableHeaderTheme" TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource DataGridHeaderBrush}" />
      <Setter Property="FontFamily" Value="{DynamicResource GridFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource GridFontSize}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Template">
        <ControlTemplate>
          <!-- HeaderBorder: Background is what makes the header hit-testable so the presenter's pointer
               logic (resize/sort) fires. BorderThickness 0,0,1,1 = the WPF grid-line look. -->
          <Border x:Name="HeaderBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource DataGridGridLineBrush}"
                  BorderThickness="0,0,1,1">
            <Grid x:Name="PART_ColumnHeaderRoot" ColumnDefinitions="*,Auto,Auto">
              <!-- col 0: header content + stock sort glyph, in the padded content area -->
              <Panel Grid.Column="0"
                     Margin="{TemplateBinding Padding}"
                     HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid ColumnDefinitions="*,Auto">
                  <ContentPresenter x:Name="PART_ContentPresenter"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                  <Path x:Name="SortIcon"
                        Grid.Column="1"
                        IsVisible="False"
                        Height="9"
                        Margin="6,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="{TemplateBinding Foreground}"
                        Stretch="Uniform" />
                </Grid>
              </Panel>
              <!-- col 1: JD2 lock toggle. Its own pointer handling swallows clicks ON it (so it never
                   sorts/resizes); clicks elsewhere on the header still reach the presenter. -->
              <ToggleButton x:Name="LockToggle"
                            Grid.Column="1"
                            Theme="{StaticResource LockToggleTheme}"
                            Margin="2,0,8,0"
                            VerticalAlignment="Center"
                            Click="ColumnLock_Click" />
              <!-- col 2: the 1px separator sits at the right edge — the header's 5px resize region
                   overlaps it plus the 8px clear margin, so drag-resize stays grabbable. -->
              <Rectangle x:Name="VerticalSeparator"
                         Grid.Column="2"
                         Width="1"
                         VerticalAlignment="Stretch"
                         Fill="{DynamicResource DataGridGridLineBrush}" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>

      <!-- Pseudo-class styles (the header sets these itself; the CODE looks up no parts). -->
      <Style Selector="^:pointerover /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      </Style>
      <Style Selector="^:sortascending /template/ Path#SortIcon">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Data" Value="{StaticResource ProbeSortIconAscendingPath}" />
      </Style>
      <Style Selector="^:sortdescending /template/ Path#SortIcon">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Data" Value="{StaticResource ProbeSortIconDescendingPath}" />
      </Style>
    </ControlTheme>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfaceMutedBrush}"
            Padding="10,6">
      <TextBlock TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="DataGridColumnHeader re-template probe — custom ControlTheme wired via DataGrid.ColumnHeaderTheme (lock toggle + stock sort glyph + built-in resize). Throwaway (deleted in Task 10)." />
    </Border>
    <DataGrid x:Name="ProbeGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Extended"
              GridLinesVisibility="All"
              HeadersVisibility="Column"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              Background="{DynamicResource SurfaceBrush}"
              HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
              VerticalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
              ColumnHeaderTheme="{StaticResource LockableHeaderTheme}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*" />
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
        <!-- Per-column difference (checklist item 4): the Order column's header is a distinct compact
             AccentBrush glyph (not a text label) and the column is narrow — proving one shared header
             theme expresses per-column header content/width differences (UploadsView's Order column is
             collapsed/narrow by default). -->
        <DataGridTextColumn Binding="{Binding Order}" Width="64" MinWidth="48">
          <DataGridTextColumn.Header>
            <TextBlock Text="&#xE8CB;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="12"
                       Foreground="{DynamicResource AccentBrush}"
                       ToolTip.Tip="Order (compact per-column header)" />
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
