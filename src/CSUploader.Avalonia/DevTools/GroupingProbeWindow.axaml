<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CSUploader.DevTools.GroupingProbeWindow"
        Title="Grouping probe (dev)"
        Width="900" Height="500"
        WindowStartupLocation="CenterOwner">
  <!-- THROWAWAY probe (Phase 5 Task 2, prep item 6): pins the DataGrid-grouping recipe on a plain
       window before UploadedView invests in it. Deleted in Task 5 once the recipe is copied across.
       No i18n by design (dev-tool convention — hardcoded English, matches GalleryWindow). -->
  <Window.Resources>

    <!-- The pinned group-header recipe (port rule 27). A re-templated DataGridRowGroupHeader
         ControlTheme, wired EXPLICITLY via DataGrid.RowGroupTheme (below) — NOT implicit {x:Type}
         pickup. Mirrors the WPF group bar (UploadedView.xaml:207-270): a flat, whole-row ToggleButton
         (PART_ExpanderButton — the DataGrid keeps its IsChecked in sync with the group's IsVisible and
         drives collapse/expand from it, per the decompiled OnApplyTemplate) rendering a −/+ chevron,
         the group value (SemiBold), and the item count as [n]. SublevelIndent 0 keeps rows flush with
         the column headers. The header's DataContext is the DataGridCollectionViewGroup, so Key (the
         group value) and ItemCount bind directly — the Avalonia equivalent of WPF's {Binding Name} /
         {Binding ItemCount, StringFormat='[{0}]'} (PART_PropertyNameElement is deliberately omitted:
         it renders "PropertyName:", not the group value). -->
    <ControlTheme x:Key="GroupHeaderTheme" TargetType="DataGridRowGroupHeader">
      <Setter Property="SublevelIndent" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" MinHeight="20">
            <!-- PART_Root (a Panel) is where the DataGrid arranges frozen-column clips; keep it even
                 though this probe has no frozen columns (the decompiled ArrangeOverride null-guards it,
                 but the generic theme names it and cutting it risks a future surprise). -->
            <Panel Name="PART_Root">
              <ToggleButton Name="PART_ExpanderButton"
                            Focusable="False"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="12,0" MinHeight="20">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- −/+ chevron: IsChecked==true means expanded (DataGrid sets it from the
                             group's IsVisible). Two TextBlocks toggled off the ToggleButton's own
                             IsChecked — no converter needed (IsThreeState is false, so never null). -->
                        <Panel Width="14" Margin="0,0,6,0">
                          <TextBlock Text="−"
                                     FontFamily="{DynamicResource GridFontFamily}"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                          <TextBlock Text="+"
                                     FontFamily="{DynamicResource GridFontFamily}"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Panel>
                        <TextBlock Text="{Binding Key}"
                                   FontFamily="{DynamicResource GridFontFamily}"
                                   FontSize="{DynamicResource GridFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0"
                                   Text="{Binding ItemCount, StringFormat='[{0}]'}"
                                   FontFamily="{DynamicResource GridFontFamily}"
                                   FontSize="{DynamicResource GridFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
            </Panel>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfaceMutedBrush}"
            Padding="10,6">
      <TextBlock TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}"
                 Text="DataGrid grouping probe — DataGridCollectionView + DataGridPathGroupDescription built in code-behind; RowGroupTheme wired via DataGrid.RowGroupTheme. Throwaway (deleted in Task 5)." />
    </Border>
    <DataGrid x:Name="ProbeGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Extended"
              GridLinesVisibility="All"
              HeadersVisibility="Column"
              CanUserSortColumns="True"
              CanUserResizeColumns="True"
              CanUserReorderColumns="True"
              ClipboardCopyMode="IncludeHeader"
              Background="{DynamicResource SurfaceBrush}"
              HorizontalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
              VerticalGridLinesBrush="{DynamicResource DataGridGridLineBrush}"
              RowGroupTheme="{StaticResource GroupHeaderTheme}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding FileName}" Width="2*" />
        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*" />
        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
