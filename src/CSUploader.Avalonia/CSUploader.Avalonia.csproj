<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev-only, opt-in AvaDevBridge wiring. MSBuild auto-imports only Directory.Build.props, so the
       machine-specific local props (which defines AvaDevBridgeCsproj) is imported explicitly here.
       Absent on CI → no import, no reference, no AVA_BRIDGE define; the build stays self-contained. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\Directory.Build.local.props')" />

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(AvaDevBridgeCsproj)' != '' and Exists('$(AvaDevBridgeCsproj)')">
    <AvaBridgeEnabled>true</AvaBridgeEnabled>
    <DefineConstants>$(DefineConstants);AVA_BRIDGE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(AvaBridgeEnabled)' == 'true'">
    <ProjectReference Include="$(AvaDevBridgeCsproj)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>CSUploader</RootNamespace>
    <AssemblyName>CSUploader.Avalonia</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>preview</LangVersion>
    <!-- WebView2's managed API marshals COM; required for the Phase 2 spike + Phase 8 login host. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Parity-first migration: the WPF XAML being ported uses reflection bindings throughout.
         Compiled bindings (x:DataType everywhere) are a deliberate opt-in AFTER the port. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\Properties\Images\Logo\icon.ico</ApplicationIcon>
    <!-- Win32 supportedOS manifest — REQUIRED for Avalonia NativeControlHost / WebView2 hosting
         (the Phase 2 spike surfaced its absence; the Phase 8 login host needs it too). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.18" />
    <!-- DataGrid's 11.x line ends at 11.3.13; its dependency range accepts the 11.3.18 core.
         Pinned NOW so the resolution graph is locked before any grid work (design §Hard constraints). -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" Condition="'$(Configuration)' == 'Debug'" />
    <!-- File-type SVG rendering (FileTypeIconConverter → cached SvgImage). 11.3.0 is the only
         11.3-line release; its Avalonia floor (>= 11.3.0) accepts our 11.3.18. It depends on
         Svg.Skia 3.0.2 + SkiaSharp >= 3.116.1, which UPLIFTS the app's SkiaSharp above
         Avalonia.Skia 11.3.18's own 2.88.9 build — verified to render at runtime (live Skia proof),
         not by faith. Pre-agreed fallback if the uplift breaks rendering: Avalonia.Svg.Skia 11.2.0.3. -->
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <!-- Reserved for head-local MVVM helpers as views arrive; if still unused at the Phase 9
         cutover, drop it (same rule that removed it from the WPF head in c4e9b82). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <!-- Phase 2 WebView2 GO/NO-GO spike (Spike/, THROWAWAY) + the Phase 8 login host.
         Same pin as the WPF head (src/CSUploader.csproj). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSUploader.Core\CSUploader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the WPF head's icon; no duplication. If the Link'd avares path does not resolve
         at runtime (verify with AssetLoader in Step 5), copy the .ico to Assets\ instead. -->
    <AvaloniaResource Include="..\Properties\Images\Logo\icon.ico" Link="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF head's image tree is the single source of truth; linked, not copied.
         avares URIs: /Assets/Images/<subpath> (root-relative in XAML; full avares:// with
         the assembly name code-side — the Phase 2 gate convention). BitmapImageResources
         merges the keyed subset (ImageResources.xaml parity); extra unkeyed PNGs ride along
         harmlessly, exactly as the WPF head embeds the whole folder. -->
    <AvaloniaResource Include="..\Properties\Images\**\*" Link="Assets\Images\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- vscode-icons file-type SVGs from the git submodule, embedded as AvaloniaResource so
         Svg.Skia renders them by avares URI (avares://…/FileTypes/<name>.svg). Mirror of the WPF
         head's glob (src/CSUploader.csproj), one directory deeper — hence ..\..\external. -->
    <AvaloniaResource Include="..\..\external\vscode-icons\icons\*.svg" Link="FileTypes\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- A fresh worktree/clone without submodule init leaves the glob empty, which silently ships an
       app with no file-type icons (a glob matching zero files is not an MSBuild error). Fail the
       build instead — same guard as the WPF head. -->
  <Target Name="EnsureVsCodeIconsSubmodule" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('..\..\external\vscode-icons\icons\file_type_json.svg')"
           Text="vscode-icons submodule not initialized — run: git submodule update --init --recursive" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="CSUploader.Avalonia.Tests" />
  </ItemGroup>

  <!-- The WebView2 SDK references its WPF + WinForms wrapper assemblies for every net5+ TFM
       (no UseWpf/UseWindowsForms gate). This Avalonia head consumes ONLY the Core API; the WPF
       wrapper pulls in WPF's WindowsBase 5.0 → an unresolvable MSB3277 conflict against the
       net10 WindowsBase. Drop both desktop wrappers before RAR — Core.dll and the native
       WebView2Loader copy are untouched. THROWAWAY-adjacent: revisit at the Phase 8 login host. -->
  <Target Name="_DropWebView2DesktopWrappers" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference->WithMetadataValue('Filename','Microsoft.Web.WebView2.Wpf'))" />
      <Reference Remove="@(Reference->WithMetadataValue('Filename','Microsoft.Web.WebView2.WinForms'))" />
    </ItemGroup>
  </Target>

</Project>
