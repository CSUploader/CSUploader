<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- Enables System.Windows.Forms.NotifyIcon for tray-icon support. The app stays a WPF
         app; this only adds the WinForms framework reference for the NotifyIcon plumbing. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>preview</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.5" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Properties\Images\**\*" />
  </ItemGroup>

  <!-- WinForms is enabled only for System.Windows.Forms.NotifyIcon. Drop its implicit
       global usings so they don't collide with WPF (Application, UserControl, Brush,
       DataGrid, ContextMenu all live in both namespaces). TrayIconManager.cs imports
       System.Windows.Forms explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Test project sees internal members (e.g. ConnectionManagerViewModel.TryParseProxyLine) -->
  <ItemGroup>
    <InternalsVisibleTo Include="CSUploader.Tests" />
  </ItemGroup>

  <!-- vscode-icons file-type SVGs, sourced from the git submodule at external/vscode-icons.
       Embedded as WPF resources so SharpVectors can render them by pack URI. -->
  <ItemGroup>
    <Resource Include="..\external\vscode-icons\icons\*.svg">
      <Link>FileTypes\%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>

</Project>
