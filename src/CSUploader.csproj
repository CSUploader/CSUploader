<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- Enables System.Windows.Forms.NotifyIcon for tray-icon support. The app stays a WPF
         app; this only adds the WinForms framework reference for the NotifyIcon plumbing. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>preview</LangVersion>
    <!-- CSUploader.Core lives at src/CSUploader.Core (nested under this project's directory),
         so the SDK's default **/*.cs and **/*.resx globs would otherwise pull Core's sources
         into this assembly too. Exclude the nested project's folder from all default item globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);CSUploader.Core\**</DefaultItemExcludes>
    <Version>0.0.6</Version>
    <AssemblyVersion>0.0.6.0</AssemblyVersion>
    <FileVersion>0.0.6.0</FileVersion>
    <ApplicationIcon>Properties\Images\Logo\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="CSUploader.Core\CSUploader.Core.csproj" />
  </ItemGroup>

  <!-- EF Core, Hosting, the SQLite CVE-pins and Velopack are pure runtime libraries whose
       assemblies now flow transitively from CSUploader.Core (see its csproj), so they no
       longer need declaring here. CommunityToolkit.Mvvm STAYS: it ships a source generator
       ([RelayCommand]/[ObservableProperty]), and analyzers/source-generators do NOT flow
       transitively through a ProjectReference. The five ViewModels still in this head use it;
       it can be dropped once they move to Core in Task 10. -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
    <PackageReference Include="SharpVectors.Reloaded" Version="1.8.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Properties\Images\**\*" />
  </ItemGroup>

  <!-- WinForms is enabled only for System.Windows.Forms.NotifyIcon. Drop its implicit
       global usings so they don't collide with WPF (Application, UserControl, Brush,
       DataGrid, ContextMenu all live in both namespaces). TrayIconManager.cs imports
       System.Windows.Forms explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Test project sees internal members (e.g. ConnectionManagerViewModel.TryParseProxyLine) -->
  <ItemGroup>
    <InternalsVisibleTo Include="CSUploader.Tests" />
  </ItemGroup>

  <!-- vscode-icons file-type SVGs, sourced from the git submodule at external/vscode-icons.
       Embedded as WPF resources so SharpVectors can render them by pack URI. -->
  <ItemGroup>
    <Resource Include="..\external\vscode-icons\icons\*.svg">
      <Link>FileTypes\%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>

  <!-- A fresh worktree/clone without submodule init leaves the icons glob empty, which
       silently ships an app with no file-type icons (a glob matching zero files is not
       an MSBuild error). Fail the build instead. -->
  <Target Name="EnsureVsCodeIconsSubmodule" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('..\external\vscode-icons\icons\file_type_json.svg')"
           Text="vscode-icons submodule not initialized — run: git submodule update --init --recursive" />
  </Target>

</Project>
