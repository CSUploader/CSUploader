<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing -->
    <Thickness x:Key="SpacingNone">0</Thickness>
    <Thickness x:Key="SpacingXs">2</Thickness>
    <Thickness x:Key="SpacingSm">4</Thickness>
    <Thickness x:Key="SpacingMd">8</Thickness>
    <Thickness x:Key="SpacingLg">12</Thickness>
    <Thickness x:Key="SpacingXl">16</Thickness>
    <Thickness x:Key="GroupBoxPadding">8,6,8,8</Thickness>

    <!-- Vertical-only spacing -->
    <Thickness x:Key="RowSpacingSm">0,0,0,4</Thickness>
    <Thickness x:Key="RowSpacingMd">0,0,0,8</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,6</Thickness>

    <!-- Colors - Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F0F2F4" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E5E7EB" />

    <!-- Colors - Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#9CA3AF" />

    <!-- Colors - Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- Colors - DataGrid -->
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#E5E7EB" />

    <!-- Typography -->
    <sys:Double x:Key="FontSizeXs">11</sys:Double>
    <sys:Double x:Key="FontSizeSm">12</sys:Double>
    <sys:Double x:Key="FontSizeMd">13</sys:Double>
    <sys:Double x:Key="FontSizeLg">14</sys:Double>

    <!-- Control sizing -->
    <sys:Double x:Key="ControlHeightSm">24</sys:Double>
    <sys:Double x:Key="ControlHeightMd">28</sys:Double>
    <sys:Double x:Key="DataGridRowHeight">26</sys:Double>
    <GridLength x:Key="LabelWidth">110</GridLength>

    <!-- Corners -->
    <CornerRadius x:Key="RadiusSm">2</CornerRadius>
    <CornerRadius x:Key="RadiusMd">4</CornerRadius>

    <!-- Common Styles -->
    <Style x:Key="FormLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="CompactTextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CompactComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="CompactPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMd}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

</ResourceDictionary>
