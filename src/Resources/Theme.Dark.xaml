<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Surfaces ═══ -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1F26" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#252630" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#2B2C38" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3C3D4E" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#353645" />

    <!-- ═══ Text ═══ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D4D5DE" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9496A8" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C5D6E" />

    <!-- ═══ Accent ═══ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B9DF6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4A8CE8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <!-- ═══ DataGrid ═══ -->
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="#282938" />
    <SolidColorBrush x:Key="DataGridAltRowBrush" Color="#232430" />
    <SolidColorBrush x:Key="DataGridGridLineBrush" Color="#353645" />

    <!-- ═══ Selection ═══ -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#2A4068" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#E0E1EA" />

    <!-- ═══ Content Areas ═══ -->
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#1E1F26" />
    <SolidColorBrush x:Key="ContentAltBackgroundBrush" Color="#232430" />
    <SolidColorBrush x:Key="RowDetailBackgroundBrush" Color="#212230" />

    <!-- ═══ Progress Bar ═══ -->
    <SolidColorBrush x:Key="ProgressBarTrackBrush" Color="#353645" />
    <SolidColorBrush x:Key="ProgressBarFillBrush" Color="#4A8CE8" />
    <SolidColorBrush x:Key="ProgressBarAltFillBrush" Color="#6BA5F0" />
    <SolidColorBrush x:Key="ProgressBarAltTrackBrush" Color="#2B2C3A" />

    <!-- ═══ Toolbar / Overview Gradients ═══ -->
    <LinearGradientBrush x:Key="OverviewTitleGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B2C38" Offset="0" />
        <GradientStop Color="#252630" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonBarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B2C38" Offset="0" />
        <GradientStop Color="#252630" Offset="1" />
    </LinearGradientBrush>

    <!-- ═══ JD2 Button ═══ -->
    <LinearGradientBrush x:Key="JD2ButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#303142" Offset="0" />
        <GradientStop Color="#282938" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="JD2ButtonBorderBrush" Color="#3C3D4E" />
    <LinearGradientBrush x:Key="JD2ButtonHoverBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#303855" Offset="0" />
        <GradientStop Color="#28304A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="JD2ButtonHoverBorderBrush" Color="#5B9DF6" />
    <LinearGradientBrush x:Key="JD2ButtonPressedBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#28304A" Offset="0" />
        <GradientStop Color="#202840" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="JD2ButtonPressedBorderBrush" Color="#4A8CE8" />

    <!-- ═══ Toolbar Button ═══ -->
    <SolidColorBrush x:Key="ToolbarButtonHoverBrush" Color="#303855" />
    <SolidColorBrush x:Key="ToolbarButtonHoverBorderBrush" Color="#5B9DF6" />
    <SolidColorBrush x:Key="ToolbarButtonPressedBrush" Color="#28304A" />
    <SolidColorBrush x:Key="ToolbarButtonPressedBorderBrush" Color="#4A8CE8" />

    <!-- ═══ Sidebar ═══ -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1A1B24" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#282940" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2A4068" />
    <SolidColorBrush x:Key="SidebarSeparatorBrush" Color="#353645" />

    <!-- ═══ Dialog Button ═══ -->
    <LinearGradientBrush x:Key="DialogButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#303142" Offset="0" />
        <GradientStop Color="#282938" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DialogButtonBorderBrush" Color="#3C3D4E" />
    <LinearGradientBrush x:Key="DialogButtonHoverBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#303855" Offset="0" />
        <GradientStop Color="#28304A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DialogButtonHoverBorderBrush" Color="#5B9DF6" />
    <LinearGradientBrush x:Key="DialogButtonPressedBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#28304A" Offset="0" />
        <GradientStop Color="#202840" Offset="1" />
    </LinearGradientBrush>

    <!-- ═══ Save/Primary Button ═══ -->
    <LinearGradientBrush x:Key="SaveButtonBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A8CE8" Offset="0" />
        <GradientStop Color="#3B78D6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SaveButtonBorderBrush" Color="#2E66BE" />
    <LinearGradientBrush x:Key="SaveButtonHoverBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5B9DF6" Offset="0" />
        <GradientStop Color="#4A88E0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SaveButtonPressedBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B78D6" Offset="0" />
        <GradientStop Color="#2E66BE" Offset="1" />
    </LinearGradientBrush>

    <!-- ═══ Misc ═══ -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="OverviewCloseBrush" Color="#9496A8" />
    <SolidColorBrush x:Key="OverviewArrowBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="InputFieldBorderBrush" Color="#3C3D4E" />
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#1E1F26" />
    <SolidColorBrush x:Key="LogAltRowBrush" Color="#232430" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#1A1B24" />
    <SolidColorBrush x:Key="InfoAccentBrush" Color="#6BA5F0" />

</ResourceDictionary>
